    "Usage cost (30 days)": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Usage cost (30 days)"}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用费用（30 天）"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用費用（30 天）"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Custo de uso (30 dias)"}},"de":{"stringUnit":{"state":"translated","value":"Nutzungskosten (30 Tage)"}},"es":{"stringUnit":{"state":"translated","value":"Costo de uso (30 días)"}},"ja-JP":{"stringUnit":{"state":"translated","value":"使用コスト（30日間）"}},"ko":{"stringUnit":{"state":"translated","value":"사용 비용(30일)"}},"fr":{"stringUnit":{"state":"translated","value":"Coût d'utilisation (30 jours)"}},"hi":{"stringUnit":{"state":"translated","value":"उपयोग लागत (30 दिन)"}},"ar":{"stringUnit":{"state":"translated","value":"تكلفة الاستخدام (30 يومًا)"}},"it":{"stringUnit":{"state":"translated","value":"Costo di utilizzo (30 giorni)"}},"tr":{"stringUnit":{"state":"translated","value":"Kullanım maliyeti (30 gün)"}},"uk":{"stringUnit":{"state":"translated","value":"Вартість використання (30 днів)"}},"id":{"stringUnit":{"state":"translated","value":"Biaya penggunaan (30 hari)"}},"pl":{"stringUnit":{"state":"translated","value":"Koszt użycia (30 dni)"}},"th":{"stringUnit":{"state":"translated","value":"ต้นทุนการใช้งาน (30 วัน)"}},"vi":{"stringUnit":{"state":"translated","value":"Chi phí sử dụng (30 ngày)"}},"nl":{"stringUnit":{"state":"translated","value":"Gebruikskosten (30 dagen)"}},"fa":{"stringUnit":{"state":"translated","value":"هزینه استفاده (۳۰ روز)"}},"ru":{"stringUnit":{"state":"translated","value":"Стоимость использования (30 дней)"}},"sv":{"stringUnit":{"state":"translated","value":"Användningskostnad (30 dagar)"}}}},
    "Usage did not finish loading. Close and reopen this menu to retry.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Usage did not finish loading. Close and reopen this menu to retry."}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用情况未完成加载。关闭并重新打开此菜单以重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用量未載入完成。請關閉並重新開啟此選單以重試。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O uso não terminou de carregar. Feche e reabra este menu para tentar novamente."}},"de":{"stringUnit":{"state":"translated","value":"Die Nutzung wurde nicht vollständig geladen. Schließen und öffnen Sie dieses Menü erneut, um es zu wiederholen."}},"es":{"stringUnit":{"state":"translated","value":"El uso no terminó de cargarse. Cierra y vuelve a abrir este menú para reintentar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"使用状況の読み込みが完了しませんでした。このメニューを閉じて再度開き、やり直してください。"}},"ko":{"stringUnit":{"state":"translated","value":"사용량 로딩이 완료되지 않았습니다. 이 메뉴를 닫았다가 다시 열어 재시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"L'utilisation n'a pas fini de se charger. Fermez et rouvrez ce menu pour réessayer."}},"hi":{"stringUnit":{"state":"translated","value":"उपयोग लोड होना पूरा नहीं हुआ। पुनः प्रयास के लिए यह मेनू बंद करके फिर से खोलें।"}},"ar":{"stringUnit":{"state":"translated","value":"لم يكتمل تحميل الاستخدام. أغلق هذه القائمة وأعد فتحها للمحاولة مرة أخرى."}},"it":{"stringUnit":{"state":"translated","value":"Il caricamento dell'utilizzo non è stato completato. Chiudi e riapri questo menu per riprovare."}},"tr":{"stringUnit":{"state":"translated","value":"Kullanım yüklenmesi tamamlanmadı. Yeniden denemek için bu menüyü kapatıp yeniden açın."}},"uk":{"stringUnit":{"state":"translated","value":"Дані про використання не завантажилися. Закрийте та знову відкрийте це меню, щоб повторити спробу."}},"id":{"stringUnit":{"state":"translated","value":"Penggunaan belum selesai dimuat. Tutup dan buka kembali menu ini untuk mencoba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się wczytać danych o użyciu. Zamknij i otwórz ponownie to menu, aby spróbować ponownie."}},"th":{"stringUnit":{"state":"translated","value":"การใช้งานโหลดไม่เสร็จ ปิดแล้วเปิดเมนูนี้ใหม่เพื่อลองอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Mức sử dụng chưa tải xong. Đóng và mở lại menu này để thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik is niet volledig geladen. Sluit dit menu en open het opnieuw om het nogmaals te proberen."}},"fa":{"stringUnit":{"state":"translated","value":"بارگیری استفاده کامل نشد. برای تلاش مجدد این منو را ببندید و دوباره باز کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Данные об использовании не загрузились. Закройте и снова откройте это меню, чтобы повторить попытку."}},"sv":{"stringUnit":{"state":"translated","value":"Användningen lästes inte in klart. Stäng och öppna den här menyn igen för att försöka på nytt."}}}},
    "Usage unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Usage unavailable"}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用情况不可用"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用量無法取得"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Uso indisponível"}},"de":{"stringUnit":{"state":"translated","value":"Nutzung nicht verfügbar"}},"es":{"stringUnit":{"state":"translated","value":"Uso no disponible"}},"ja-JP":{"stringUnit":{"state":"translated","value":"使用状況を利用できません"}},"ko":{"stringUnit":{"state":"translated","value":"사용량을 사용할 수 없음"}},"fr":{"stringUnit":{"state":"translated","value":"Utilisation indisponible"}},"hi":{"stringUnit":{"state":"translated","value":"उपयोग अनुपलब्ध"}},"ar":{"stringUnit":{"state":"translated","value":"الاستخدام غير متاح"}},"it":{"stringUnit":{"state":"translated","value":"Utilizzo non disponibile"}},"tr":{"stringUnit":{"state":"translated","value":"Kullanım kullanılamıyor"}},"uk":{"stringUnit":{"state":"translated","value":"Використання недоступне"}},"id":{"stringUnit":{"state":"translated","value":"Penggunaan tidak tersedia"}},"pl":{"stringUnit":{"state":"translated","value":"Użycie niedostępne"}},"th":{"stringUnit":{"state":"translated","value":"ไม่มีข้อมูลการใช้งาน"}},"vi":{"stringUnit":{"state":"translated","value":"Không có dữ liệu sử dụng"}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik niet beschikbaar"}},"fa":{"stringUnit":{"state":"translated","value":"استفاده در دسترس نیست"}},"ru":{"stringUnit":{"state":"translated","value":"Использование недоступно"}},"sv":{"stringUnit":{"state":"translated","value":"Användning otillgänglig"}}}},
    "Use Tailscale Serve so the gateway has a valid HTTPS certificate.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Tailscale Serve so the gateway has a valid HTTPS certificate."}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用 Tailscale Serve，让网关拥有有效的 HTTPS 证书。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用 Tailscale Serve，讓 gateway 擁有有效的 HTTPS 憑證。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use Tailscale Serve para que o Gateway tenha um certificado HTTPS válido."}},"de":{"stringUnit":{"state":"translated","value":"Verwenden Sie Tailscale Serve, damit das Gateway ein gültiges HTTPS-Zertifikat hat."}},"es":{"stringUnit":{"state":"translated","value":"Usa Tailscale Serve para que el gateway tenga un certificado HTTPS válido."}},"ja-JP":{"stringUnit":{"state":"translated","value":"gateway が有効な HTTPS 証明書を持つように Tailscale Serve を使用します。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway에 유효한 HTTPS 인증서가 있도록 Tailscale Serve를 사용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez Tailscale Serve afin que le Gateway dispose d’un certificat HTTPS valide."}},"hi":{"stringUnit":{"state":"translated","value":"Tailscale Serve का उपयोग करें ताकि gateway के पास एक मान्य HTTPS प्रमाणपत्र हो।"}},"ar":{"stringUnit":{"state":"translated","value":"استخدم Tailscale Serve ليحصل Gateway على شهادة HTTPS صالحة."}},"it":{"stringUnit":{"state":"translated","value":"Usa Tailscale Serve in modo che il gateway abbia un certificato HTTPS valido."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway'in geçerli bir HTTPS sertifikasına sahip olması için Tailscale Serve kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Використовуйте Tailscale Serve, щоб Gateway мав дійсний сертифікат HTTPS."}},"id":{"stringUnit":{"state":"translated","value":"Gunakan Tailscale Serve agar gateway memiliki sertifikat HTTPS yang valid."}},"pl":{"stringUnit":{"state":"translated","value":"Użyj Tailscale Serve, aby gateway miał prawidłowy certyfikat HTTPS."}},"th":{"stringUnit":{"state":"translated","value":"ใช้ Tailscale Serve เพื่อให้ gateway มีใบรับรอง HTTPS ที่ถูกต้อง"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng Tailscale Serve để gateway có chứng chỉ HTTPS hợp lệ."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik Tailscale Serve zodat de Gateway een geldig HTTPS-certificaat heeft."}},"fa":{"stringUnit":{"state":"translated","value":"از Tailscale Serve استفاده کنید تا Gateway یک گواهی HTTPS معتبر داشته باشد."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте Tailscale Serve, чтобы у Gateway был действительный сертификат HTTPS."}},"sv":{"stringUnit":{"state":"translated","value":"Använd Tailscale Serve så att gatewayen har ett giltigt HTTPS-certifikat."}}}},
    "Use Tailscale plus an SSH tunnel for stable private access.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use Tailscale plus an SSH tunnel for stable private access."}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用 Tailscale 加 SSH 隧道，以获得稳定的私有访问。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用 Tailscale 加上 SSH tunnel，以取得穩定的私人存取。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use Tailscale com um túnel SSH para acesso privado estável."}},"de":{"stringUnit":{"state":"translated","value":"Verwenden Sie Tailscale plus einen SSH-Tunnel für stabilen privaten Zugriff."}},"es":{"stringUnit":{"state":"translated","value":"Usa Tailscale y un túnel SSH para un acceso privado estable."}},"ja-JP":{"stringUnit":{"state":"translated","value":"安定したプライベートアクセスには、Tailscale と SSH トンネルを使用します。"}},"ko":{"stringUnit":{"state":"translated","value":"안정적인 비공개 액세스를 위해 Tailscale과 SSH 터널을 함께 사용하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez Tailscale avec un tunnel SSH pour un accès privé stable."}},"hi":{"stringUnit":{"state":"translated","value":"स्थिर निजी पहुँच के लिए Tailscale और SSH tunnel का उपयोग करें।"}},"ar":{"stringUnit":{"state":"translated","value":"استخدم Tailscale بالإضافة إلى نفق SSH للوصول الخاص المستقر."}},"it":{"stringUnit":{"state":"translated","value":"Usa Tailscale più un tunnel SSH per un accesso privato stabile."}},"tr":{"stringUnit":{"state":"translated","value":"Kararlı özel erişim için Tailscale ve bir SSH tüneli kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Використовуйте Tailscale і тунель SSH для стабільного приватного доступу."}},"id":{"stringUnit":{"state":"translated","value":"Gunakan Tailscale plus tunnel SSH untuk akses privat yang stabil."}},"pl":{"stringUnit":{"state":"translated","value":"Użyj Tailscale oraz tunelu SSH, aby uzyskać stabilny prywatny dostęp."}},"th":{"stringUnit":{"state":"translated","value":"ใช้ Tailscale ร่วมกับอุโมงค์ SSH เพื่อการเข้าถึงแบบส่วนตัวที่เสถียร"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng Tailscale cùng với đường hầm SSH để truy cập riêng tư ổn định."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik Tailscale plus een SSH-tunnel voor stabiele privétoegang."}},"fa":{"stringUnit":{"state":"translated","value":"برای دسترسی خصوصی پایدار، از Tailscale به‌همراه یک تونل SSH استفاده کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте Tailscale и SSH-туннель для стабильного приватного доступа."}},"sv":{"stringUnit":{"state":"translated","value":"Använd Tailscale plus en SSH-tunnel för stabil privat åtkomst."}}}},
    "Use an existing subscription or provider account. OpenClaw opens the provider’s own sign-in flow, then verifies it with a real reply.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use an existing subscription or provider account. OpenClaw opens the provider’s own sign-in flow, then verifies it with a real reply."}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用现有的订阅或提供商账户。OpenClaw 会打开该提供商自己的登录流程，然后通过真实回复进行验证。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用現有的訂閱或供應商帳戶。OpenClaw 會開啟供應商本身的登入流程，然後以實際回覆驗證。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use uma assinatura ou conta de provedor existente. O OpenClaw abre o próprio fluxo de login do provedor e depois o verifica com uma resposta real."}},"de":{"stringUnit":{"state":"translated","value":"Verwende ein bestehendes Abonnement oder Anbieterkonto. OpenClaw öffnet den eigenen Anmeldevorgang des Anbieters und verifiziert ihn dann mit einer echten Antwort."}},"es":{"stringUnit":{"state":"translated","value":"Usa una suscripción o cuenta de proveedor existente. OpenClaw abre el propio flujo de inicio de sesión del proveedor y luego lo verifica con una respuesta real."}},"ja-JP":{"stringUnit":{"state":"translated","value":"既存のサブスクリプションまたはプロバイダーアカウントを使用します。OpenClaw はプロバイダー独自のサインインフローを開き、実際の応答で検証します。"}},"ko":{"stringUnit":{"state":"translated","value":"기존 구독 또는 공급자 계정을 사용하세요. OpenClaw가 공급자의 자체 로그인 절차를 열고, 실제 응답으로 이를 확인합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez un abonnement ou un compte fournisseur existant. OpenClaw ouvre le processus de connexion propre au fournisseur, puis le vérifie avec une réponse réelle."}},"hi":{"stringUnit":{"state":"translated","value":"किसी मौजूदा सदस्यता या प्रदाता खाते का उपयोग करें। OpenClaw प्रदाता के अपने साइन-इन फ़्लो को खोलता है, फिर एक वास्तविक उत्तर के साथ इसे सत्यापित करता है।"}},"ar":{"stringUnit":{"state":"translated","value":"استخدم اشتراكًا أو حساب مزوّد موجودًا. يفتح OpenClaw مسار تسجيل الدخول الخاص بالمزوّد، ثم يتحقق منه بردّ حقيقي."}},"it":{"stringUnit":{"state":"translated","value":"Usa un abbonamento o un account provider esistente. OpenClaw apre il flusso di accesso del provider stesso, quindi lo verifica con una risposta reale."}},"tr":{"stringUnit":{"state":"translated","value":"Mevcut bir abonelik veya sağlayıcı hesabı kullanın. OpenClaw, sağlayıcının kendi oturum açma akışını açar, ardından gerçek bir yanıtla doğrular."}},"uk":{"stringUnit":{"state":"translated","value":"Використовуйте наявну підписку або обліковий запис провайдера. OpenClaw відкриває власний процес входу провайдера, а потім перевіряє його реальною відповіддю."}},"id":{"stringUnit":{"state":"translated","value":"Gunakan langganan atau akun penyedia yang sudah ada. OpenClaw membuka alur masuk milik penyedia sendiri, lalu memverifikasinya dengan balasan sungguhan."}},"pl":{"stringUnit":{"state":"translated","value":"Użyj istniejącej subskrypcji lub konta dostawcy. OpenClaw otwiera własny proces logowania dostawcy, a następnie weryfikuje go prawdziwą odpowiedzią."}},"th":{"stringUnit":{"state":"translated","value":"ใช้การสมัครสมาชิกหรือบัญชีผู้ให้บริการที่มีอยู่ OpenClaw จะเปิดขั้นตอนการลงชื่อเข้าใช้ของผู้ให้บริการเอง จากนั้นยืนยันด้วยการตอบกลับจริง"}},"vi":{"stringUnit":{"state":"translated","value":"Dùng gói đăng ký hoặc tài khoản nhà cung cấp hiện có. OpenClaw mở luồng đăng nhập riêng của nhà cung cấp, rồi xác minh bằng một phản hồi thực."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik een bestaand abonnement of provideraccount. OpenClaw opent de eigen aanmeldflow van de provider en verifieert die vervolgens met een echt antwoord."}},"fa":{"stringUnit":{"state":"translated","value":"از اشتراک یا حساب ارائه‌دهنده موجود استفاده کنید. OpenClaw جریان ورود خود ارائه‌دهنده را باز می‌کند، سپس آن را با یک پاسخ واقعی تأیید می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте существующую подписку или аккаунт провайдера. OpenClaw откроет собственный процесс входа провайдера, затем проверит его реальным ответом."}},"sv":{"stringUnit":{"state":"translated","value":"Använd en befintlig prenumeration eller ett leverantörskonto. OpenClaw öppnar leverantörens egen inloggningsflöde och verifierar det sedan med ett riktigt svar."}}}},
    "Use file version": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use file version"}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用文件版本"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用檔案版本"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usar versão do arquivo"}},"de":{"stringUnit":{"state":"translated","value":"Dateiversion verwenden"}},"es":{"stringUnit":{"state":"translated","value":"Usar versión del archivo"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ファイルのバージョンを使用"}},"ko":{"stringUnit":{"state":"translated","value":"파일 버전 사용"}},"fr":{"stringUnit":{"state":"translated","value":"Utiliser la version du fichier"}},"hi":{"stringUnit":{"state":"translated","value":"फ़ाइल संस्करण का उपयोग करें"}},"ar":{"stringUnit":{"state":"translated","value":"استخدام نسخة الملف"}},"it":{"stringUnit":{"state":"translated","value":"Usa la versione del file"}},"tr":{"stringUnit":{"state":"translated","value":"Dosya sürümünü kullan"}},"uk":{"stringUnit":{"state":"translated","value":"Використати версію файлу"}},"id":{"stringUnit":{"state":"translated","value":"Gunakan versi file"}},"pl":{"stringUnit":{"state":"translated","value":"Użyj wersji z pliku"}},"th":{"stringUnit":{"state":"translated","value":"ใช้เวอร์ชันจากไฟล์"}},"vi":{"stringUnit":{"state":"translated","value":"Dùng phiên bản tệp"}},"nl":{"stringUnit":{"state":"translated","value":"Bestandsversie gebruiken"}},"fa":{"stringUnit":{"state":"translated","value":"استفاده از نسخه فایل"}},"ru":{"stringUnit":{"state":"translated","value":"Использовать версию из файла"}},"sv":{"stringUnit":{"state":"translated","value":"Använd filversion"}}}},
    "Use the panel + Canvas": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use the panel + Canvas"}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用面板 + Canvas"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用面板 + Canvas"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usar o painel + Canvas"}},"de":{"stringUnit":{"state":"translated","value":"Panel + Canvas verwenden"}},"es":{"stringUnit":{"state":"translated","value":"Usa el panel + Canvas"}},"ja-JP":{"stringUnit":{"state":"translated","value":"パネル + Canvas を使用"}},"ko":{"stringUnit":{"state":"translated","value":"패널 + Canvas 사용"}},"fr":{"stringUnit":{"state":"translated","value":"Utiliser le panneau + Canvas"}},"hi":{"stringUnit":{"state":"translated","value":"पैनल + Canvas का उपयोग करें"}},"ar":{"stringUnit":{"state":"translated","value":"استخدم اللوحة + Canvas"}},"it":{"stringUnit":{"state":"translated","value":"Usa il pannello + Canvas"}},"tr":{"stringUnit":{"state":"translated","value":"Panel + Canvas’ı kullanın"}},"uk":{"stringUnit":{"state":"translated","value":"Використовуйте панель + Canvas"}},"id":{"stringUnit":{"state":"translated","value":"Gunakan panel + Canvas"}},"pl":{"stringUnit":{"state":"translated","value":"Użyj panelu + Canvas"}},"th":{"stringUnit":{"state":"translated","value":"ใช้แผง + Canvas"}},"vi":{"stringUnit":{"state":"translated","value":"Dùng bảng điều khiển + Canvas"}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik het paneel + Canvas"}},"fa":{"stringUnit":{"state":"translated","value":"از پنل + Canvas استفاده کنید"}},"ru":{"stringUnit":{"state":"translated","value":"Используйте панель + Canvas"}},"sv":{"stringUnit":{"state":"translated","value":"Använd panelen + Canvas"}}}},
    "Use wss:// for public hosts. ws:// is allowed for localhost, LAN, .local, and Tailnet hosts.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use wss:// for public hosts. ws:// is allowed for localhost, LAN, .local, and Tailnet hosts."}},"zh-CN":{"stringUnit":{"state":"translated","value":"对公共主机使用 wss://。ws:// 允许用于 localhost、LAN、.local 和 Tailnet 主机。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"公開主機請使用 wss://。localhost、LAN、.local 和 Tailnet 主機允許使用 ws://。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use wss:// para hosts públicos. ws:// é permitido para localhost, LAN, .local e hosts Tailnet."}},"de":{"stringUnit":{"state":"translated","value":"Verwenden Sie wss:// für öffentliche Hosts. ws:// ist für localhost, LAN, .local und Tailnet-Hosts erlaubt."}},"es":{"stringUnit":{"state":"translated","value":"Use wss:// para hosts públicos. ws:// está permitido para localhost, LAN, .local y hosts Tailnet."}},"ja-JP":{"stringUnit":{"state":"translated","value":"公開ホストには wss:// を使用してください。localhost、LAN、.local、Tailnet ホストでは ws:// が許可されます。"}},"ko":{"stringUnit":{"state":"translated","value":"공개 호스트에는 wss://를 사용하세요. localhost, LAN, .local 및 Tailnet 호스트에는 ws://가 허용됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisez wss:// pour les hôtes publics. ws:// est autorisé pour localhost, LAN, .local et les hôtes Tailnet."}},"hi":{"stringUnit":{"state":"translated","value":"सार्वजनिक होस्ट के लिए wss:// का उपयोग करें. localhost, LAN, .local, और Tailnet होस्ट के लिए ws:// की अनुमति है."}},"ar":{"stringUnit":{"state":"translated","value":"استخدم wss:// للمضيفين العامين. يُسمح بـ ws:// للمضيف المحلي وLAN و.local ومضيفي Tailnet."}},"it":{"stringUnit":{"state":"translated","value":"Usa wss:// per gli host pubblici. ws:// è consentito per localhost, LAN, .local e gli host Tailnet."}},"tr":{"stringUnit":{"state":"translated","value":"Genel ana makineler için wss:// kullanın. localhost, LAN, .local ve Tailnet ana makineleri için ws:// kullanımına izin verilir."}},"uk":{"stringUnit":{"state":"translated","value":"Використовуйте wss:// для публічних хостів. ws:// дозволено для localhost, LAN, .local і хостів Tailnet."}},"id":{"stringUnit":{"state":"translated","value":"Gunakan wss:// untuk host publik. ws:// diizinkan untuk localhost, LAN, .local, dan host Tailnet."}},"pl":{"stringUnit":{"state":"translated","value":"Użyj wss:// dla hostów publicznych. ws:// jest dozwolone dla hostów localhost, LAN, .local i Tailnet."}},"th":{"stringUnit":{"state":"translated","value":"ใช้ wss:// สำหรับโฮสต์สาธารณะ อนุญาตให้ใช้ ws:// สำหรับ localhost, LAN, .local และโฮสต์ Tailnet"}},"vi":{"stringUnit":{"state":"translated","value":"Sử dụng wss:// cho máy chủ công khai. ws:// được phép cho localhost, LAN, .local và máy chủ Tailnet."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik wss:// voor openbare hosts. ws:// is toegestaan voor localhost, LAN, .local en Tailnet-hosts."}},"fa":{"stringUnit":{"state":"translated","value":"برای میزبان‌های عمومی از wss:// استفاده کنید. ws:// برای localhost، LAN، .local، و میزبان‌های Tailnet مجاز است."}},"ru":{"stringUnit":{"state":"translated","value":"Используйте wss:// для публичных хостов. ws:// разрешен для localhost, LAN, .local и хостов Tailnet."}},"sv":{"stringUnit":{"state":"translated","value":"Använd wss:// för offentliga värdar. ws:// är tillåtet för localhost, LAN, .local och Tailnet-värdar."}}}},
    "Use your browser logins": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Use your browser logins"}},"zh-CN":{"stringUnit":{"state":"translated","value":"使用你的浏览器登录信息"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用您的瀏覽器登入資訊"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Use seus logins de navegador"}},"de":{"stringUnit":{"state":"translated","value":"Deine Browser-Logins verwenden"}},"es":{"stringUnit":{"state":"translated","value":"Usa los inicios de sesión de tu navegador"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ブラウザのログインを使用"}},"ko":{"stringUnit":{"state":"translated","value":"브라우저 로그인 사용"}},"fr":{"stringUnit":{"state":"translated","value":"Utiliser vos identifiants de navigateur"}},"hi":{"stringUnit":{"state":"translated","value":"अपने ब्राउज़र लॉगिन का उपयोग करें"}},"ar":{"stringUnit":{"state":"translated","value":"استخدم عمليات تسجيل الدخول في متصفحك"}},"it":{"stringUnit":{"state":"translated","value":"Usa i login del tuo browser"}},"tr":{"stringUnit":{"state":"translated","value":"Tarayıcı oturumlarınızı kullanın"}},"uk":{"stringUnit":{"state":"translated","value":"Використовуйте логіни вашого браузера"}},"id":{"stringUnit":{"state":"translated","value":"Gunakan login browser Anda"}},"pl":{"stringUnit":{"state":"translated","value":"Użyj loginów z przeglądarki"}},"th":{"stringUnit":{"state":"translated","value":"ใช้การเข้าสู่ระบบเบราว์เซอร์ของคุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Dùng thông tin đăng nhập trình duyệt của bạn"}},"nl":{"stringUnit":{"state":"translated","value":"Gebruik je browseraanmeldingen"}},"fa":{"stringUnit":{"state":"translated","value":"از ورودهای مرورگر خود استفاده کنید"}},"ru":{"stringUnit":{"state":"translated","value":"Использовать логины из браузера"}},"sv":{"stringUnit":{"state":"translated","value":"Använd dina webbläsarinloggningar"}}}},
    "Used by the CLI session loader; stored in ~/.openclaw/openclaw.json.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Used by the CLI session loader; stored in ~/.openclaw/openclaw.json."}},"zh-CN":{"stringUnit":{"state":"translated","value":"由 CLI 会话加载器使用；存储在 ~/.openclaw/openclaw.json 中。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"供 CLI 工作階段載入器使用；儲存在 ~/.openclaw/openclaw.json。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usado pelo carregador de sessões da CLI; armazenado em ~/.openclaw/openclaw.json."}},"de":{"stringUnit":{"state":"translated","value":"Wird vom CLI-Sitzungslader verwendet; gespeichert in ~/.openclaw/openclaw.json."}},"es":{"stringUnit":{"state":"translated","value":"Lo usa el cargador de sesiones de la CLI; se almacena en ~/.openclaw/openclaw.json."}},"ja-JP":{"stringUnit":{"state":"translated","value":"CLI セッションローダーで使用されます。~/.openclaw/openclaw.json に保存されます。"}},"ko":{"stringUnit":{"state":"translated","value":"CLI 세션 로더에서 사용되며 ~/.openclaw/openclaw.json에 저장됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisé par le chargeur de sessions CLI ; stocké dans ~/.openclaw/openclaw.json."}},"hi":{"stringUnit":{"state":"translated","value":"CLI सेशन लोडर द्वारा उपयोग किया जाता है; ~/.openclaw/openclaw.json में संग्रहीत।"}},"ar":{"stringUnit":{"state":"translated","value":"يُستخدم بواسطة محمّل جلسات CLI؛ ويُخزّن في ~/.openclaw/openclaw.json."}},"it":{"stringUnit":{"state":"translated","value":"Usato dal loader di sessione della CLI; archiviato in ~/.openclaw/openclaw.json."}},"tr":{"stringUnit":{"state":"translated","value":"CLI oturum yükleyicisi tarafından kullanılır; ~/.openclaw/openclaw.json içinde saklanır."}},"uk":{"stringUnit":{"state":"translated","value":"Використовується завантажувачем сеансів CLI; зберігається в ~/.openclaw/openclaw.json."}},"id":{"stringUnit":{"state":"translated","value":"Digunakan oleh pemuat sesi CLI; disimpan di ~/.openclaw/openclaw.json."}},"pl":{"stringUnit":{"state":"translated","value":"Używane przez loader sesji CLI; przechowywane w ~/.openclaw/openclaw.json."}},"th":{"stringUnit":{"state":"translated","value":"ใช้โดยตัวโหลดเซสชัน CLI; จัดเก็บไว้ใน ~/.openclaw/openclaw.json"}},"vi":{"stringUnit":{"state":"translated","value":"Được dùng bởi trình tải phiên CLI; được lưu trong ~/.openclaw/openclaw.json."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruikt door de CLI-sessielader; opgeslagen in ~/.openclaw/openclaw.json."}},"fa":{"stringUnit":{"state":"translated","value":"توسط بارگذار نشست CLI استفاده می‌شود؛ در ~/.openclaw/openclaw.json ذخیره می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Используется загрузчиком сеансов CLI; хранится в ~/.openclaw/openclaw.json."}},"sv":{"stringUnit":{"state":"translated","value":"Används av CLI-sessionsinläsaren; lagras i ~/.openclaw/openclaw.json."}}}},
    "Used for pnpm/node fallback and PATH population when launching the gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Used for pnpm/node fallback and PATH population when launching the gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在启动 gateway 时用于 pnpm/node 回退和 PATH 填充。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在啟動 Gateway 時，用於 pnpm/node 備援與填入 PATH。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usado para fallback de pnpm/node e preenchimento de PATH ao iniciar o gateway."}},"de":{"stringUnit":{"state":"translated","value":"Wird für pnpm/node-Fallback und PATH-Befüllung beim Starten des Gateway verwendet."}},"es":{"stringUnit":{"state":"translated","value":"Se usa para la reserva de pnpm/node y la población de PATH al iniciar el Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway の起動時に、pnpm/node のフォールバックと PATH の設定に使用されます。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway를 시작할 때 pnpm/node 폴백 및 PATH 채우기에 사용됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisé pour le repli pnpm/node et le remplissage de PATH lors du lancement du gateway."}},"hi":{"stringUnit":{"state":"translated","value":"gateway लॉन्च करते समय pnpm/node फ़ॉलबैक और PATH पॉप्युलेशन के लिए उपयोग किया जाता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يُستخدم للرجوع إلى pnpm/node وتعبئة PATH عند تشغيل Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Usato per il fallback pnpm/node e il popolamento di PATH all'avvio del gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway başlatılırken pnpm/node yedeği ve PATH doldurma için kullanılır."}},"uk":{"stringUnit":{"state":"translated","value":"Використовується для резервного pnpm/node і заповнення PATH під час запуску gateway."}},"id":{"stringUnit":{"state":"translated","value":"Digunakan untuk fallback pnpm/node dan pengisian PATH saat meluncurkan gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Używane jako rozwiązanie awaryjne dla pnpm/node oraz do uzupełniania PATH podczas uruchamiania gateway."}},"th":{"stringUnit":{"state":"translated","value":"ใช้สำหรับ pnpm/node fallback และการเติม PATH เมื่อเปิดใช้งาน gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Được dùng cho phương án dự phòng pnpm/node và điền PATH khi khởi chạy gateway."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruikt voor pnpm/node-fallback en PATH-populatie bij het starten van de gateway."}},"fa":{"stringUnit":{"state":"translated","value":"برای جایگزین pnpm/node و مقداردهی PATH هنگام راه‌اندازی gateway استفاده می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Используется для резервного pnpm/node и заполнения PATH при запуске gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Används för pnpm/node-reservlösning och PATH-populering när gatewayen startas."}}}},
    "Used when the remote gateway requires token auth.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Used when the remote gateway requires token auth."}},"zh-CN":{"stringUnit":{"state":"translated","value":"当远程 Gateway 需要令牌认证时使用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"當遠端 Gateway 需要權杖驗證時使用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usado quando o gateway remoto exige autenticação por token."}},"de":{"stringUnit":{"state":"translated","value":"Wird verwendet, wenn das Remote-Gateway Token-Authentifizierung erfordert."}},"es":{"stringUnit":{"state":"translated","value":"Se usa cuando el Gateway remoto requiere autenticación con token."}},"ja-JP":{"stringUnit":{"state":"translated","value":"リモート Gateway がトークン認証を必要とする場合に使用されます。"}},"ko":{"stringUnit":{"state":"translated","value":"원격 Gateway에 토큰 인증이 필요할 때 사용됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisé lorsque la Gateway distante nécessite une authentification par jeton."}},"hi":{"stringUnit":{"state":"translated","value":"जब रिमोट Gateway को टोकन प्रमाणीकरण की आवश्यकता हो, तब उपयोग किया जाता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يُستخدم عندما يتطلب Gateway البعيد مصادقة بالرمز."}},"it":{"stringUnit":{"state":"translated","value":"Usato quando il gateway remoto richiede l'autenticazione tramite token."}},"tr":{"stringUnit":{"state":"translated","value":"Uzak Gateway token kimlik doğrulaması gerektirdiğinde kullanılır."}},"uk":{"stringUnit":{"state":"translated","value":"Використовується, коли віддалений Gateway вимагає автентифікацію за токеном."}},"id":{"stringUnit":{"state":"translated","value":"Digunakan ketika gateway jarak jauh memerlukan autentikasi token."}},"pl":{"stringUnit":{"state":"translated","value":"Używane, gdy zdalny Gateway wymaga uwierzytelniania tokenem."}},"th":{"stringUnit":{"state":"translated","value":"ใช้เมื่อ Gateway ระยะไกลต้องมีการยืนยันตัวตนด้วยโทเค็น"}},"vi":{"stringUnit":{"state":"translated","value":"Được dùng khi gateway từ xa yêu cầu xác thực bằng token."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruikt wanneer de externe gateway tokenauthenticatie vereist."}},"fa":{"stringUnit":{"state":"translated","value":"زمانی استفاده می‌شود که Gateway راه دور به احراز هویت با توکن نیاز دارد."}},"ru":{"stringUnit":{"state":"translated","value":"Используется, когда удаленному Gateway требуется аутентификация по токену."}},"sv":{"stringUnit":{"state":"translated","value":"Används när den fjärranslutna Gateway kräver tokenautentisering."}}}},
    "User": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"User"}},"zh-CN":{"stringUnit":{"state":"translated","value":"用户"}},"zh-TW":{"stringUnit":{"state":"translated","value":"使用者"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usuário"}},"de":{"stringUnit":{"state":"translated","value":"Benutzer"}},"es":{"stringUnit":{"state":"translated","value":"Usuario"}},"ja-JP":{"stringUnit":{"state":"translated","value":"ユーザー"}},"ko":{"stringUnit":{"state":"translated","value":"사용자"}},"fr":{"stringUnit":{"state":"translated","value":"Utilisateur"}},"hi":{"stringUnit":{"state":"translated","value":"उपयोगकर्ता"}},"ar":{"stringUnit":{"state":"translated","value":"المستخدم"}},"it":{"stringUnit":{"state":"translated","value":"Utente"}},"tr":{"stringUnit":{"state":"translated","value":"Kullanıcı"}},"uk":{"stringUnit":{"state":"translated","value":"Користувач"}},"id":{"stringUnit":{"state":"translated","value":"Pengguna"}},"pl":{"stringUnit":{"state":"translated","value":"Użytkownik"}},"th":{"stringUnit":{"state":"translated","value":"ผู้ใช้"}},"vi":{"stringUnit":{"state":"translated","value":"Người dùng"}},"nl":{"stringUnit":{"state":"translated","value":"Gebruiker"}},"fa":{"stringUnit":{"state":"translated","value":"کاربر"}},"ru":{"stringUnit":{"state":"translated","value":"Пользователь"}},"sv":{"stringUnit":{"state":"translated","value":"Användare"}}}},
    "User and host for the remote Gateway machine.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"User and host for the remote Gateway machine."}},"zh-CN":{"stringUnit":{"state":"translated","value":"远程 Gateway 机器的用户和主机。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"遠端 Gateway 機器的使用者與主機。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Usuário e host da máquina remota do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Benutzer und Host für die Remote-Gateway-Maschine."}},"es":{"stringUnit":{"state":"translated","value":"Usuario y host de la máquina remota del Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"リモート Gateway マシンのユーザーとホスト。"}},"ko":{"stringUnit":{"state":"translated","value":"원격 Gateway 머신의 사용자 및 호스트입니다."}},"fr":{"stringUnit":{"state":"translated","value":"Utilisateur et hôte de la machine Gateway distante."}},"hi":{"stringUnit":{"state":"translated","value":"दूरस्थ Gateway मशीन के लिए user और host।"}},"ar":{"stringUnit":{"state":"translated","value":"المستخدم والمضيف لجهاز Gateway البعيد."}},"it":{"stringUnit":{"state":"translated","value":"Utente e host per la macchina Gateway remota."}},"tr":{"stringUnit":{"state":"translated","value":"Uzak Gateway makinesi için kullanıcı ve ana makine."}},"uk":{"stringUnit":{"state":"translated","value":"Користувач і хост для віддаленої машини Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Pengguna dan host untuk mesin Gateway jarak jauh."}},"pl":{"stringUnit":{"state":"translated","value":"Użytkownik i host zdalnej maszyny Gateway."}},"th":{"stringUnit":{"state":"translated","value":"ผู้ใช้และโฮสต์สำหรับเครื่อง Gateway ระยะไกล"}},"vi":{"stringUnit":{"state":"translated","value":"Người dùng và máy chủ cho máy Gateway từ xa."}},"nl":{"stringUnit":{"state":"translated","value":"Gebruiker en host voor de externe Gateway-machine."}},"fa":{"stringUnit":{"state":"translated","value":"کاربر و میزبان برای دستگاه Gateway از راه دور."}},"ru":{"s