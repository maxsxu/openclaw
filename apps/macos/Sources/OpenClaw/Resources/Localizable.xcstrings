    "Menu bar companion for notifications, screenshots, and privileged agent actions.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Menu bar companion for notifications, screenshots, and privileged agent actions."}},"zh-CN":{"stringUnit":{"state":"translated","value":"用于通知、截图和特权代理操作的菜单栏伴侣。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"用於通知、螢幕截圖和特權代理程式操作的選單列輔助工具。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Companion da barra de menus para notificações, capturas de tela e ações do agente privilegiado."}},"de":{"stringUnit":{"state":"translated","value":"Menüleisten-Begleiter für Benachrichtigungen, Screenshots und privilegierte Agent-Aktionen."}},"es":{"stringUnit":{"state":"translated","value":"Complemento de la barra de menús para notificaciones, capturas de pantalla y acciones de agente con privilegios."}},"ja-JP":{"stringUnit":{"state":"translated","value":"通知、スクリーンショット、特権エージェント操作のためのメニューバーコンパニオン。"}},"ko":{"stringUnit":{"state":"translated","value":"알림, 스크린샷 및 권한이 필요한 에이전트 작업을 위한 메뉴 막대 컴패니언."}},"fr":{"stringUnit":{"state":"translated","value":"Compagnon de la barre des menus pour les notifications, les captures d’écran et les actions d’agent privilégiées."}},"hi":{"stringUnit":{"state":"translated","value":"सूचनाओं, स्क्रीनशॉट और विशेषाधिकार प्राप्त एजेंट क्रियाओं के लिए मेनू बार साथी।"}},"ar":{"stringUnit":{"state":"translated","value":"مرافق شريط القوائم للإشعارات ولقطات الشاشة وإجراءات الوكيل ذات الامتيازات."}},"it":{"stringUnit":{"state":"translated","value":"Companion della barra dei menu per notifiche, screenshot e azioni dell'agente con privilegi."}},"tr":{"stringUnit":{"state":"translated","value":"Bildirimler, ekran görüntüleri ve ayrıcalıklı aracı eylemleri için menü çubuğu eşlikçisi."}},"uk":{"stringUnit":{"state":"translated","value":"Супутній застосунок у рядку меню для сповіщень, знімків екрана та дій привілейованого агента."}},"id":{"stringUnit":{"state":"translated","value":"Pendamping bilah menu untuk 