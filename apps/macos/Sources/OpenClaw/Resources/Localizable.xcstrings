    "On another computer": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On another computer"}},"zh-CN":{"stringUnit":{"state":"translated","value":"在另一台电脑上"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在另一台電腦上"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Em outro computador"}},"de":{"stringUnit":{"state":"translated","value":"Auf einem anderen Computer"}},"es":{"stringUnit":{"state":"translated","value":"En otro ordenador"}},"ja-JP":{"stringUnit":{"state":"translated","value":"別のコンピューター上"}},"ko":{"stringUnit":{"state":"translated","value":"다른 컴퓨터에서"}},"fr":{"stringUnit":{"state":"translated","value":"Sur un autre ordinateur"}},"hi":{"stringUnit":{"state":"translated","value":"किसी दूसरे कंप्यूटर पर"}},"ar":{"stringUnit":{"state":"translated","value":"على كمبيوتر آخر"}},"it":{"stringUnit":{"state":"translated","value":"Su un altro computer"}},"tr":{"stringUnit":{"state":"translated","value":"Başka bir bilgisayarda"}},"uk":{"stringUnit":{"state":"translated","value":"На іншому комп’ютері"}},"id":{"stringUnit":{"state":"translated","value":"Di komputer lain"}},"pl":{"stringUnit":{"state":"translated","value":"Na innym komputerze"}},"th":{"stringUnit":{"state":"translated","value":"บนคอมพิวเตอร์เครื่องอื่น"}},"vi":{"stringUnit":{"state":"translated","value":"Trên máy tính khác"}},"nl":{"stringUnit":{"state":"translated","value":"Op een andere computer"}},"fa":{"stringUnit":{"state":"translated","value":"روی یک رایانه دیگر"}},"ru":{"stringUnit":{"state":"translated","value":"На другом компьютере"}},"sv":{"stringUnit":{"state":"translated","value":"På en annan dator"}}}},
    "On the gateway host, run `openclaw gateway auth-token --show` in an interactive terminal, then replace the token and try again.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On the gateway host, run `openclaw gateway auth-token --show` in an interactive terminal, then replace the token and try again."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在 gateway 主机上，于交互式终端中运行 `openclaw gateway auth-token --show`，然后替换令牌并重试。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在 gateway 主機上，於互動式終端機中執行 `openclaw gateway auth-token --show`，然後替換權杖並再試一次。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"No host do gateway, execute `openclaw gateway auth-token --show` em um terminal interativo, substitua o token e tente novamente."}},"de":{"stringUnit":{"state":"translated","value":"Führen Sie auf dem Gateway-Host `openclaw gateway auth-token --show` in einem interaktiven Terminal aus, ersetzen Sie dann das Token und versuchen Sie es erneut."}},"es":{"stringUnit":{"state":"translated","value":"En el host del Gateway, ejecuta `openclaw gateway auth-token --show` en una terminal interactiva, luego reemplaza el token e inténtalo de nuevo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayホストで、対話型ターミナルで `openclaw gateway auth-token --show` を実行し、トークンを置き換えてから再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"gateway 호스트에서 대화형 터미널로 `openclaw gateway auth-token --show`를 실행한 다음 토큰을 교체하고 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Sur l'hôte du gateway, exécutez `openclaw gateway auth-token --show` dans un terminal interactif, puis remplacez le jeton et réessayez."}},"hi":{"stringUnit":{"state":"translated","value":"gateway host पर, एक इंटरैक्टिव टर्मिनल में `openclaw gateway auth-token --show` चलाएँ, फिर token बदलें और पुनः प्रयास करें।"}},"ar":{"stringUnit":{"state":"translated","value":"على مضيف Gateway، شغّل `openclaw gateway auth-token --show` في طرفية تفاعلية، ثم استبدل الرمز وأعد المحاولة."}},"it":{"stringUnit":{"state":"translated","value":"Sull'host del gateway, esegui `openclaw gateway auth-token --show` in un terminale interattivo, quindi sostituisci il token e riprova."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway ana bilgisayarında, etkileşimli bir terminalde `openclaw gateway auth-token --show` komutunu çalıştırın, ardından belirteci değiştirip yeniden deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"На хості Gateway виконайте `openclaw gateway auth-token --show` в інтерактивному терміналі, потім замініть токен і спробуйте ще раз."}},"id":{"stringUnit":{"state":"translated","value":"Di host gateway, jalankan `openclaw gateway auth-token --show` di terminal interaktif, lalu ganti token dan coba lagi."}},"pl":{"stringUnit":{"state":"translated","value":"Na hoście gateway uruchom `openclaw gateway auth-token --show` w interaktywnym terminalu, następnie zastąp token i spróbuj ponownie."}},"th":{"stringUnit":{"state":"translated","value":"บนโฮสต์ Gateway ให้รัน `openclaw gateway auth-token --show` ในเทอร์มินัลแบบโต้ตอบ จากนั้นแทนที่โทเคนแล้วลองอีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Trên máy chủ gateway, chạy `openclaw gateway auth-token --show` trong terminal tương tác, sau đó thay thế token và thử lại."}},"nl":{"stringUnit":{"state":"translated","value":"Voer op de gateway-host `openclaw gateway auth-token --show` uit in een interactieve terminal, vervang vervolgens het token en probeer het opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"روی میزبان Gateway، دستور `openclaw gateway auth-token --show` را در یک ترمینال تعاملی اجرا کنید، سپس توکن را جایگزین کرده و دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"На хосте Gateway выполните `openclaw gateway auth-token --show` в интерактивном терминале, затем замените токен и повторите попытку."}},"sv":{"stringUnit":{"state":"translated","value":"På gateway-värden kör du `openclaw gateway auth-token --show` i en interaktiv terminal, ersätter sedan token och försöker igen."}}}},
    "On this Mac": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"On this Mac"}},"zh-CN":{"stringUnit":{"state":"translated","value":"在这台 Mac 上"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在這台 Mac 上"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Neste Mac"}},"de":{"stringUnit":{"state":"translated","value":"Auf diesem Mac"}},"es":{"stringUnit":{"state":"translated","value":"En este Mac"}},"ja-JP":{"stringUnit":{"state":"translated","value":"この Mac 上"}},"ko":{"stringUnit":{"state":"translated","value":"이 Mac에서"}},"fr":{"stringUnit":{"state":"translated","value":"Sur ce Mac"}},"hi":{"stringUnit":{"state":"translated","value":"इस Mac पर"}},"ar":{"stringUnit":{"state":"translated","value":"على جهاز Mac هذا"}},"it":{"stringUnit":{"state":"translated","value":"Su questo Mac"}},"tr":{"stringUnit":{"state":"translated","value":"Bu Mac’te"}},"uk":{"stringUnit":{"state":"translated","value":"На цьому Mac"}},"id":{"stringUnit":{"state":"translated","value":"Di Mac ini"}},"pl":{"stringUnit":{"state":"translated","value":"Na tym Macu"}},"th":{"stringUnit":{"state":"translated","value":"บน Mac เครื่องนี้"}},"vi":{"stringUnit":{"state":"translated","value":"Trên máy Mac này"}},"nl":{"stringUnit":{"state":"translated","value":"Op deze Mac"}},"fa":{"stringUnit":{"state":"translated","value":"روی این Mac"}},"ru":{"stringUnit":{"state":"translated","value":"На этом Mac"}},"sv":{"stringUnit":{"state":"translated","value":"På den här Mac-datorn"}}}},
    "Once the service answers, you’ll connect your AI.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Once the service answers, you’ll connect your AI."}},"zh-CN":{"stringUnit":{"state":"translated","value":"服务响应后，你将连接你的 AI。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"服務回應後，你就可以連接你的 AI。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Quando o serviço responder, você conectará sua IA."}},"de":{"stringUnit":{"state":"translated","value":"Sobald der Dienst antwortet, verbinden Sie Ihre KI."}},"es":{"stringUnit":{"state":"translated","value":"Cuando el servicio responda, conectarás tu IA."}},"ja-JP":{"stringUnit":{"state":"translated","value":"サービスが応答したら、AI に接続します。"}},"ko":{"stringUnit":{"state":"translated","value":"서비스가 응답하면 AI를 연결하게 됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Une fois que le service répond, vous connecterez votre IA."}},"hi":{"stringUnit":{"state":"translated","value":"जब service जवाब देगी, तब आप अपना AI कनेक्ट करेंगे।"}},"ar":{"stringUnit":{"state":"translated","value":"بمجرد أن تستجيب الخدمة، ستتمكن من توصيل الذكاء الاصطناعي الخاص بك."}},"it":{"stringUnit":{"state":"translated","value":"Quando il servizio risponde, collegherai la tua AI."}},"tr":{"stringUnit":{"state":"translated","value":"Hizmet yanıt verdiğinde, yapay zekanızı bağlayacaksınız."}},"uk":{"stringUnit":{"state":"translated","value":"Коли служба відповість, ви підключите свій AI."}},"id":{"stringUnit":{"state":"translated","value":"Setelah layanan merespons, Anda akan menghubungkan AI Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Gdy usługa odpowie, połączysz swoją AI."}},"th":{"stringUnit":{"state":"translated","value":"เมื่อบริการตอบสนองแล้ว คุณจะเชื่อมต่อ AI ของคุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Khi dịch vụ phản hồi, bạn sẽ kết nối AI của mình."}},"nl":{"stringUnit":{"state":"translated","value":"Zodra de service reageert, verbind je je AI."}},"fa":{"stringUnit":{"state":"translated","value":"وقتی سرویس پاسخ دهد، هوش مصنوعی خود را متصل می‌کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Когда служба ответит, вы подключите свой ИИ."}},"sv":{"stringUnit":{"state":"translated","value":"När tjänsten svarar ansluter du din AI."}}}},
    "Only image and video attachments are supported right now": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only image and video attachments are supported right now"}},"zh-CN":{"stringUnit":{"state":"translated","value":"目前仅支持图片和视频附件"}},"zh-TW":{"stringUnit":{"state":"translated","value":"目前僅支援圖片與影片附件"}},"pt-BR":{"stringUnit":{"state":"translated","value":"No momento, apenas anexos de imagem e vídeo são suportados"}},"de":{"stringUnit":{"state":"translated","value":"Derzeit werden nur Bild- und Videoanhänge unterstützt"}},"es":{"stringUnit":{"state":"translated","value":"Por ahora solo se admiten adjuntos de imagen y video"}},"ja-JP":{"stringUnit":{"state":"translated","value":"現在サポートされているのは画像と動画の添付ファイルのみです"}},"ko":{"stringUnit":{"state":"translated","value":"현재 이미지 및 비디오 첨부 파일만 지원됩니다"}},"fr":{"stringUnit":{"state":"translated","value":"Seules les pièces jointes image et vidéo sont prises en charge pour le moment"}},"hi":{"stringUnit":{"state":"translated","value":"अभी केवल इमेज और वीडियो अटैचमेंट समर्थित हैं"}},"ar":{"stringUnit":{"state":"translated","value":"يتم دعم مرفقات الصور والفيديو فقط في الوقت الحالي"}},"it":{"stringUnit":{"state":"translated","value":"Al momento sono supportati solo allegati di immagini e video"}},"tr":{"stringUnit":{"state":"translated","value":"Şu anda yalnızca görüntü ve video ekleri destekleniyor"}},"uk":{"stringUnit":{"state":"translated","value":"Наразі підтримуються лише вкладення зображень і відео"}},"id":{"stringUnit":{"state":"translated","value":"Hanya lampiran gambar dan video yang didukung saat ini"}},"pl":{"stringUnit":{"state":"translated","value":"Obecnie obsługiwane są tylko załączniki obrazów i wideo"}},"th":{"stringUnit":{"state":"translated","value":"ขณะนี้รองรับเฉพาะไฟล์แนบรูปภาพและวิดีโอเท่านั้น"}},"vi":{"stringUnit":{"state":"translated","value":"Hiện chỉ hỗ trợ tệp đính kèm hình ảnh và video"}},"nl":{"stringUnit":{"state":"translated","value":"Momenteel worden alleen afbeeldings- en videobijlagen ondersteund"}},"fa":{"stringUnit":{"state":"translated","value":"در حال حاضر فقط پیوست‌های تصویری و ویدیویی پشتیبانی می‌شوند"}},"ru":{"stringUnit":{"state":"translated","value":"Сейчас поддерживаются только вложения с изображениями и видео"}},"sv":{"stringUnit":{"state":"translated","value":"Endast bild- och videobilagor stöds för närvarande"}}}},
    "Only image attachments are supported right now": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only image attachments are supported right now"}},"zh-CN":{"stringUnit":{"state":"translated","value":"目前仅支持图片附件"}},"zh-TW":{"stringUnit":{"state":"translated","value":"目前僅支援圖片附件"}},"pt-BR":{"stringUnit":{"state":"translated","value":"No momento, apenas anexos de imagem são compatíveis"}},"de":{"stringUnit":{"state":"translated","value":"Derzeit werden nur Bildanhänge unterstützt"}},"es":{"stringUnit":{"state":"translated","value":"Por ahora, solo se admiten archivos adjuntos de imagen"}},"ja-JP":{"stringUnit":{"state":"translated","value":"現在サポートされているのは画像の添付ファイルのみです"}},"ko":{"stringUnit":{"state":"translated","value":"현재는 이미지 첨부 파일만 지원됩니다"}},"fr":{"stringUnit":{"state":"translated","value":"Seules les pièces jointes de type image sont actuellement prises en charge"}},"hi":{"stringUnit":{"state":"translated","value":"फ़िलहाल केवल इमेज अटैचमेंट समर्थित हैं"}},"ar":{"stringUnit":{"state":"translated","value":"لا تُدعم حاليًا سوى مرفقات الصور"}},"it":{"stringUnit":{"state":"translated","value":"Al momento sono supportati solo gli allegati immagine"}},"tr":{"stringUnit":{"state":"translated","value":"Şu anda yalnızca görsel ekleri destekleniyor"}},"uk":{"stringUnit":{"state":"translated","value":"Наразі підтримуються лише вкладення із зображеннями"}},"id":{"stringUnit":{"state":"translated","value":"Saat ini hanya lampiran gambar yang didukung"}},"pl":{"stringUnit":{"state":"translated","value":"Obecnie obsługiwane są tylko załączniki graficzne"}},"th":{"stringUnit":{"state":"translated","value":"ขณะนี้รองรับเฉพาะไฟล์แนบรูปภาพเท่านั้น"}},"vi":{"stringUnit":{"state":"translated","value":"Hiện tại chỉ hỗ trợ tệp đính kèm hình ảnh"}},"nl":{"stringUnit":{"state":"translated","value":"Momenteel worden alleen afbeeldingsbijlagen ondersteund"}},"fa":{"stringUnit":{"state":"translated","value":"در حال حاضر فقط پیوست‌های تصویری پشتیبانی می‌شوند"}},"ru":{"stringUnit":{"state":"translated","value":"Сейчас поддерживаются только изображения"}},"sv":{"stringUnit":{"state":"translated","value":"Endast bildbilagor stöds just nu"}}}},
    "Only needed when the gateway requires token auth.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Only needed when the gateway requires token auth."}},"zh-CN":{"stringUnit":{"state":"translated","value":"仅在 gateway 需要令牌认证时才需要。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"僅在 gateway 需要權杖驗證時才需要。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Necessário apenas quando o gateway exige autenticação por token."}},"de":{"stringUnit":{"state":"translated","value":"Nur erforderlich, wenn das Gateway eine Token-Authentifizierung verlangt."}},"es":{"stringUnit":{"state":"translated","value":"Solo es necesario cuando el gateway requiere autenticación por token."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway がトークン認証を必要とする場合のみ必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"게이트웨이에서 토큰 인증이 필요한 경우에만 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Nécessaire uniquement lorsque le gateway requiert une authentification par jeton."}},"hi":{"stringUnit":{"state":"translated","value":"केवल तभी आवश्यक जब gateway को टोकन प्रमाणीकरण चाहिए।"}},"ar":{"stringUnit":{"state":"translated","value":"مطلوب فقط عندما يتطلب الـ gateway مصادقة برمز مميز."}},"it":{"stringUnit":{"state":"translated","value":"Necessario solo quando il gateway richiede l'autenticazione con token."}},"tr":{"stringUnit":{"state":"translated","value":"Yalnızca gateway belirteç kimlik doğrulaması gerektirdiğinde gereklidir."}},"uk":{"stringUnit":{"state":"translated","value":"Потрібно лише коли gateway вимагає автентифікації за токеном."}},"id":{"stringUnit":{"state":"translated","value":"Hanya diperlukan saat gateway membutuhkan autentikasi token."}},"pl":{"stringUnit":{"state":"translated","value":"Wymagane tylko, gdy gateway wymaga uwierzytelniania tokenem."}},"th":{"stringUnit":{"state":"translated","value":"จำเป็นเฉพาะเมื่อ gateway ต้องการการยืนยันตัวตนด้วยโทเค็นเท่านั้น"}},"vi":{"stringUnit":{"state":"translated","value":"Chỉ cần thiết khi gateway yêu cầu xác thực bằng token."}},"nl":{"stringUnit":{"state":"translated","value":"Alleen nodig wanneer de gateway tokenauthenticatie vereist."}},"fa":{"stringUnit":{"state":"translated","value":"فقط زمانی لازم است که gateway به احراز هویت با توکن نیاز دارد."}},"ru":{"stringUnit":{"state":"translated","value":"Требуется только когда gateway использует авторизацию по токену."}},"sv":{"stringUnit":{"state":"translated","value":"Behövs bara när gatewayen kräver token-autentisering."}}}},
    "Open": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open"}},"zh-CN":{"stringUnit":{"state":"translated","value":"打开"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開啟"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abrir"}},"de":{"stringUnit":{"state":"translated","value":"Öffnen"}},"es":{"stringUnit":{"state":"translated","value":"Abrir"}},"ja-JP":{"stringUnit":{"state":"translated","value":"開く"}},"ko":{"stringUnit":{"state":"translated","value":"열기"}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrir"}},"hi":{"stringUnit":{"state":"translated","value":"खोलें"}},"ar":{"stringUnit":{"state":"translated","value":"فتح"}},"it":{"stringUnit":{"state":"translated","value":"Apri"}},"tr":{"stringUnit":{"state":"translated","value":"Aç"}},"uk":{"stringUnit":{"state":"translated","value":"Відкрити"}},"id":{"stringUnit":{"state":"translated","value":"Buka"}},"pl":{"stringUnit":{"state":"translated","value":"Otwórz"}},"th":{"stringUnit":{"state":"translated","value":"เปิด"}},"vi":{"stringUnit":{"state":"translated","value":"Mở"}},"nl":{"stringUnit":{"state":"translated","value":"Openen"}},"fa":{"stringUnit":{"state":"translated","value":"باز کردن"}},"ru":{"stringUnit":{"state":"translated","value":"Открыть"}},"sv":{"stringUnit":{"state":"translated","value":"Öppna"}}}},
    "Open Agent Events": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open Agent Events"}},"zh-CN":{"stringUnit":{"state":"translated","value":"打开 Agent Events"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開啟 Agent 事件"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abrir eventos do agente"}},"de":{"stringUnit":{"state":"translated","value":"Agent Events öffnen"}},"es":{"stringUnit":{"state":"translated","value":"Abrir eventos del agente"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Agent Events を開く"}},"ko":{"stringUnit":{"state":"translated","value":"Agent Events 열기"}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrir les événements de l’agent"}},"hi":{"stringUnit":{"state":"translated","value":"एजेंट इवेंट्स खोलें"}},"ar":{"stringUnit":{"state":"translated","value":"فتح أحداث الوكيل"}},"it":{"stringUnit":{"state":"translated","value":"Apri eventi agente"}},"tr":{"stringUnit":{"state":"translated","value":"Agent Events’i Aç"}},"uk":{"stringUnit":{"state":"translated","value":"Відкрити Agent Events"}},"id":{"stringUnit":{"state":"translated","value":"Buka Agent Events"}},"pl":{"stringUnit":{"state":"translated","value":"Otwórz zdarzenia agenta"}},"th":{"stringUnit":{"state":"translated","value":"เปิด Agent Events"}},"vi":{"stringUnit":{"state":"translated","value":"Mở Sự kiện Agent"}},"nl":{"stringUnit":{"state":"translated","value":"Agent Events openen"}},"fa":{"stringUnit":{"state":"translated","value":"باز کردن رویدادهای Agent"}},"ru":{"stringUnit":{"state":"translated","value":"Открыть события агента"}},"sv":{"stringUnit":{"state":"translated","value":"Öppna Agent Events"}}}},
