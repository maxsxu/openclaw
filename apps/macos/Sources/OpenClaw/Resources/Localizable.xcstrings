    "Tool changes apply to the next run.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tool changes apply to the next run."}},"zh-CN":{"stringUnit":{"state":"translated","value":"工具更改将在下次运行时生效。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"工具變更將於下次執行時套用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As alterações de ferramentas se aplicam à próxima execução."}},"de":{"stringUnit":{"state":"translated","value":"Tool-Änderungen werden beim nächsten Durchlauf angewendet."}},"es":{"stringUnit":{"state":"translated","value":"Los cambios de herramientas se aplican en la próxima ejecución."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ツールの変更は次回の実行から適用されます。"}},"ko":{"stringUnit":{"state":"translated","value":"도구 변경 사항은 다음 실행에 적용됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les modifications d'outils s'appliquent à la prochaine exécution."}},"hi":{"stringUnit":{"state":"translated","value":"Tool परिवर्तन अगले रन पर लागू होते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"تُطبَّق تغييرات الأدوات في التشغيل التالي."}},"it":{"stringUnit":{"state":"translated","value":"Le modifiche agli strumenti si applicano all'esecuzione successiva."}},"tr":{"stringUnit":{"state":"translated","value":"Araç değişiklikleri bir sonraki çalıştırmada uygulanır."}},"uk":{"stringUnit":{"state":"translated","value":"Зміни інструментів застосовуються до наступного запуску."}},"id":{"stringUnit":{"state":"translated","value":"Perubahan tool diterapkan pada proses berikutnya."}},"pl":{"stringUnit":{"state":"translated","value":"Zmiany narzędzi zostaną zastosowane przy następnym uruchomieniu."}},"th":{"stringUnit":{"state":"translated","value":"การเปลี่ยนแปลงเครื่องมือจะมีผลในการรันครั้งถัดไป"}},"vi":{"stringUnit":{"state":"translated","value":"Các thay đổi công cụ sẽ áp dụng cho lần chạy tiếp theo."}},"nl":{"stringUnit":{"state":"translated","value":"Toolwijzigingen worden toegepast bij de volgende run."}},"fa":{"stringUnit":{"