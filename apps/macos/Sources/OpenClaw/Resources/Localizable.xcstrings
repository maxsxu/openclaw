    "Show me what you can help with on this Mac right now.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Show me what you can help with on this Mac right now."}},"zh-CN":{"stringUnit":{"state":"translated","value":"告诉我你现在能在这台 Mac 上提供哪些帮助。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"告訴我你目前能在這台 Mac 上協助哪些事情。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Mostre como você pode ajudar neste Mac agora."}},"de":{"stringUnit":{"state":"translated","value":"Zeige mir, wobei du mir gerade auf diesem Mac helfen kannst."}},"es":{"stringUnit":{"state":"translated","value":"Muéstrame en qué puedes ayudarme ahora mismo en este Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"今このMacで何を手伝えるか教えてください。"}},"ko":{"stringUnit":{"state":"translated","value":"지금 이 Mac에서 어떤 도움을 줄 수 있는지 보여 주세요."}},"fr":{"stringUnit":{"state":"translated","value":"Montre-moi ce que tu peux faire pour m’aider sur ce Mac en ce moment."}},"hi":{"stringUnit":{"state":"translated","value":"मुझे दिखाएँ कि आप अभी इस Mac पर किन कामों में मदद कर सकते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"أرني ما يمكنك مساعدتي فيه على جهاز Mac هذا الآن."}},"it":{"stringUnit":{"state":"translated","value":"Mostrami in cosa puoi aiutarmi su questo Mac in questo momento."}},"tr":{"stringUnit":{"state":"translated","value":"Şu anda bu Mac'te neler konusunda yardımcı olabileceğini göster."}},"uk":{"stringUnit":{"state":"translated","value":"Покажи, із чим ти можеш допомогти на цьому Mac просто зараз."}},"id":{"stringUnit":{"state":"translated","value":"Tunjukkan hal yang dapat Anda bantu di Mac ini sekarang."}},"pl":{"stringUnit":{"state":"translated","value":"Pokaż mi, w czym możesz mi teraz pomóc na tym Macu."}},"th":{"stringUnit":{"state":"translated","value":"แสดงสิ่งที่คุณช่วยฉันทำบน Mac เครื่องนี้ได้ในตอนนี้"}},"vi":{"stringUnit":{"state":"translated","value":"Cho tôi biết bạn có thể hỗ trợ những gì trên máy Mac này ngay bây giờ."}},"nl":{"stringUnit":{"state"