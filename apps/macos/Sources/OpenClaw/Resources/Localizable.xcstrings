    "Verify OpenClaw can reach this gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Verify OpenClaw can reach this gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"验证 OpenClaw 是否可以访问此 gateway。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"驗證 OpenClaw 是否能連接到此 gateway。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verifique se o OpenClaw consegue acessar este gateway."}},"de":{"stringUnit":{"state":"translated","value":"Überprüfen Sie, ob OpenClaw dieses Gateway erreichen kann."}},"es":{"stringUnit":{"state":"translated","value":"Verifica que OpenClaw pueda conectarse a este gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw がこの Gateway に到達できることを確認します。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw가 이 게이트웨이에 연결할 수 있는지 확인합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Vérifiez qu'OpenClaw peut atteindre ce gateway."}},"hi":{"stringUnit":{"state":"translated","value":"सत्यापित करें कि OpenClaw इस gateway तक पहुँच सकता है।"}},"ar":{"stringUnit":{"state":"translated","value":"تحقق من قدرة OpenClaw على الوصول إلى هذا الـ gateway."}},"it":{"stringUnit":{"state":"translated","value":"Verifica che OpenClaw possa raggiungere questo gateway."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw'ın bu gateway'e ulaşabildiğini doğrulayın."}},"uk":{"stringUnit":{"state":"translated","value":"Переконайтеся, що OpenClaw може отримати доступ до цього gateway."}},"id":{"stringUnit":{"state":"translated","value":"Verifikasi OpenClaw dapat menjangkau gateway ini."}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdź, czy OpenClaw może połączyć się z tym gateway."}},"th":{"stringUnit":{"state":"translated","value":"ตรวจสอบว่า OpenClaw สามารถเข้าถึง gateway นี้ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Xác minh OpenClaw có thể kết nối tới gateway này."}},"nl":{"stringUnit":{"state":"translated","value":"Controleer of OpenClaw deze gateway kan bere