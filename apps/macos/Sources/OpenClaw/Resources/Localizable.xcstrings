    "Install and Relaunch": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Install and Relaunch"}},"zh-CN":{"stringUnit":{"state":"translated","value":"安装并重新启动"}},"zh-TW":{"stringUnit":{"state":"translated","value":"安裝並重新啟動"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Instalar e Reiniciar"}},"de":{"stringUnit":{"state":"translated","value":"Installieren und neu starten"}},"es":{"stringUnit":{"state":"translated","value":"Instalar y reiniciar"}},"ja-JP":{"stringUnit":{"state":"translated","value":"インストールして再起動"}},"ko":{"stringUnit":{"state":"translated","value":"설치 후 다시 시작"}},"fr":{"stringUnit":{"state":"translated","value":"Installer et relancer"}},"hi":{"stringUnit":{"state":"translated","value":"इंस्टॉल करें और फिर से लॉन्च करें"}},"ar":{"stringUnit":{"state":"translated","value":"تثبيت وإعادة التشغيل"}},"it":{"stringUnit":{"state":"translated","value":"Installa e riavvia"}},"tr":{"stringUnit":{"state":"translated","value":"Yükle ve Yeniden Başlat"}},"uk":{"stringUnit":{"state":"translated","value":"Встановити та перезапустити"}},"id":{"stringUnit":{"state":"translated","value":"Instal dan Luncurkan Ulang"}},"pl":{"stringUnit":{"state":"translated","value":"Zainstaluj i uruchom ponownie"}},"th":{"stringUnit":{"state":"translated","value":"ติดตั้งและเปิดใหม่"}},"vi":{"stringUnit":{"state":"translated","value":"Cài đặt và khởi chạy lại"}},"nl":{"stringUnit":{"state":"translated","value":"Installeren en opnieuw starten"}},"fa":{"stringUnit":{"state":"translated","value":"نصب و راه‌اندازی مجدد"}},"ru":{"stringUnit":{"state":"translated","value":"Установить и перезапустить"}},"sv":{"stringUnit":{"state":"translated","value":"Installera och starta om"}}}},
    "Install one of these tools, then check again. You can also connect a provider below.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Install one of these tools, then check again. You can also connect a provider below."}},"zh-CN":{"stringUnit":{"state":"translated","value":"安装以下任一工具，然后再次检查。你也可以连接下方的提供商。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"安裝其中一項工具，然後再次檢查。您也可以連接下方的供應商。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Instale uma destas ferramentas e verifique novamente. Você também pode conectar um provedor abaixo."}},"de":{"stringUnit":{"state":"translated","value":"Installiere eines dieser Tools und prüfe dann erneut. Du kannst unten auch einen Anbieter verbinden."}},"es":{"stringUnit":{"state":"translated","value":"Instala una de estas herramientas y, luego, vuelve a comprobarlo. También puedes conectar un proveedor a continuación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"これらのツールのいずれかをインストールしてから、もう一度確認してください。以下のプロバイダーに接続することもできます。"}},"ko":{"stringUnit":{"state":"translated","value":"다음 도구 중 하나를 설치한 다음 다시 확인하세요. 아래 제공업체를 연결할 수도 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Installez l’un de ces outils, puis vérifiez à nouveau. Vous pouvez également connecter un fournisseur ci-dessous."}},"hi":{"stringUnit":{"state":"translated","value":"इनमें से कोई एक टूल इंस्टॉल करें, फिर दोबारा जाँचें। आप नीचे किसी प्रदाता को भी कनेक्ट कर सकते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"ثبّت إحدى هذه الأدوات، ثم تحقّق مرة أخرى. يمكنك أيضًا ربط أحد المزوّدين أدناه."}},"it":{"stringUnit":{"state":"translated","value":"Installa uno di questi strumenti, quindi verifica di nuovo. Puoi anche connettere uno dei provider qui sotto."}},"tr":{"stringUnit":{"state":"translated","value":"Bu araçlardan birini yükleyin, ardından tekrar kontrol edin. Ayrıca aşağıdaki sağlayıcılardan birine bağlanabilirsiniz."}},"uk":{"stringUnit":{"state":"translated","value":"Установіть один із цих інструментів, а потім перевірте ще раз. Також нижче можна підключити постачальника."}},"id":{"stringUnit":{"state":"translated","value":"Instal salah satu alat ini, lalu periksa kembali. Anda juga dapat menghubungkan penyedia di bawah ini."}},"pl":{"stringUnit":{"state":"translated","value":"Zainstaluj jedno z tych narzędzi, a następnie sprawdź ponownie. Możesz też połączyć dostawcę poniżej."}},"th":{"stringUnit":{"state":"translated","value":"ติดตั้งหนึ่งในเครื่องมือเหล่านี้ แล้วตรวจสอบอีกครั้ง นอกจากนี้ คุณยังสามารถเชื่อมต่อผู้ให้บริการด้านล่างได้"}},"vi":{"stringUnit":{"state":"translated","value":"Cài đặt một trong các công cụ này, sau đó kiểm tra lại. Bạn cũng có thể kết nối với một nhà cung cấp bên dưới."}},"nl":{"stringUnit":{"state":"translated","value":"Installeer een van deze tools en controleer het daarna opnieuw. Je kunt hieronder ook een provider koppelen."}},"fa":{"stringUnit":{"state":"translated","value":"یکی از این ابزارها را نصب کنید، سپس دوباره بررسی کنید. همچنین می‌توانید یکی از ارائه‌دهندگان زیر را متصل کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Установите один из этих инструментов, затем повторите проверку. Также можно подключить провайдера ниже."}},"sv":{"stringUnit":{"state":"translated","value":"Installera ett av dessa verktyg och kontrollera sedan igen. Du kan också ansluta en leverantör nedan."}}}},
    "Installed: %@ · Required: %@": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Installed: %@ · Required: %@"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已安装：%@ · 需要：%@"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已安裝：%@ · 需要：%@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Instalado: %@ · Necessário: %@"}},"de":{"stringUnit":{"state":"translated","value":"Installiert: %@ · Erforderlich: %@"}},"es":{"stringUnit":{"state":"translated","value":"Instalado: %@ · Requerido: %@"}},"ja-JP":{"stringUnit":{"state":"translated","value":"インストール済み: %@ · 必要: %@"}},"ko":{"stringUnit":{"state":"translated","value":"설치됨: %@ · 필수: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Installé : %@ · Requis : %@"}},"hi":{"stringUnit":{"state":"translated","value":"इंस्टॉल किया गया: %@ · आवश्यक: %@"}},"ar":{"stringUnit":{"state":"translated","value":"المثبَّت: %@ · المطلوب: %@"}},"it":{"stringUnit":{"state":"translated","value":"Installato: %@ · Richiesto: %@"}},"tr":{"stringUnit":{"state":"translated","value":"Kurulu: %@ · Gerekli: %@"}},"uk":{"stringUnit":{"state":"translated","value":"Встановлено: %@ · Потрібно: %@"}},"id":{"stringUnit":{"state":"translated","value":"Terpasang: %@ · Diperlukan: %@"}},"pl":{"stringUnit":{"state":"translated","value":"Zainstalowano: %@ · Wymagane: %@"}},"th":{"stringUnit":{"state":"translated","value":"ติดตั้งแล้ว: %@ · จำเป็น: %@"}},"vi":{"stringUnit":{"state":"translated","value":"Đã cài đặt: %@ · Yêu cầu: %@"}},"nl":{"stringUnit":{"state":"translated","value":"Geïnstalleerd: %@ · Vereist: %@"}},"fa":{"stringUnit":{"state":"translated","value":"نصب‌شده: %@ · موردنیاز: %@"}},"ru":{"stringUnit":{"state":"translated","value":"Установлено: %@ · Требуется: %@"}},"sv":{"stringUnit":{"state":"translated","value":"Installerad: %@ · Krävs: %@"}}}},
    "It answers questions, works with your files and apps, and can chat with you on WhatsApp or Telegram. Setup takes about two minutes.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"It answers questions, works with your files and apps, and can chat with you on WhatsApp or Telegram. Setup takes about two minutes."}},"zh-CN":{"stringUnit":{"state":"translated","value":"它可以回答问题、处理你的文件和 app，还能在 WhatsApp 或 Telegram 上与你聊天。设置大约需要两分钟。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"它能回答問題、處理你的檔案和 App，並可透過 WhatsApp 或 Telegram 與你聊天。設定大約只需兩分鐘。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ele responde a perguntas, trabalha com seus arquivos e apps e pode conversar com você no WhatsApp ou Telegram. A configuração leva cerca de dois minutos."}},"de":{"stringUnit":{"state":"translated","value":"Er beantwortet Fragen, arbeitet mit Ihren Dateien und Apps und kann mit Ihnen über WhatsApp oder Telegram chatten. Die Einrichtung dauert etwa zwei Minuten."}},"es":{"stringUnit":{"state":"translated","value":"Responde preguntas, trabaja con tus archivos y apps, y puede chatear contigo en WhatsApp o Telegram. La configuración tarda unos dos minutos."}},"ja-JP":{"stringUnit":{"state":"translated","value":"質問に答え、ファイルやアプリを扱い、WhatsApp や Telegram であなたとチャットできます。セットアップは約 2 分で完了します。"}},"ko":{"stringUnit":{"state":"translated","value":"질문에 답하고, 파일과 앱을 다루며, WhatsApp 또는 Telegram에서 대화할 수 있습니다. 설정은 약 2분 정도 걸립니다."}},"fr":{"stringUnit":{"state":"translated","value":"Il répond aux questions, travaille avec vos fichiers et apps, et peut discuter avec vous sur WhatsApp ou Telegram. La configuration prend environ deux minutes."}},"hi":{"stringUnit":{"state":"translated","value":"यह सवालों के जवाब देता है, आपकी फ़ाइलों और ऐप्स के साथ काम करता है, और WhatsApp या Telegram पर आपसे चैट कर सकता है। सेटअप में लगभग दो मिनट लगते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"يجيب عن الأسئلة، ويعمل مع ملفاتك وتطبيقاتك، ويمكنه الدردشة معك على WhatsApp أو Telegram. يستغرق الإعداد حوالي دقيقتين."}},"it":{"stringUnit":{"state":"translated","value":"Risponde alle domande, lavora con i tuoi file e le tue app e può chattare con te su WhatsApp o Telegram. La configurazione richiede circa due minuti."}},"tr":{"stringUnit":{"state":"translated","value":"Soruları yanıtlar, dosyalarınız ve uygulamalarınızla çalışır ve WhatsApp veya Telegram üzerinden sizinle sohbet edebilir. Kurulum yaklaşık iki dakika sürer."}},"uk":{"stringUnit":{"state":"translated","value":"Він відповідає на запитання, працює з вашими файлами й застосунками та може спілкуватися з вами у WhatsApp або Telegram. Налаштування займає близько двох хвилин."}},"id":{"stringUnit":{"state":"translated","value":"Asisten ini menjawab pertanyaan, bekerja dengan file dan aplikasi Anda, dan dapat mengobrol dengan Anda di WhatsApp atau Telegram. Penyiapan memerlukan sekitar dua menit."}},"pl":{"stringUnit":{"state":"translated","value":"Odpowiada na pytania, pracuje z Twoimi plikami i aplikacjami oraz może rozmawiać z Tobą na WhatsApp lub Telegram. Konfiguracja zajmuje około dwóch minut."}},"th":{"stringUnit":{"state":"translated","value":"ตอบคำถาม ทำงานกับไฟล์และแอปของคุณ และแชทกับคุณบน WhatsApp หรือ Telegram ได้ การตั้งค่าใช้เวลาประมาณสองนาที"}},"vi":{"stringUnit":{"state":"translated","value":"Trợ lý trả lời câu hỏi, làm việc với tệp và ứng dụng của bạn, đồng thời có thể trò chuyện với bạn trên WhatsApp hoặc Telegram. Quá trình thiết lập mất khoảng hai phút."}},"nl":{"stringUnit":{"state":"translated","value":"Hij beantwoordt vragen, werkt met je bestanden en apps en kan met je chatten op WhatsApp of Telegram. De installatie duurt ongeveer twee minuten."}},"fa":{"stringUnit":{"state":"translated","value":"به پرسش‌ها پاسخ می‌دهد، با فایل‌ها و برنامه‌های شما کار می‌کند، و می‌تواند در WhatsApp یا Telegram با شما چت کند. راه‌اندازی حدود دو دقیقه طول می‌کشد."}},"ru":{"stringUnit":{"state":"translated","value":"Он отвечает на вопросы, работает с вашими файлами и приложениями и может общаться с вами в WhatsApp или Telegram. Настройка занимает около двух минут."}},"sv":{"stringUnit":{"state":"translated","value":"Den svarar på frågor, arbetar med dina filer och appar och kan chatta med dig på WhatsApp eller Telegram. Konfigurationen tar ungefär två minuter."}}}},
    "Item": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Item"}},"zh-CN":{"stringUnit":{"state":"translated","value":"项目"}},"zh-TW":{"stringUnit":{"state":"translated","value":"項目"}},"pt-BR":{"stringUnit":{"state":"new","value":"Item"}},"de":{"stringUnit":{"state":"translated","value":"Element"}},"es":{"stringUnit":{"state":"translated","value":"Elemento"}},"ja-JP":{"stringUnit":{"state":"translated","value":"項目"}},"ko":{"stringUnit":{"state":"translated","value":"항목"}},"fr":{"stringUnit":{"state":"translated","value":"Élément"}},"hi":{"stringUnit":{"state":"translated","value":"आइटम"}},"ar":{"stringUnit":{"state":"translated","value":"عنصر"}},"it":{"stringUnit":{"state":"translated","value":"Elemento"}},"tr":{"stringUnit":{"state":"translated","value":"Öğe"}},"uk":{"stringUnit":{"state":"translated","value":"Елемент"}},"id":{"stringUnit":{"state":"new","value":"Item"}},"pl":{"stringUnit":{"state":"translated","value":"Element"}},"th":{"stringUnit":{"state":"translated","value":"รายการ"}},"vi":{"stringUnit":{"state":"translated","value":"Mục"}},"nl":{"stringUnit":{"state":"new","value":"Item"}},"fa":{"stringUnit":{"state":"translated","value":"مورد"}},"ru":{"stringUnit":{"state":"translated","value":"Элемент"}},"sv":{"stringUnit":{"state":"translated","value":"Objekt"}}}},
    "Jump to latest reply": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Jump to latest reply"}},"zh-CN":{"stringUnit":{"state":"translated","value":"跳转到最新回复"}},"zh-TW":{"stringUnit":{"state":"translated","value":"跳至最新回覆"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ir para a resposta mais recente"}},"de":{"stringUnit":{"state":"translated","value":"Zur neuesten Antwort springen"}},"es":{"stringUnit":{"state":"translated","value":"Ir a la respuesta más reciente"}},"ja-JP":{"stringUnit":{"state":"translated","value":"最新の返信に移動"}},"ko":{"stringUnit":{"state":"translated","value":"최신 답글로 이동"}},"fr":{"stringUnit":{"state":"translated","value":"Aller à la réponse la plus récente"}},"hi":{"stringUnit":{"state":"translated","value":"नवीनतम उत्तर पर जाएँ"}},"ar":{"stringUnit":{"state":"translated","value":"الانتقال إلى أحدث رد"}},"it":{"stringUnit":{"state":"translated","value":"Vai all'ultima risposta"}},"tr":{"stringUnit":{"state":"translated","value":"En yeni yanıta atla"}},"uk":{"stringUnit":{"state":"translated","value":"Перейти до останньої відповіді"}},"id":{"stringUnit":{"state":"translated","value":"Lompat ke balasan terbaru"}},"pl":{"stringUnit":{"state":"translated","value":"Przejdź do najnowszej odpowiedzi"}},"th":{"stringUnit":{"state":"translated","value":"ข้ามไปยังการตอบกลับล่าสุด"}},"vi":{"stringUnit":{"state":"translated","value":"Chuyển đến phản hồi mới nhất"}},"nl":{"stringUnit":{"state":"translated","value":"Naar nieuwste antwoord springen"}},"fa":{"stringUnit":{"state":"translated","value":"پرش به آخرین پاسخ"}},"ru":{"stringUnit":{"state":"translated","value":"Перейти к последнему ответу"}},"sv":{"stringUnit":{"state":"translated","value":"Hoppa till senaste svar"}}}},
    "Keep my edits": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keep my edits"}},"zh-CN":{"stringUnit":{"state":"translated","value":"保留我的编辑"}},"zh-TW":{"stringUnit":{"state":"translated","value":"保留我的編輯"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Manter minhas edições"}},"de":{"stringUnit":{"state":"translated","value":"Meine Änderungen behalten"}},"es":{"stringUnit":{"state":"translated","value":"Conservar mis cambios"}},"ja-JP":{"stringUnit":{"state":"translated","value":"自分の編集内容を保持"}},"ko":{"stringUnit":{"state":"translated","value":"내 편집 유지"}},"fr":{"stringUnit":{"state":"translated","value":"Conserver mes modifications"}},"hi":{"stringUnit":{"state":"translated","value":"मेरे संपादन रखें"}},"ar":{"stringUnit":{"state":"translated","value":"الاحتفاظ بتعديلاتي"}},"it":{"stringUnit":{"state":"translated","value":"Mantieni le mie modifiche"}},"tr":{"stringUnit":{"state":"translated","value":"Düzenlemelerimi koru"}},"uk":{"stringUnit":{"state":"translated","value":"Зберегти мої зміни"}},"id":{"stringUnit":{"state":"translated","value":"Pertahankan editan saya"}},"pl":{"stringUnit":{"state":"translated","value":"Zachowaj moje zmiany"}},"th":{"stringUnit":{"state":"translated","value":"เก็บการแก้ไขของฉัน"}},"vi":{"stringUnit":{"state":"translated","value":"Giữ chỉnh sửa của tôi"}},"nl":{"stringUnit":{"state":"translated","value":"Mijn bewerkingen behouden"}},"fa":{"stringUnit":{"state":"translated","value":"حفظ ویرایش‌های من"}},"ru":{"stringUnit":{"state":"translated","value":"Сохранить мои изменения"}},"sv":{"stringUnit":{"state":"translated","value":"Behåll mina ändringar"}}}},
    "Keeps the last 400 lines and archives the old file.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Keeps the last 400 lines and archives the old file."}},"zh-CN":{"stringUnit":{"state":"translated","value":"保留最近 400 行并归档旧文件。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"保留最後 400 行並封存舊檔案。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Mantém as últimas 400 linhas e arquiva o arquivo antigo."}},"de":{"stringUnit":{"state":"translated","value":"Behält die letzten 400 Zeilen und archiviert die alte Datei."}},"es":{"stringUnit":{"state":"translated","value":"Conserva las últimas 400 líneas y archiva el archivo antiguo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"最後の400行を保持し、古いファイルをアーカイブします。"}},"ko":{"stringUnit":{"state":"translated","value":"마지막 400줄을 유지하고 이전 파일을 보관합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Conserve les 400 dernières lignes et archive l'ancien fichier."}},"hi":{"stringUnit":{"state":"translated","value":"अंतिम 400 पंक्तियों को रखता है और पुरानी फ़ाइल को संग्रहित करता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يحتفظ بآخر 400 سطر ويؤرشف الملف القديم."}},"it":{"stringUnit":{"state":"translated","value":"Mantiene le ultime 400 righe e archivia il vecchio file."}},"tr":{"stringUnit":{"state":"translated","value":"Son 400 satırı tutar ve eski dosyayı arşivler."}},"uk":{"stringUnit":{"state":"translated","value":"Зберігає останні 400 рядків і архівує старий файл."}},"id":{"stringUnit":{"state":"translated","value":"Menyimpan 400 baris terakhir dan mengarsipkan file lama."}},"pl":{"stringUnit":{"state":"translated","value":"Zachowuje ostatnie 400 wierszy i archiwizuje stary plik."}},"th":{"stringUnit":{"state":"translated","value":"เก็บ 400 บรรทัดล่าสุดและเก็บถาวรไฟล์เก่า"}},"vi":{"stringUnit":{"state":"translated","value":"Giữ lại 400 dòng cuối và lưu trữ tệp cũ."}},"nl":{"stringUnit":{"state":"translated","value":"Behoudt de laatste 400 regels en archiveert het oude bestan