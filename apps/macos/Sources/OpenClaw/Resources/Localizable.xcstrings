    "Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"zh-CN":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"zh-TW":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"pt-BR":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"de":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"es":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"ja-JP":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"ko":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"fr":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"hi":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"ar":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"it":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"tr":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"uk":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"id":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"pl":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"th":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"vi":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"nl":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"fa":{"stringUnit":{"state":"new","value":"Local automation clients can use the Peekaboo bridge to capture your screen and control apps on this Mac using OpenClaw's macOS permissions."}},"ru":{"stringUnit":{"state":"new","value":"Local automation clients can use