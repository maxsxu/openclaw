    "Pattern cannot be empty.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pattern cannot be empty."}},"zh-CN":{"stringUnit":{"state":"translated","value":"模式不能为空。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"模式不得為空。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O padrão não pode estar vazio."}},"de":{"stringUnit":{"state":"translated","value":"Muster darf nicht leer sein."}},"es":{"stringUnit":{"state":"translated","value":"El patrón no puede estar vacío."}},"ja-JP":{"stringUnit":{"state":"translated","value":"パターンは空にできません。"}},"ko":{"stringUnit":{"state":"translated","value":"패턴은 비워 둘 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le motif ne peut pas être vide."}},"hi":{"stringUnit":{"state":"translated","value":"पैटर्न खाली नहीं हो सकता।"}},"ar":{"stringUnit":{"state":"translated","value":"لا يمكن أن يكون النمط فارغًا."}},"it":{"stringUnit":{"state":"translated","value":"Il pattern non può essere vuoto."}},"tr":{"stringUnit":{"state":"translated","value":"Desen boş olamaz."}},"uk":{"stringUnit":{"state":"translated","value":"Шаблон не може бути порожнім."}},"id":{"stringUnit":{"state":"translated","value":"Pola tidak boleh kosong."}},"pl":{"stringUnit":{"state":"translated","value":"Wzorzec nie może być pusty."}},"th":{"stringUnit":{"state":"translated","value":"รูปแบบต้องไม่ว่างเปล่า"}},"vi":{"stringUnit":{"state":"translated","value":"Mẫu không được để trống."}},"nl":{"stringUnit":{"state":"translated","value":"Patroon mag niet leeg zijn."}},"fa":{"stringUnit":{"state":"translated","value":"الگو نمی‌تواند خالی باشد."}},"ru":{"stringUnit":{"state":"translated","value":"Шаблон не может быть пустым."}},"sv":{"stringUnit":{"state":"translated","value":"Mönstret får inte vara tomt."}}}},
