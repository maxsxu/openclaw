    "System browser profile import is disabled in the local Gateway configuration.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"System browser profile import is disabled in the local Gateway configuration."}},"zh-CN":{"stringUnit":{"state":"translated","value":"本地 Gateway 配置中已禁用系统浏览器配置文件导入。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"本機 Gateway 設定中已停用系統瀏覽器設定檔匯入。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A importação de perfil do navegador do sistema está desativada na configuração do Gateway local."}},"de":{"stringUnit":{"state":"translated","value":"Der Import von Systembrowser-Profilen ist in der lokalen Gateway-Konfiguration deaktiviert."}},"es":{"stringUnit":{"state":"translated","value":"La importación del perfil del navegador del sistema está deshabilitada en la configuración del Gateway local."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ローカル Gateway 設定でシステムブラウザプロファイルのインポートが無効になっています。"}},"ko":{"stringUnit":{"state":"translated","value":"로컬 Gateway 구성에서 시스템 브라우저 프로필 가져오기가 비활성화되어 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L'importation des profils du navigateur système est désactivée dans la configuration du Gateway local."}},"hi":{"stringUnit":{"state":"translated","value":"लोकल Gateway कॉन्फ़िगरेशन में सिस्टम ब्राउज़र प्रोफ़ाइल आयात अक्षम है।"}},"ar":{"stringUnit":{"state":"translated","value":"استيراد ملف تعريف متصفح النظام معطّل في إعدادات Gateway المحلي."}},"it":{"stringUnit":{"state":"translated","value":"L'importazione del profilo del browser di sistema è disabilitata nella configurazione locale del Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Sistem tarayıcısı profili içe aktarma yerel Gateway yapılandırmasında devre dışı."}},"uk":{"stringUnit":{"state":"translated","value":"Імпорт профілю системного браузера вимкнено в конфігурації локального Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Impor profil browser sistem dinonaktifkan dalam konfigurasi Gateway lokal."}},"pl":{"stringUnit":{"state":"translated","value":"Import profilu przeglądarki systemowej jest wyłączony w konfiguracji lokalnego Gateway."}},"th":{"stringUnit":{"state":"translated","value":"การนำเข้าโปรไฟล์เบราว์เซอร์ของระบบถูกปิดใช้งานในการกำหนดค่า Gateway ในเครื่อง"}},"vi":{"stringUnit":{"state":"translated","value":"Nhập hồ sơ trình duyệt hệ thống bị tắt trong cấu hình Gateway cục bộ."}},"nl":{"stringUnit":{"state":"translated","value":"Import van systeembrowserprofielen is uitgeschakeld in de lokale Gateway-configuratie."}},"fa":{"stringUnit":{"state":"translated","value":"درون‌ریزی نمایه مرورگر سیستم در پیکربندی Gateway محلی غیرفعال است."}},"ru":{"stringUnit":{"state":"translated","value":"Импорт профиля системного браузера отключён в конфигурации локального Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Import av systemets webbläsarprofil är inaktiverad i den lokala Gateway-konfigurationen."}}}},
