    "%lld of %lld cookies copied into “%@” — now the default profile for agent browsing.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"%lld of %lld cookies copied into “%@” — now the default profile for agent browsing."}},"zh-CN":{"stringUnit":{"state":"translated","value":"已将 %lld/%lld 个 cookie 复制到“%@”中 — 现已成为代理浏览的默认配置文件。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已將 %lld 個 cookie（共 %lld 個）複製到「%@」— 現在是代理瀏覽的預設設定檔。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"%lld de %lld cookies copiados para “%@” — agora o perfil padrão para navegação do agente."}},"de":{"stringUnit":{"state":"translated","value":"%lld von %lld Cookies in „%@“ kopiert – jetzt das Standardprofil für das Agent-Browsing."}},"es":{"stringUnit":{"state":"translated","value":"%lld de %lld cookies copiadas en «%@»: ahora es el perfil predeterminado para la navegación del agente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%lld / %lld 個のCookieを「%@」にコピーしました — これがエージェントブラウジングのデフォルトプロファイルになります。"}},"ko":{"stringUnit":{"state":"translated","value":"쿠키 %lld/%lld개를 “%@”에 복사했습니다 — 이제 에이전트 브라우징의 기본 프로필입니다."}},"fr":{"stringUnit":{"state":"translated","value":"%lld cookies sur %lld copiés dans « %@ » — désormais le profil par défaut pour la navigation de l’agent."}},"hi":{"stringUnit":{"state":"translated","value":"%lld में से %lld कुकीज़ “%@” में कॉपी की गईं — अब एजेंट ब्राउज़िंग के लिए डिफ़ॉल्ट प्रोफ़ाइल।"}},"ar":{"stringUnit":{"state":"translated","value":"تم نسخ %lld من %lld من ملفات تعريف الارتباط إلى “%@” — أصبح الآن الملف الافتراضي لتصفح الوكيل."}},"it":{"stringUnit":{"state":"translated","value":"%lld di %lld cookie copiati in “%@” — ora il profilo predefinito per la navigazione dell'agente."}},"tr":{"stringUnit":{"state":"translated","value":"%lld / %lld çerez “%@” içine kopyalandı — artık ajan taraması için varsayılan profil."}},"uk":{"stringUnit":{"state":"translated","value":"%lld з %lld файлів cookie скопійовано в «%@» — тепер це типовий профіль