    "Pause Talk mode before playing this attachment.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Pause Talk mode before playing this attachment."}},"zh-CN":{"stringUnit":{"state":"translated","value":"播放此附件前请先暂停 Talk 模式。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"播放此附件前請先暫停 Talk 模式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pause o modo Talk antes de reproduzir este anexo."}},"de":{"stringUnit":{"state":"translated","value":"Pausieren Sie den Talk-Modus, bevor Sie diesen Anhang abspielen."}},"es":{"stringUnit":{"state":"translated","value":"Pausa el modo Talk antes de reproducir este adjunto."}},"ja-JP":{"stringUnit":{"state":"translated","value":"この添付ファイルを再生する前にTalkモードを一時停止してください。"}},"ko":{"stringUnit":{"state":"translated","value":"이 첨부 파일을 재생하기 전에 Talk 모드를 일시정지하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Mettez le mode Talk en pause avant de lire cette pièce jointe."}},"hi":{"stringUnit":{"state":"translated","value":"इस अटैचमेंट को चलाने से पहले Talk मोड रोकें।"}},"ar":{"stringUnit":{"state":"translated","value":"أوقف وضع التحدث مؤقتًا قبل تشغيل هذا المرفق."}},"it":{"stringUnit":{"state":"translated","value":"Metti in pausa la modalità Talk prima di riprodurre questo allegato."}},"tr":{"stringUnit":{"state":"translated","value":"Bu eki oynatmadan önce Konuşma modunu duraklatın."}},"uk":{"stringUnit":{"state":"translated","value":"Призупиніть режим Talk перед відтворенням цього вкладення."}},"id":{"stringUnit":{"state":"translated","value":"Jeda mode Talk sebelum memutar lampiran ini."}},"pl":{"stringUnit":{"state":"translated","value":"Wstrzymaj tryb Talk przed odtworzeniem tego załącznika."}},"th":{"stringUnit":{"state":"translated","value":"หยุด Talk mode ชั่วคราวก่อนเล่นไฟล์แนบนี้"}},"vi":{"stringUnit":{"state":"translated","value":"Tạm dừng chế độ Talk trước khi phát tệp đính kèm này."}},"nl":{"stringUnit":{"state":"translated","value":"Pauzeer de Talk-modus voordat je deze bijlage afspeelt."}