    "Diagram options": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Diagram options"}},"zh-CN":{"stringUnit":{"state":"translated","value":"图表选项"}},"zh-TW":{"stringUnit":{"state":"translated","value":"圖表選項"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Opções do diagrama"}},"de":{"stringUnit":{"state":"translated","value":"Diagrammoptionen"}},"es":{"stringUnit":{"state":"translated","value":"Opciones del diagrama"}},"ja-JP":{"stringUnit":{"state":"translated","value":"図のオプション"}},"ko":{"stringUnit":{"state":"translated","value":"다이어그램 옵션"}},"fr":{"stringUnit":{"state":"translated","value":"Options du diagramme"}},"hi":{"stringUnit":{"state":"translated","value":"आरेख विकल्प"}},"ar":{"stringUnit":{"state":"translated","value":"خيارات المخطط"}},"it":{"stringUnit":{"state":"translated","value":"Opzioni diagramma"}},"tr":{"stringUnit":{"state":"translated","value":"Şema seçenekleri"}},"uk":{"stringUnit":{"state":"translated","value":"Параметри діаграми"}},"id":{"stringUnit":{"state":"translated","value":"Opsi diagram"}},"pl":{"stringUnit":{"state":"translated","value":"Opcje diagramu"}},"th":{"stringUnit":{"state":"translated","value":"ตัวเลือกไดอะแกรม"}},"vi":{"stringUnit":{"state":"translated","value":"Tùy chọn sơ đồ"}},"nl":{"stringUnit":{"state":"translated","value":"Diagramopties"}},"fa":{"stringUnit":{"state":"translated","value":"گزینه‌های نمودار"}},"ru":{"stringUnit":{"state":"translated","value":"Параметры диаграммы"}},"sv":{"stringUnit":{"state":"translated","value":"Diagramalternativ"}}}},
    "Diagram preview unavailable": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Diagram preview unavailable"}},"zh-CN":{"stringUnit":{"state":"translated","value":"图表预览不可用"}},"zh-TW":{"stringUnit":{"state":"translated","value":"圖表預覽無法使用"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Visualização do diagrama indisponível"}},"de":{"stringUnit":{"state":"translated","value":"Diagrammvorschau nicht verfügbar"}},"es":{"stringUnit":{"state":"translated","value":"Vista previa del diagrama no disponible"}},"ja-JP":{"stringUnit":{"state":"translated","value":"図のプレビューを利用できません"}},"ko":{"stringUnit":{"state":"translated","value":"다이어그램 미리보기를 사용할 수 없음"}},"fr":{"stringUnit":{"state":"translated","value":"Aperçu du diagramme indisponible"}},"hi":{"stringUnit":{"state":"translated","value":"आरेख पूर्वावलोकन उपलब्ध नहीं"}},"ar":{"stringUnit":{"state":"translated","value":"معاينة المخطط غير متوفرة"}},"it":{"stringUnit":{"state":"translated","value":"Anteprima diagramma non disponibile"}},"tr":{"stringUnit":{"state":"translated","value":"Şema önizlemesi kullanılamıyor"}},"uk":{"stringUnit":{"state":"translated","value":"Попередній перегляд діаграми недоступний"}},"id":{"stringUnit":{"state":"translated","value":"Pratinjau diagram tidak tersedia"}},"pl":{"stringUnit":{"state":"translated","value":"Podgląd diagramu niedostępny"}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถแสดงตัวอย่างไดอะแกรมได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không có bản xem trước sơ đồ"}},"nl":{"stringUnit":{"state":"translated","value":"Diagramvoorbeeld niet beschikbaar"}},"fa":{"stringUnit":{"state":"translated","value":"پیش‌نمایش نمودار در دسترس نیست"}},"ru":{"stringUnit":{"state":"translated","value":"Предпросмотр диаграммы недоступен"}},"sv":{"stringUnit":{"state":"translated","value":"Förhandsvisning av diagram är inte tillgänglig"}}}},
    "Diagram temporarily unavailable. Use the menu to retry, or read and copy its source.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Diagram temporarily unavailable. Use the menu to retry, or read and copy its source."}},"zh-CN":{"stringUnit":{"state":"translated","value":"图表暂时不可用。使用菜单重试，或阅读并复制其源代码。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"圖表暫時無法使用。使用選單重試，或閱讀並複製其原始碼。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Diagrama temporariamente indisponível. Use o menu para tentar novamente ou leia e copie seu código-fonte."}},"de":{"stringUnit":{"state":"translated","value":"Diagramm vorübergehend nicht verfügbar. Verwende das Menü für einen erneuten Versuch oder lies und kopiere dessen Quelle."}},"es":{"stringUnit":{"state":"translated","value":"Diagrama temporalmente no disponible. Usa el menú para reintentar, o lee y copia su código fuente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"図を一時的に利用できません。メニューから再試行するか、ソースを読み取ってコピーしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"다이어그램을 일시적으로 사용할 수 없습니다. 메뉴에서 다시 시도하거나 소스를 읽고 복사하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Diagramme temporairement indisponible. Utilisez le menu pour réessayer, ou lisez et copiez sa source."}},"hi":{"stringUnit":{"state":"translated","value":"आरेख अस्थायी रूप से उपलब्ध नहीं है। पुनः प्रयास करने के लिए मेनू का उपयोग करें, या इसके स्रोत को पढ़ें और कॉपी करें।"}},"ar":{"stringUnit":{"state":"translated","value":"المخطط غير متوفر مؤقتًا. استخدم القائمة لإعادة المحاولة، أو اقرأ مصدره وانسخه."}},"it":{"stringUnit":{"state":"translated","value":"Diagramma temporaneamente non disponibile. Usa il menu per riprovare, oppure leggi e copia la sua sorgente."}},"tr":{"stringUnit":{"state":"translated","value":"Şema geçici olarak kullanılamıyor. Yeniden denemek için menüyü kullanın ya da kaynağını okuyup kopyalayın."}},"uk":{"stringUnit":{"state":"translated","value":"Діаграма тимчасово недоступна. Скористайтеся меню, щоб повторити спробу, або прочитайте та скопіюйте її джерело."}},"id":{"stringUnit":{"state":"translated","value":"Diagram sementara tidak tersedia. Gunakan menu untuk mencoba lagi, atau baca dan salin sumbernya."}},"pl":{"stringUnit":{"state":"translated","value":"Diagram tymczasowo niedostępny. Użyj menu, aby spróbować ponownie, albo przeczytaj i skopiuj jego źródło."}},"th":{"stringUnit":{"state":"translated","value":"ไดอะแกรมไม่พร้อมใช้งานชั่วคราว ใช้เมนูเพื่อลองใหม่ หรืออ่านและคัดลอกซอร์สของมัน"}},"vi":{"stringUnit":{"state":"translated","value":"Sơ đồ tạm thời không khả dụng. Dùng menu để thử lại, hoặc đọc và sao chép nguồn của nó."}},"nl":{"stringUnit":{"state":"translated","value":"Diagram tijdelijk niet beschikbaar. Gebruik het menu om opnieuw te proberen, of lees en kopieer de bron."}},"fa":{"stringUnit":{"state":"translated","value":"نمودار موقتاً در دسترس نیست. از منو برای تلاش مجدد استفاده کنید، یا منبع آن را بخوانید و کپی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Диаграмма временно недоступна. Используйте меню, чтобы повторить попытку, или прочитайте и скопируйте её исходник."}},"sv":{"stringUnit":{"state":"translated","value":"Diagrammet är tillfälligt otillgängligt. Använd menyn för att försöka igen, eller läs och kopiera dess källa."}}}},
    "Diagram unavailable. Check the syntax or simplify the diagram. You can still read or copy its source.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Diagram unavailable. Check the syntax or simplify the diagram. You can still read or copy its source."}},"zh-CN":{"stringUnit":{"state":"translated","value":"图表不可用。请检查语法或简化图表。你仍可阅读或复制其源代码。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"圖表無法使用。請檢查語法或簡化圖表。您仍可閱讀或複製其原始碼。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Diagrama indisponível. Verifique a sintaxe ou simplifique o diagrama. Você ainda pode ler ou copiar seu código-fonte."}},"de":{"stringUnit":{"state":"translated","value":"Diagramm nicht verfügbar. Überprüfe die Syntax oder vereinfache das Diagramm. Du kannst dessen Quelle weiterhin lesen oder kopieren."}},"es":{"stringUnit":{"state":"translated","value":"Diagrama no disponible. Comprueba la sintaxis o simplifica el diagrama. Aún puedes leer o copiar su código fuente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"図を利用できません。構文を確認するか、図を簡素化してください。ソースの読み取りやコピーは引き続き可能です。"}},"ko":{"stringUnit":{"state":"translated","value":"다이어그램을 사용할 수 없습니다. 구문을 확인하거나 다이어그램을 단순화하세요. 소스는 여전히 읽거나 복사할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Diagramme indisponible. Vérifiez la syntaxe ou simplifiez le diagramme. Vous pouvez toujours lire ou copier sa source."}},"hi":{"stringUnit":{"state":"translated","value":"आरेख उपलब्ध नहीं है। सिंटैक्स जाँचें या आरेख को सरल बनाएँ। आप अभी भी इसके स्रोत को पढ़ या कॉपी कर सकते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"المخطط غير متوفر. تحقق من بناء الجملة أو بسّط المخطط. لا يزال بإمكانك قراءة مصدره أو نسخه."}},"it":{"stringUnit":{"state":"translated","value":"Diagramma non disponibile. Controlla la sintassi o semplifica il diagramma. Puoi comunque leggere o copiare la sua sorgente."}},"tr":{"stringUnit":{"state":"translated","value":"Şema kullanılamıyor. Söz dizimini kontrol edin veya şemayı basitleştirin. Kaynağını yine de okuyabilir veya kopyalayabilirsiniz."}},"uk":{"stringUnit":{"state":"translated","value":"Діаграма недоступна. Перевірте синтаксис або спростіть діаграму. Ви все ще можете прочитати або скопіювати її джерело."}},"id":{"stringUnit":{"state":"translated","value":"Diagram tidak tersedia. Periksa sintaks atau sederhanakan diagram. Anda masih dapat membaca atau menyalin sumbernya."}},"pl":{"stringUnit":{"state":"translated","value":"Diagram niedostępny. Sprawdź składnię lub uprość diagram. Nadal możesz przeczytać lub skopiować jego źródło."}},"th":{"stringUnit":{"state":"translated","value":"ไดอะแกรมไม่พร้อมใช้งาน ตรวจสอบไวยากรณ์หรือลดความซับซ้อนของไดอะแกรม คุณยังคงอ่านหรือคัดลอกซอร์สได้"}},"vi":{"stringUnit":{"state":"translated","value":"Sơ đồ không khả dụng. Kiểm tra cú pháp hoặc đơn giản hóa sơ đồ. Bạn vẫn có thể đọc hoặc sao chép nguồn của nó."}},"nl":{"stringUnit":{"state":"translated","value":"Diagram niet beschikbaar. Controleer de syntaxis of vereenvoudig het diagram. Je kunt nog steeds de bron lezen of kopiëren."}},"fa":{"stringUnit":{"state":"translated","value":"نمودار در دسترس نیست. نحو را بررسی کنید یا نمودار را ساده‌تر کنید. همچنان می‌توانید منبع آن را بخوانید یا کپی کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Диаграмма недоступна. Проверьте синтаксис или упростите диаграмму. Вы всё ещё можете прочитать или скопировать её исходник."}},"sv":{"stringUnit":{"state":"translated","value":"Diagrammet är inte tillgängligt. Kontrollera syntaxen eller förenkla diagrammet. Du kan fortfarande läsa eller kopiera dess källa."}}}},
    "Dictate message": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Dictate message"}},"zh-CN":{"stringUnit":{"state":"translated","value":"语音输入消息"}},"zh-TW":{"stringUnit":{"state":"translated","value":"語音輸入訊息"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ditar mensagem"}},"de":{"stringUnit":{"state":"translated","value":"Nachricht diktieren"}},"es":{"stringUnit":{"state":"translated","value":"Dictar mensaje"}},"ja-JP":{"stringUnit":{"state":"translated","value":"メッセージを音声入力"}},"ko":{"stringUnit":{"state":"translated","value":"메시지 받아쓰기"}},"fr":{"stringUnit":{"state":"translated","value":"Dicter le message"}},"hi":{"stringUnit":{"state":"translated","value":"संदेश बोलकर लिखें"}},"ar":{"stringUnit":{"state":"translated","value":"إملاء الرسالة"}},"it":{"stringUnit":{"state":"translated","value":"Detta messaggio"}},"tr":{"stringUnit":{"state":"translated","value":"Mesajı dikte et"}},"uk":{"stringUnit":{"state":"translated","value":"Продиктувати повідомлення"}},"id":{"stringUnit":{"state":"translated","value":"Dikte pesan"}},"pl":{"stringUnit":{"state":"translated","value":"Dyktuj wiadomość"}},"th":{"stringUnit":{"state":"translated","value":"พูดป้อนข้อความ"}},"vi":{"stringUnit":{"state":"translated","value":"Đọc để nhập tin nhắn"}},"nl":{"stringUnit":{"state":"translated","value":"Bericht dicteren"}},"fa":{"stringUnit":{"state":"translated","value":"دیکته کردن پیام"}},"ru":{"stringUnit":{"state":"translated","value":"Продиктовать сообщение"}},"sv":{"stringUnit":{"state":"translated","value":"Diktera meddelande"}}}},
    "Dictation stopped because speech recognition failed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Dictation stopped because speech recognition failed."}},"zh-CN":{"stringUnit":{"state":"translated","value":"由于语音识别失败，听写已停止。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"因語音辨識失敗，聽寫已停止。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O ditado foi interrompido porque o reconhecimento de fala falhou."}},"de":{"stringUnit":{"state":"translated","value":"Das Diktat wurde beendet, weil die Spracherkennung fehlgeschlagen ist."}},"es":{"stringUnit":{"state":"translated","value":"El dictado se detuvo porque falló el reconocimiento de voz."}},"ja-JP":{"stringUnit":{"state":"translated","value":"音声認識に失敗したため、音声入力を停止しました。"}},"ko":{"stringUnit":{"state":"translated","value":"음성 인식에 실패하여 받아쓰기가 중지되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La dictée s’est arrêtée en raison de l’échec de la reconnaissance vocale."}},"hi":{"stringUnit":{"state":"translated","value":"वाक् पहचान विफल होने के कारण डिक्टेशन रुक गया।"}},"ar":{"stringUnit":{"state":"translated","value":"توقف الإملاء بسبب فشل التعرّف على الكلام."}},"it":{"stringUnit":{"state":"translated","value":"La dettatura è stata interrotta perché il riconoscimento vocale non è riuscito."}},"tr":{"stringUnit":{"state":"translated","value":"Konuşma tanıma başarısız olduğu için dikte durduruldu."}},"uk":{"stringUnit":{"state":"translated","value":"Диктування зупинено через помилку розпізнавання мовлення."}},"id":{"stringUnit":{"state":"translated","value":"Dikte dihentikan karena pengenalan ucapan gagal."}},"pl":{"stringUnit":{"state":"translated","value":"Dyktowanie zostało zatrzymane, ponieważ rozpoznawanie mowy nie powiodło się."}},"th":{"stringUnit":{"state":"translated","value":"การป้อนตามคำบอกหยุดลงเนื่องจากการรู้จำเสียงพูดล้มเหลว"}},"vi":{"stringUnit":{"state":"translated","value":"Đã dừng đọc chính tả vì nhận dạng giọng nói không thành công."}},"nl":{"stringUnit":{"stat