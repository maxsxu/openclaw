    "Session settings changed. Review and retry this message.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Session settings changed. Review and retry this message."}},"zh-CN":{"stringUnit":{"state":"translated","value":"会话设置已更改。请检查并重试此消息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"工作階段設定已變更。請檢查並重試此訊息。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As configurações da sessão foram alteradas. Revise e tente enviar esta mensagem novamente."}},"de":{"stringUnit":{"state":"translated","value":"Sitzungseinstellungen geändert. Überprüfen Sie diese Nachricht und versuchen Sie es erneut."}},"es":{"stringUnit":{"state":"translated","value":"La configuración de la sesión cambió. Revisa y reintenta este mensaje."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セッション設定が変更されました。このメッセージを確認して再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"세션 설정이 변경되었습니다. 이 메시지를 검토하고 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Les paramètres de session ont changé. Vérifiez et réessayez ce message."}},"hi":{"stringUnit":{"state":"translated","value":"सत्र सेटिंग्स बदल गई हैं. इस संदेश की समीक्षा करें और पुनः प्रयास करें."}},"ar":{"stringUnit":{"state":"translated","value":"تغيّرت إعدادات الجلسة. راجع هذه الرسالة وأعد المحاولة."}},"it":{"stringUnit":{"state":"translated","value":"Le impostazioni della sessione sono cambiate. Rivedi e riprova questo messaggio."}},"tr":{"stringUnit":{"state":"translated","value":"Oturum ayarları değişti. Bu mesajı gözden geçirip yeniden deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Налаштування сеансу змінено. Перегляньте та повторіть це повідомлення."}},"id":{"stringUnit":{"state":"translated","value":"Pengaturan sesi berubah. Tinjau dan coba lagi pesan ini."}},"pl":{"stringUnit":{"state":"translated","value":"Zmieniono ustawienia sesji. Sprawdź i ponów tę wiadomość."}},"th":{"stringUnit":{"state":"translated","value":"การตั้งค่าเซสชันเปลี่ยนแปลง ตรวจสอบและลองส่งข้อความนี้อีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Cài đặt phiên đã thay đổi. Xem lại và thử lại tin nhắn này."}},"nl":{"stringUnit":{"state":"translated","value":"Sessie-instellingen gewijzigd. Controleer dit bericht en probeer opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"تنظیمات نشست تغییر کرد. این پیام را بررسی و دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Настройки сессии изменены. Проверьте и повторите это сообщение."}},"sv":{"stringUnit":{"state":"translated","value":"Sessionsinställningarna ändrades. Granska och försök skicka detta meddelande igen."}}}},
    "Session settings were not captured. Review and retry this message.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Session settings were not captured. Review and retry this message."}},"zh-CN":{"stringUnit":{"state":"translated","value":"未捕获会话设置。请检查并重试此消息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"未擷取到工作階段設定。請檢查並重試此訊息。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As configurações da sessão não foram capturadas. Revise e tente enviar esta mensagem novamente."}},"de":{"stringUnit":{"state":"translated","value":"Sitzungseinstellungen wurden nicht erfasst. Überprüfen Sie diese Nachricht und versuchen Sie es erneut."}},"es":{"stringUnit":{"state":"translated","value":"No se capturó la configuración de la sesión. Revisa y reintenta este mensaje."}},"ja-JP":{"stringUnit":{"state":"translated","value":"セッション設定が取得されませんでした。このメッセージを確認して再試行してください。"}},"ko":{"stringUnit":{"state":"translated","value":"세션 설정이 캡처되지 않았습니다. 이 메시지를 검토하고 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Les paramètres de session n'ont pas été capturés. Vérifiez et réessayez ce message."}},"hi":{"stringUnit":{"state":"translated","value":"सत्र सेटिंग्स कैप्चर नहीं की गईं. इस संदेश की समीक्षा करें और पुनः प्रयास करें."}},"ar":{"stringUnit":{"state":"translated","value":"لم يتم التقاط إعدادات الجلسة. راجع هذه الرسالة وأعد المحاولة."}},"it":{"stringUnit":{"state":"translated","value":"Le impostazioni della sessione non sono state acquisite. Rivedi e riprova questo messaggio."}},"tr":{"stringUnit":{"state":"translated","value":"Oturum ayarları yakalanmadı. Bu mesajı gözden geçirip yeniden deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Налаштування сеансу не захоплено. Перегляньте та повторіть це повідомлення."}},"id":{"stringUnit":{"state":"translated","value":"Pengaturan sesi tidak tertangkap. Tinjau dan coba lagi pesan ini."}},"pl":{"stringUnit":{"state":"translated","value":"Nie zarejestrowano ustawień sesji. Sprawdź i ponów tę wiadomość."}},"th":{"stringUnit":{"state":"translated","value":"ไม่ได้บันทึกการตั้งค่าเซสชัน ตรวจสอบและลองส่งข้อความนี้อีกครั้ง"}},"vi":{"stringUnit":{"state":"translated","value":"Không ghi được cài đặt phiên. Xem lại và thử lại tin nhắn này."}},"nl":{"stringUnit":{"state":"translated","value":"Sessie-instellingen zijn niet vastgelegd. Controleer dit bericht en probeer opnieuw."}},"fa":{"stringUnit":{"state":"translated","value":"تنظیمات نشست ثبت نشد. این پیام را بررسی و دوباره تلاش کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Настройки сессии не были зафиксированы. Проверьте и повторите это сообщение."}},"sv":{"stringUnit":{"state":"translated","value":"Sessionsinställningarna registrerades inte. Granska och försök skicka detta meddelande igen."}}}},
