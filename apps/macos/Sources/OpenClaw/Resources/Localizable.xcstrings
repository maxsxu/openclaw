    "Runs quietly and starts again after a restart.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Runs quietly and starts again after a restart."}},"zh-CN":{"stringUnit":{"state":"translated","value":"静默运行，并会在重启后再次启动。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"會安靜執行，並在重新啟動後再次啟動。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Roda discretamente e inicia novamente após uma reinicialização."}},"de":{"stringUnit":{"state":"translated","value":"Läuft unauffällig und startet nach einem Neustart wieder."}},"es":{"stringUnit":{"state":"translated","value":"Se ejecuta discretamente y vuelve a iniciarse después de un reinicio."}},"ja-JP":{"stringUnit":{"state":"translated","value":"静かに実行され、再起動後も再度開始します。"}},"ko":{"stringUnit":{"state":"translated","value":"조용히 실행되며 재시작 후에도 다시 시작됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"S’exécute discrètement et redémarre après un redémarrage."}},"hi":{"stringUnit":{"state":"translated","value":"चुपचाप चलता है और restart के बाद फिर से शुरू हो जाता है।"}},"ar":{"stringUnit":{"state":"translated","value":"تعمل بهدوء وتبدأ مرة أخرى بعد إعادة التشغيل."}},"it":{"stringUnit":{"state":"translated","value":"Funziona in modo discreto e si riavvia dopo un riavvio."}},"tr":{"stringUnit":{"state":"translated","value":"Sessizce çalışır ve yeniden başlatmadan sonra tekrar başlar."}},"uk":{"stringUnit":{"state":"translated","value":"Працює непомітно й запускається знову після перезапуску."}},"id":{"stringUnit":{"state":"translated","value":"Berjalan senyap dan mulai lagi setelah dimulai ulang."}},"pl":{"stringUnit":{"state":"translated","value":"Działa dyskretnie i uruchamia się ponownie po restarcie."}},"th":{"stringUnit":{"state":"translated","value":"ทำงานอย่างเงียบ ๆ และเริ่มอีกครั้งหลังรีสตาร์ท"}},"vi":{"stringUnit":{"state":"translated","value":"Chạy âm thầm và tự khởi động lại sau khi khởi động lại máy."}},"nl":{"stringUnit":{"state":"translated","value":"Draait stil op de achtergrond en start opnieuw na een herstart."}},"fa":{"stringUnit":{"state":"translated","value":"بی‌سروصدا اجرا می‌شود و پس از راه‌اندازی مجدد دوباره شروع می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Работает незаметно и запускается снова после перезагрузки."}},"sv":{"stringUnit":{"state":"translated","value":"Kör tyst och startar igen efter en omstart."}}}},
