    "OpenClaw Gateway %@ is installed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ is installed."}},"zh-CN":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ 已安装。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ 已安裝。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ está instalado."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ ist installiert."}},"es":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ está instalado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ がインストールされました。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@이(가) 설치되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ est installé."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ इंस्टॉल किया गया है।"}},"ar":{"stringUnit":{"state":"translated","value":"تم تثبيت OpenClaw Gateway %@."}},"it":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ è installato."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ kuruldu."}},"uk":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ встановлено."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ terpasang."}},"pl":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ jest zainstalowany."}},"th":{"stringUnit":{"state":"translated","value":"ติดตั้ง OpenClaw Gateway %@ แล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ đã được cài đặt."}},"nl":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ is geïnstalleerd."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ نصب شد."}},"ru":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ установлен."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway %@ är installerad."}}}},
