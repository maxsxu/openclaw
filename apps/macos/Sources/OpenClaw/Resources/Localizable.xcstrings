    "Tool overrides will be cleared for the next run.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Tool overrides will be cleared for the next run."}},"zh-CN":{"stringUnit":{"state":"translated","value":"工具覆盖将在下次运行时被清除。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"工具覆寫將於下次執行時清除。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As substituições de ferramentas serão limpas na próxima execução."}},"de":{"stringUnit":{"state":"translated","value":"Tool-Überschreibungen werden für den nächsten Durchlauf gelöscht."}},"es":{"stringUnit":{"state":"translated","value":"Las anulaciones de herramientas se borrarán para la próxima ejecución."}},"ja-JP":{"stringUnit":{"state":"translated","value":"次回の実行でツールのオーバーライドがクリアされます。"}},"ko":{"stringUnit":{"state":"translated","value":"다음 실행에서 도구 재정의가 지워집니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les remplacements d'outils seront effacés pour la prochaine exécution."}},"hi":{"stringUnit":{"state":"translated","value":"Tool ओवरराइड अगले रन के लिए साफ़ कर दिए जाएंगे।"}},"ar":{"stringUnit":{"state":"translated","value":"ستُمسح تجاوزات الأدوات في التشغيل التالي."}},"it":{"stringUnit":{"state":"translated","value":"Le sostituzioni degli strumenti verranno cancellate per l'esecuzione successiva."}},"tr":{"stringUnit":{"state":"translated","value":"Araç geçersiz kılmaları bir sonraki çalıştırma için temizlenecek."}},"uk":{"stringUnit":{"state":"translated","value":"Перевизначення інструментів буде очищено для наступного запуску."}},"id":{"stringUnit":{"state":"translated","value":"Penggantian tool akan dihapus untuk proses berikutnya."}},"pl":{"stringUnit":{"state":"translated","value":"Zastąpienia narzędzi zostaną wyczyszczone przy następnym uruchomieniu."}},"th":{"stringUnit":{"state":"translated","value":"การแทนที่เครื่องมือจะถูกล้างสำหรับการรันครั้งถัดไป"}},"vi":{"stringUnit":{"state":"translated","value":"Các ghi đè công cụ sẽ bị xóa cho lần chạy tiếp theo."}},"nl":{"stringUnit":{"sta