    "Open the compact chat panel; the agent can show previews and richer visuals in Canvas.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open the compact chat panel; the agent can show previews and richer visuals in Canvas."}},"zh-CN":{"stringUnit":{"state":"translated","value":"打开紧凑型聊天面板；智能体可在 Canvas 中显示预览和更丰富的视觉内容。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開啟精簡聊天面板；代理程式可在 Canvas 中顯示預覽和更豐富的視覺內容。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abra o painel de chat compacto; o agente pode mostrar prévias e elementos visuais mais elaborados no Canvas."}},"de":{"stringUnit":{"state":"translated","value":"Öffne das kompakte Chatfenster; der Agent kann Vorschauen und umfangreichere visuelle Inhalte in Canvas anzeigen."}},"es":{"stringUnit":{"state":"translated","value":"Abre el panel de chat compacto; el agente puede mostrar vistas previas y contenido visual más completo en Canvas."}},"ja-JP":{"stringUnit":{"state":"translated","value":"コンパクトなチャットパネルを開きます。エージェントはCanvasでプレビューやよりリッチなビジュアルを表示できます。"}},"ko":{"stringUnit":{"state":"translated","value":"간결한 채팅 패널을 엽니다. 에이전트가 Canvas에서 미리보기와 더 풍부한 시각 자료를 표시할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrez le panneau de discussion compact ; l’agent peut afficher des aperçus et des visuels plus riches dans Canvas."}},"hi":{"stringUnit":{"state":"translated","value":"कॉम्पैक्ट चैट पैनल खोलें; एजेंट Canvas में पूर्वावलोकन और अधिक समृद्ध विज़ुअल दिखा सकता है।"}},"ar":{"stringUnit":{"state":"translated","value":"افتح لوحة الدردشة المصغّرة؛ يمكن للوكيل عرض معاينات ومرئيات أكثر ثراءً في Canvas."}},"it":{"stringUnit":{"state":"translated","value":"Apri il pannello chat compatto; l'agente può mostrare anteprime e contenuti visivi più dettagliati in Canvas."}},"tr":{"stringUnit":{"state":"translated","value":"Kompakt sohbet panelini açın; temsilci, Canvas'ta önizlemeler ve daha zengin görseller gösterebilir."}},"uk":{"stringUnit":{"state":"translated","value":"Відкрийте компактну панель чату; агент може показувати попередні перегляди та розширені візуальні матеріали в Canvas."}},"id":{"stringUnit":{"state":"translated","value":"Buka panel obrolan ringkas; agen dapat menampilkan pratinjau dan visual yang lebih kaya di Canvas."}},"pl":{"stringUnit":{"state":"translated","value":"Otwórz kompaktowy panel czatu; agent może wyświetlać podglądy i bogatsze wizualizacje w Canvas."}},"th":{"stringUnit":{"state":"translated","value":"เปิดแผงแชตขนาดกะทัดรัด โดยเอเจนต์สามารถแสดงตัวอย่างและภาพที่มีรายละเอียดมากขึ้นใน Canvas"}},"vi":{"stringUnit":{"state":"translated","value":"Mở bảng trò chuyện thu gọn; tác tử có thể hiển thị bản xem trước và nội dung trực quan phong phú hơn trong Canvas."}},"nl":{"stringUnit":{"state":"translated","value":"Open het compacte chatpaneel; de agent kan voorvertoningen en rijkere visuele elementen in Canvas weergeven."}},"fa":{"stringUnit":{"state":"translated","value":"پنل فشرده گفت‌وگو را باز کنید؛ عامل می‌تواند پیش‌نمایش‌ها و جلوه‌های بصری غنی‌تری را در Canvas نمایش دهد."}},"ru":{"stringUnit":{"state":"translated","value":"Откройте компактную панель чата; агент может показывать предпросмотры и более наглядные материалы в Canvas."}},"sv":{"stringUnit":{"state":"translated","value":"Öppna den kompakta chattpanelen. Agenten kan visa förhandsvisningar och mer avancerad grafik i Canvas."}}}},
    "Open the menu bar panel": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Open the menu bar panel"}},"zh-CN":{"stringUnit":{"state":"translated","value":"打开菜单栏面板"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開啟選單列面板"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Abrir o painel da barra de menus"}},"de":{"stringUnit":{"state":"translated","value":"Menüleisten-Panel öffnen"}},"es":{"stringUnit":{"state":"translated","value":"Abrir el panel de la barra de menús"}},"ja-JP":{"stringUnit":{"state":"translated","value":"メニューバーパネルを開く"}},"ko":{"stringUnit":{"state":"translated","value":"메뉴 막대 패널 열기"}},"fr":{"stringUnit":{"state":"translated","value":"Ouvrir le panneau de la barre des menus"}},"hi":{"stringUnit":{"state":"translated","value":"मेनू बार पैनल खोलें"}},"ar":{"stringUnit":{"state":"translated","value":"فتح لوحة شريط القوائم"}},"it":{"stringUnit":{"state":"translated","value":"Apri il pannello della barra dei menu"}},"tr":{"stringUnit":{"state":"translated","value":"Menü çubuğu panelini aç"}},"uk":{"stringUnit":{"state":"translated","value":"Відкрити панель у рядку меню"}},"id":{"stringUnit":{"state":"translated","value":"Buka panel bilah menu"}},"pl":{"stringUnit":{"state":"translated","value":"Otwórz panel paska menu"}},"th":{"stringUnit":{"state":"translated","value":"เปิดแผงแถบเมนู"}},"vi":{"stringUnit":{"state":"translated","value":"Mở bảng trên thanh menu"}},"nl":{"stringUnit":{"state":"translated","value":"Open het menubalkpaneel"}},"fa":{"stringUnit":{"state":"translated","value":"باز کردن پنل نوار منو"}},"ru":{"stringUnit":{"state":"translated","value":"Откройте панель в строке меню"}},"sv":{"stringUnit":{"state":"translated","value":"Öppna menyfältspanelen"}}}},
