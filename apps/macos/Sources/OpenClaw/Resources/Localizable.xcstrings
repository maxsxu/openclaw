    "A device wants to connect to OpenClaw.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"A device wants to connect to OpenClaw."}},"zh-CN":{"stringUnit":{"state":"translated","value":"有设备想要连接到 OpenClaw。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"有裝置想要連線至 OpenClaw。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Um dispositivo quer se conectar ao OpenClaw."}},"de":{"stringUnit":{"state":"translated","value":"Ein Gerät möchte sich mit OpenClaw verbinden."}},"es":{"stringUnit":{"state":"translated","value":"Un dispositivo quiere conectarse a OpenClaw."}},"ja-JP":{"stringUnit":{"state":"translated","value":"デバイスが OpenClaw への接続を要求しています。"}},"ko":{"stringUnit":{"state":"translated","value":"장치가 OpenClaw에 연결하려고 합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Un appareil souhaite se connecter à OpenClaw."}},"hi":{"stringUnit":{"state":"translated","value":"एक डिवाइस OpenClaw से कनेक्ट करना चाहता है।"}},"ar":{"stringUnit":{"state":"translated","value":"جهاز يريد الاتصال بـ OpenClaw."}},"it":{"stringUnit":{"state":"translated","value":"Un dispositivo vuole connettersi a OpenClaw."}},"tr":{"stringUnit":{"state":"translated","value":"Bir cihaz OpenClaw'a bağlanmak istiyor."}},"uk":{"stringUnit":{"state":"translated","value":"Пристрій хоче підключитися до OpenClaw."}},"id":{"stringUnit":{"state":"translated","value":"Perangkat ingin terhubung ke OpenClaw."}},"pl":{"stringUnit":{"state":"translated","value":"Urządzenie chce połączyć się z OpenClaw."}},"th":{"stringUnit":{"state":"translated","value":"อุปกรณ์ต้องการเชื่อมต่อกับ OpenClaw"}},"vi":{"stringUnit":{"state":"translated","value":"Một thiết bị muốn kết nối với OpenClaw."}},"nl":{"stringUnit":{"state":"translated","value":"Een apparaat wil verbinding maken met OpenClaw."}},"fa":{"stringUnit":{"state":"translated","value":"دستگاهی می‌خواهد به OpenClaw متصل شود."}},"ru":{"stringUnit":{"state":"translated","value":"Устройство пытается подключиться к OpenClaw."}},"sv":{"str