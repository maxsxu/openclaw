    "Credentials are stored with this profile in your Mac Keychain.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Credentials are stored with this profile in your Mac Keychain."}},"zh-CN":{"stringUnit":{"state":"translated","value":"凭据将随此配置文件存储在你的 Mac 钥匙串中。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"憑證會隨此設定檔儲存在您的 Mac 鑰匙圈中。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As credenciais são armazenadas com este perfil nas Chaves do seu Mac."}},"de":{"stringUnit":{"state":"translated","value":"Die Anmeldedaten werden mit diesem Profil in deinem Mac-Schlüsselbund gespeichert."}},"es":{"stringUnit":{"state":"translated","value":"Las credenciales se almacenan con este perfil en el llavero de tu Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"認証情報は、このプロファイルとともにMacのキーチェーンに保存されます。"}},"ko":{"stringUnit":{"state":"translated","value":"자격 증명은 이 프로필과 함께 Mac 키체인에 저장됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les identifiants sont stockés avec ce profil dans le trousseau de votre Mac."}},"hi":{"stringUnit":{"state":"translated","value":"क्रेडेंशियल इस प्रोफ़ाइल के साथ आपके Mac Keychain में संग्रहीत किए जाते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"تُخزَّن بيانات الاعتماد مع ملف التعريف هذا في سلسلة مفاتيح Mac."}},"it":{"stringUnit":{"state":"translated","value":"Le credenziali vengono archiviate con questo profilo nel Portachiavi del Mac."}},"tr":{"stringUnit":{"state":"translated","value":"Kimlik bilgileri bu profille birlikte Mac Anahtar Zinciri'nizde saklanır."}},"uk":{"stringUnit":{"state":"translated","value":"Облікові дані зберігаються разом із цим профілем у в’язці ключів Mac."}},"id":{"stringUnit":{"state":"translated","value":"Kredensial disimpan bersama profil ini di Rantai Kunci Mac Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Dane uwierzytelniające są przechowywane wraz z tym profilem w pęku kluczy na Macu."}},"th":{"stringUnit":{"state":"translated","value":"ข้อมูลประจำตัวจะถูกจัดเก็บไว้กับโปรไฟล์นี้ในพวงกุญแจ Mac ของคุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Thông tin xác thực được lưu cùng hồ sơ này trong Chuỗi khóa trên máy Mac của bạn."}},"nl":{"stringUnit":{"state":"translated","value":"Inloggegevens worden met dit profiel bewaard in je Mac-sleutelhanger."}},"fa":{"stringUnit":{"state":"translated","value":"اطلاعات ورود همراه با این نمایه در Keychain مک شما ذخیره می‌شود."}},"ru":{"stringUnit":{"state":"translated","value":"Учётные данные хранятся вместе с этим профилем в Связке ключей Mac."}},"sv":{"stringUnit":{"state":"translated","value":"Inloggningsuppgifterna lagras med den här profilen i din Mac-nyckelring."}}}},
