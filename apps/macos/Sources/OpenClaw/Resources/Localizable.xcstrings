    "Check gateway ports": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check gateway ports"}},"zh-CN":{"stringUnit":{"state":"translated","value":"检查 Gateway 端口"}},"zh-TW":{"stringUnit":{"state":"translated","value":"檢查 Gateway 連接埠"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verificar portas do gateway"}},"de":{"stringUnit":{"state":"translated","value":"Gateway-Ports prüfen"}},"es":{"stringUnit":{"state":"translated","value":"Comprobar puertos del Gateway"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway ポートを確認"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 포트 확인"}},"fr":{"stringUnit":{"state":"translated","value":"Vérifier les ports Gateway"}},"hi":{"stringUnit":{"state":"translated","value":"gateway पोर्ट जाँचें"}},"ar":{"stringUnit":{"state":"translated","value":"التحقق من منافذ Gateway"}},"it":{"stringUnit":{"state":"translated","value":"Controlla porte gateway"}},"tr":{"stringUnit":{"state":"translated","value":"Gateway bağlantı noktalarını denetle"}},"uk":{"stringUnit":{"state":"translated","value":"Перевірити порти Gateway"}},"id":{"stringUnit":{"state":"translated","value":"Periksa port gateway"}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdź porty Gateway"}},"th":{"stringUnit":{"state":"translated","value":"ตรวจสอบพอร์ต Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Kiểm tra các cổng Gateway"}},"nl":{"stringUnit":{"state":"translated","value":"Gateway-poorten controleren"}},"fa":{"stringUnit":{"state":"translated","value":"بررسی پورت‌های gateway"}},"ru":{"stringUnit":{"state":"translated","value":"Проверить порты Gateway"}},"sv":{"stringUnit":{"state":"translated","value":"Kontrollera Gateway-portar"}}}},
    "Check which process owns %lld and suggest fixes.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Check which process owns %lld and suggest fixes."}},"zh-CN":{"stringUnit":{"state":"translated","value":"检查哪个进程占用了 %lld 并给出修复建议。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"檢查哪個處理程序擁有 %lld 並建議修正方法。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verifique qual processo é dono de %lld e sugira correções."}},"de":{"stringUnit":{"state":"translated","value":"Prüfen Sie, welcher Prozess %lld belegt, und schlagen Sie Lösungen vor."}},"es":{"stringUnit":{"state":"translated","value":"Comprueba qué proceso posee %lld y sugiere soluciones."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%lldを所有しているプロセスを確認し、修正方法を提案します。"}},"ko":{"stringUnit":{"state":"translated","value":"%lld을(를) 소유한 프로세스를 확인하고 해결 방법을 제안하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Vérifiez quel processus détient %lld et proposez des correctifs."}},"hi":{"stringUnit":{"state":"translated","value":"जांचें कि %lld किस प्रक्रिया का है और सुधार सुझाएं।"}},"ar":{"stringUnit":{"state":"translated","value":"تحقق من العملية التي تملك %lld واقترح إصلاحات."}},"it":{"stringUnit":{"state":"translated","value":"Controlla quale processo possiede %lld e suggerisci soluzioni."}},"tr":{"stringUnit":{"state":"translated","value":"%lld numarasının hangi işleme ait olduğunu kontrol edin ve çözümler önerin."}},"uk":{"stringUnit":{"state":"translated","value":"Перевірте, який процес володіє %lld, і запропонуйте виправлення."}},"id":{"stringUnit":{"state":"translated","value":"Periksa proses mana yang memiliki %lld dan sarankan perbaikan."}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdź, który proces jest właścicielem %lld i zaproponuj rozwiązania."}},"th":{"stringUnit":{"state":"translated","value":"ตรวจสอบว่ากระบวนการใดเป็นเจ้าของ %lld และแนะนำวิธีแก้ไข"}},"vi":{"stringUnit":{"state":"translated","value":"Kiểm tra tiến trình nào sở hữu %lld và đề xuất cách khắc phục."}},"nl":{"stringUnit":{"state":"translated","value":"Controleer welk proces %lld bezit en stel oplossingen voor."}},"fa":{"stringUnit":{"state":"translated","value":"بررسی کنید کدام فرایند مالک %lld است و راه‌حل پیشنهاد دهید."}},"ru":{"stringUnit":{"state":"translated","value":"Проверьте, какой процесс занимает %lld, и предложите решения."}},"sv":{"stringUnit":{"state":"translated","value":"Kontrollera vilken process som äger %lld och föreslå lösningar."}}}},
    "Checking CLI logins, saved API keys, and local model servers on the Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Checking CLI logins, saved API keys, and local model servers on the Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在检查网关上的 CLI 登录、已保存的 API 密钥和本地模型服务器。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"正在檢查 Gateway 上的 CLI 登入、已儲存的 API 金鑰和本機模型伺服器。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Verificando logins da CLI, chaves de API salvas e servidores de modelos locais no Gateway."}},"de":{"stringUnit":{"state":"translated","value":"CLI-Anmeldungen, gespeicherte API-Schlüssel und lokale Modellserver auf dem Gateway werden überprüft."}},"es":{"stringUnit":{"state":"translated","value":"Comprobando los inicios de sesión de la CLI, las claves de API guardadas y los servidores de modelos locales en el Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway 上の CLI ログイン、保存済み API キー、ローカルモデルサーバーを確認しています。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway의 CLI 로그인, 저장된 API 키 및 로컬 모델 서버를 확인하는 중입니다."}},"fr":{"stringUnit":{"state":"translated","value":"Vérification des connexions CLI, des clés API enregistrées et des serveurs de modèles locaux sur le Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway पर CLI लॉगिन, सहेजी गई API कुंजियों और स्थानीय मॉडल सर्वरों की जाँच की जा रही है।"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ التحقق من عمليات تسجيل الدخول عبر CLI ومفاتيح API المحفوظة وخوادم النماذج المحلية على Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Verifica degli accessi CLI, delle chiavi API salvate e dei server di modelli locali sul Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway üzerindeki CLI oturumları, kayıtlı API anahtarları ve yerel model sunucuları kontrol ediliyor."}},"uk":{"stringUnit":{"state":"translated","value":"Перевіряються входи через CLI, збережені ключі API та локальні сервери моделей на Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Memeriksa login CLI, kunci API tersimpan, dan server model lokal di Gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Sprawdzanie logowań CLI, zapisanych kluczy API i lokalnych serwerów modeli na Gateway."}},"th":{"stringUnit":{"state":"translated","value":"กำลังตรวจสอบการเข้าสู่ระบบ CLI, คีย์ API ที่บันทึกไว้ และเซิร์ฟเวอร์โมเดลภายในเครื่องบน Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Đang kiểm tra thông tin đăng nhập CLI, khóa API đã lưu và máy chủ mô hình cục bộ trên Gateway."}},"nl":{"stringUnit":{"state":"translated","value":"CLI-aanmeldingen, opgeslagen API-sleutels en lokale modelservers op de Gateway controleren."}},"fa":{"stringUnit":{"state":"translated","value":"در حال بررسی ورودهای CLI، کلیدهای API ذخیره‌شده و سرورهای مدل محلی در Gateway."}},"ru":{"stringUnit":{"state":"translated","value":"Проверяются входы через CLI, сохранённые ключи API и локальные серверы моделей на Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Kontrollerar CLI-inloggningar, sparade API-nycklar och lokala modellservrar på Gateway."}}}},
