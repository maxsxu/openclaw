    "Choose another app before pasting.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose another app before pasting."}},"zh-CN":{"stringUnit":{"state":"translated","value":"请先选择其他应用再粘贴。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"請先選擇其他 App，再進行貼上。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Escolha outro app antes de colar."}},"de":{"stringUnit":{"state":"translated","value":"Wähle vor dem Einfügen eine andere App aus."}},"es":{"stringUnit":{"state":"translated","value":"Elige otra app antes de pegar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"貼り付ける前に別のアプリを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"붙여넣기 전에 다른 앱을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Choisissez une autre app avant de coller."}},"hi":{"stringUnit":{"state":"translated","value":"पेस्ट करने से पहले कोई दूसरा ऐप चुनें।"}},"ar":{"stringUnit":{"state":"translated","value":"اختر تطبيقًا آخر قبل اللصق."}},"it":{"stringUnit":{"state":"translated","value":"Scegli un'altra app prima di incollare."}},"tr":{"stringUnit":{"state":"translated","value":"Yapıştırmadan önce başka bir uygulama seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Перед вставленням виберіть іншу програму."}},"id":{"stringUnit":{"state":"translated","value":"Pilih aplikasi lain sebelum menempelkan."}},"pl":{"stringUnit":{"state":"translated","value":"Przed wklejeniem wybierz inną aplikację."}},"th":{"stringUnit":{"state":"translated","value":"เลือกแอปอื่นก่อนวาง"}},"vi":{"stringUnit":{"state":"translated","value":"Chọn một ứng dụng khác trước khi dán."}},"nl":{"stringUnit":{"state":"translated","value":"Kies een andere app voordat je plakt."}},"fa":{"stringUnit":{"state":"translated","value":"پیش از جای‌گذاری، برنامه دیگری را انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Перед вставкой выберите другое приложение."}},"sv":{"stringUnit":{"state":"translated","value":"Välj en annan app innan du klistrar in."}}