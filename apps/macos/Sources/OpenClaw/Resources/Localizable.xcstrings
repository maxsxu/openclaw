    "Gateway auto-starts in local mode via launchd (%@).": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Gateway auto-starts in local mode via launchd (%@)."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 通过 launchd（%@）在本地模式下自动启动。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 會透過 launchd（%@）以本機模式自動啟動。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway inicia automaticamente em modo local via launchd (%@)."}},"de":{"stringUnit":{"state":"translated","value":"Gateway startet im lokalen Modus automatisch über launchd (%@)."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway se inicia automáticamente en modo local mediante launchd (%@)."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway は launchd 経由でローカルモードで自動起動します（%@）。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway는 launchd를 통해 로컬 모드로 자동 시작됩니다 (%@)."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway démarre automatiquement en mode local via launchd (%@)."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway launchd (%@) के माध्यम से लोकल मोड में स्वतः प्रारंभ होता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يبدأ Gateway تلقائيًا في الوضع المحلي عبر launchd (%@)."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway si avvia automaticamente in modalità locale tramite launchd (%@)."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway, launchd aracılığıyla yerel modda otomatik başlar (%@)."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway автоматично запускається в локальному режимі через launchd (%@)."}},"id":{"stringUnit":{"state":"translated","value":"Gateway otomatis memulai dalam mode lokal via launchd (%@)."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway automatycznie uruchamia się w trybie lokalnym przez launchd (%@)."}},"th":{"stringUnit":{"state":"translated","value":"Gateway เริ่มทำงานอัตโนมัติในโหมดโลคัลผ่าน launchd (%@)"}},"vi":