    "Copy cookies from %@ into an isolated agent profile. Passwords are never touched.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Copy cookies from %@ into an isolated agent profile. Passwords are never touched."}},"zh-CN":{"stringUnit":{"state":"translated","value":"将 %@ 的 cookie 复制到隔离的代理配置文件中。绝不会触及密码。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"將 %@ 的 cookie 複製到隔離的代理設定檔中。密碼絕不會被觸及。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Copie os cookies de %@ para um perfil de agente isolado. As senhas nunca são tocadas."}},"de":{"stringUnit":{"state":"translated","value":"Cookies von %@ in ein isoliertes Agentenprofil kopieren. Passwörter werden nie angetastet."}},"es":{"stringUnit":{"state":"translated","value":"Copia las cookies de %@ en un perfil de agente aislado. Las contraseñas nunca se tocan."}},"ja-JP":{"stringUnit":{"state":"translated","value":"%@ の Cookie を分離されたエージェントプロファイルにコピーします。パスワードには一切触れません。"}},"ko":{"stringUnit":{"state":"translated","value":"%@의 쿠키를 격리된 에이전트 프로필로 복사합니다. 비밀번호는 절대 건드리지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Copiez les cookies de %@ dans un profil d'agent isolé. Les mots de passe ne sont jamais touchés."}},"hi":{"stringUnit":{"state":"translated","value":"%@ से कुकीज़ को एक पृथक एजेंट प्रोफ़ाइल में कॉपी करें। पासवर्ड को कभी नहीं छुआ जाता।"}},"ar":{"stringUnit":{"state":"translated","value":"انسخ ملفات تعريف الارتباط من %@ إلى ملف تعريف وكيل معزول. لا يتم المساس بكلمات المرور أبدًا."}},"it":{"stringUnit":{"state":"translated","value":"Copia i cookie da %@ in un profilo agent isolato. Le password non vengono mai toccate."}},"tr":{"stringUnit":{"state":"translated","value":"%@ kaynağından çerezleri yalıtılmış bir aracı profiline kopyalayın. Parolalara asla dokunulmaz."}},"uk":{"stringUnit":{"state":"translated","value":"Копіювати cookies з %@ до ізольованого профілю агента. Паролі ніколи не зачіпаються."}},"id":{"stringUnit":{"state":"translated","value":"Salin cookie dari %@ ke profil agen terisolasi. Kata sandi tidak pernah disentuh."}},"pl":{"stringUnit":{"state":"translated","value":"Skopiuj pliki cookie z %@ do izolowanego profilu agenta. Hasła nigdy nie są naruszane."}},"th":{"stringUnit":{"state":"translated","value":"คัดลอกคุกกี้จาก %@ ไปยังโปรไฟล์เอเจนต์ที่แยกออกมา รหัสผ่านจะไม่ถูกแตะต้อง"}},"vi":{"stringUnit":{"state":"translated","value":"Sao chép cookie từ %@ vào một hồ sơ agent riêng biệt. Mật khẩu không bao giờ bị đụng đến."}},"nl":{"stringUnit":{"state":"translated","value":"Kopieer cookies van %@ naar een geïsoleerd agentprofiel. Wachtwoorden worden nooit aangeraakt."}},"fa":{"stringUnit":{"state":"translated","value":"کوکی‌ها را از %@ به یک نمایه ایزوله عامل کپی کنید. رمزهای عبور هرگز لمس نمی‌شوند."}},"ru":{"stringUnit":{"state":"translated","value":"Скопируйте cookie из %@ в изолированный профиль агента. Пароли никогда не затрагиваются."}},"sv":{"stringUnit":{"state":"translated","value":"Kopiera cookies från %@ till en isolerad agentprofil. Lösenord berörs aldrig."}}}},
