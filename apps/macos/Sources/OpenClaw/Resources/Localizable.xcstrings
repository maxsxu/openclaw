    "Enable/disable Canvas in General settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enable/disable Canvas in General settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在通用设置中启用/禁用 Canvas。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在「一般」設定中啟用/停用 Canvas。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ative/desative o Canvas nas configurações gerais."}},"de":{"stringUnit":{"state":"translated","value":"Canvas in den allgemeinen Einstellungen aktivieren/deaktivieren."}},"es":{"stringUnit":{"state":"translated","value":"Activa/desactiva Canvas en la configuración General."}},"ja-JP":{"stringUnit":{"state":"translated","value":"General 設定で Canvas を有効/無効にします。"}},"ko":{"stringUnit":{"state":"translated","value":"일반 설정에서 Canvas를 활성화/비활성화합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Activer/désactiver Canvas dans les réglages généraux."}},"hi":{"stringUnit":{"state":"translated","value":"General सेटिंग्स में Canvas सक्षम/अक्षम करें।"}},"ar":{"stringUnit":{"state":"translated","value":"تفعيل/تعطيل Canvas في الإعدادات العامة."}},"it":{"stringUnit":{"state":"translated","value":"Abilita/disabilita Canvas nelle impostazioni Generali."}},"tr":{"stringUnit":{"state":"translated","value":"Genel ayarlarda Canvas’ı etkinleştirin/devre dışı bırakın."}},"uk":{"stringUnit":{"state":"translated","value":"Увімкнути/вимкнути Canvas у загальних налаштуваннях."}},"id":{"stringUnit":{"state":"translated","value":"Aktifkan/nonaktifkan Canvas di pengaturan Umum."}},"pl":{"stringUnit":{"state":"translated","value":"Włącz/wyłącz Canvas w ustawieniach ogólnych."}},"th":{"stringUnit":{"state":"translated","value":"เปิด/ปิด Canvas ในการตั้งค่าทั่วไป"}},"vi":{"stringUnit":{"state":"translated","value":"Bật/tắt Canvas trong cài đặt General."}},"nl":{"stringUnit":{"state":"translated","value":"Canvas in- of uitschakelen in Algemene instellingen."}},"fa":{"stringUnit":{"state":"translated","value":"Canvas را در تنظیمات General فعال/غیرفعال کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Включить/выключить Canvas в общих настройках."}},"sv":{"stringUnit":{"state":"translated","value":"Aktivera/inaktivera Canvas i allmänna inställningar."}}}},
    "Enabled for this session": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enabled for this session"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已为此会话启用"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已為此工作階段啟用"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Ativado para esta sessão"}},"de":{"stringUnit":{"state":"translated","value":"Für diese Sitzung aktiviert"}},"es":{"stringUnit":{"state":"translated","value":"Activado para esta sesión"}},"ja-JP":{"stringUnit":{"state":"translated","value":"このセッションで有効"}},"ko":{"stringUnit":{"state":"translated","value":"이 세션에서 활성화됨"}},"fr":{"stringUnit":{"state":"translated","value":"Activé pour cette session"}},"hi":{"stringUnit":{"state":"translated","value":"इस सत्र के लिए सक्षम"}},"ar":{"stringUnit":{"state":"translated","value":"مُفعّل لهذه الجلسة"}},"it":{"stringUnit":{"state":"translated","value":"Abilitato per questa sessione"}},"tr":{"stringUnit":{"state":"translated","value":"Bu oturum için etkinleştirildi"}},"uk":{"stringUnit":{"state":"translated","value":"Увімкнено для цієї сесії"}},"id":{"stringUnit":{"state":"translated","value":"Diaktifkan untuk sesi ini"}},"pl":{"stringUnit":{"state":"translated","value":"Włączone dla tej sesji"}},"th":{"stringUnit":{"state":"translated","value":"เปิดใช้งานสำหรับเซสชันนี้"}},"vi":{"stringUnit":{"state":"translated","value":"Đã bật cho phiên này"}},"nl":{"stringUnit":{"state":"translated","value":"Ingeschakeld voor deze sessie"}},"fa":{"stringUnit":{"state":"translated","value":"برای این جلسه فعال شد"}},"ru":{"stringUnit":{"state":"translated","value":"Включено для этого сеанса"}},"sv":{"stringUnit":{"state":"translated","value":"Aktiverat för denna session"}}}},
    "Enter secret…": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter secret…"}},"zh-CN":{"stringUnit":{"state":"translated","value":"输入密钥…"}},"zh-TW":{"stringUnit":{"state":"translated","value":"輸入密鑰…"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Insira o segredo…"}},"de":{"stringUnit":{"state":"translated","value":"Secret eingeben…"}},"es":{"stringUnit":{"state":"translated","value":"Introduce el secreto…"}},"ja-JP":{"stringUnit":{"state":"translated","value":"シークレットを入力…"}},"ko":{"stringUnit":{"state":"translated","value":"비밀 값 입력…"}},"fr":{"stringUnit":{"state":"translated","value":"Saisissez le secret…"}},"hi":{"stringUnit":{"state":"translated","value":"गोपनीय जानकारी दर्ज करें…"}},"ar":{"stringUnit":{"state":"translated","value":"أدخل السر…"}},"it":{"stringUnit":{"state":"translated","value":"Inserisci il segreto…"}},"tr":{"stringUnit":{"state":"translated","value":"Gizli bilgiyi girin…"}},"uk":{"stringUnit":{"state":"translated","value":"Введіть секрет…"}},"id":{"stringUnit":{"state":"translated","value":"Masukkan rahasia…"}},"pl":{"stringUnit":{"state":"translated","value":"Wprowadź sekret…"}},"th":{"stringUnit":{"state":"translated","value":"ป้อนข้อมูลลับ…"}},"vi":{"stringUnit":{"state":"translated","value":"Nhập bí mật…"}},"nl":{"stringUnit":{"state":"translated","value":"Voer geheim in…"}},"fa":{"stringUnit":{"state":"translated","value":"رمز محرمانه را وارد کنید…"}},"ru":{"stringUnit":{"state":"translated","value":"Введите секрет…"}},"sv":{"stringUnit":{"state":"translated","value":"Ange hemlighet…"}}}},
    "Enter this one-time code on the provider's sign-in page.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Enter this one-time code on the provider's sign-in page."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在提供商的登录页面上输入此一次性代码。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"在供應商的登入頁面上輸入此一次性代碼。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Insira este código de uso único na página de login do provedor."}},"de":{"stringUnit":{"state":"translated","value":"Gib diesen Einmalcode auf der Anmeldeseite des Anbieters ein."}},"es":{"stringUnit":{"state":"translated","value":"Introduce este código de un solo uso en la página de inicio de sesión del proveedor."}},"ja-JP":{"stringUnit":{"state":"translated","value":"このワンタイムコードをプロバイダーのサインインページで入力してください。"}},"ko":{"stringUnit":{"state":"translated","value":"공급자의 로그인 페이지에 이 일회용 코드를 입력하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Saisissez ce code à usage unique sur la page de connexion du fournisseur."}},"hi":{"stringUnit":{"state":"translated","value":"इस वन-टाइम कोड को प्रदाता के साइन-इन पेज पर दर्ज करें।"}},"ar":{"stringUnit":{"state":"translated","value":"أدخل هذا الرمز لمرة واحدة في صفحة تسجيل الدخول الخاصة بالمزوّد."}},"it":{"stringUnit":{"state":"translated","value":"Inserisci questo codice monouso nella pagina di accesso del provider."}},"tr":{"stringUnit":{"state":"translated","value":"Bu tek seferlik kodu sağlayıcının oturum açma sayfasına girin."}},"uk":{"stringUnit":{"state":"translated","value":"Введіть цей одноразовий код на сторінці входу провайдера."}},"id":{"stringUnit":{"state":"translated","value":"Masukkan kode sekali pakai ini di halaman masuk penyedia."}},"pl":{"stringUnit":{"state":"translated","value":"Wprowadź ten jednorazowy kod na stronie logowania dostawcy."}},"th":{"stringUnit":{"state":"translated","value":"กรอกรหัสแบบใช้ครั้งเดียวนี้ในหน้าลงชื่อเข้าใช้ของผู้ให้บริการ"}},"vi":{"stringUnit":{"state":"translated","value":"Nhập mã dùng một lần này trên trang đăng nhập của nhà cung cấp."}},"nl":{"stringUnit":{"state":"translated","value":"Voer deze eenmalige code in op de aanmeldpagina van de provider."}},"fa":{"stringUnit":{"state":"translated","value":"این کد یک‌بارمصرف را در صفحه ورود ارائه‌دهنده وارد کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Введите этот одноразовый код на странице входа провайдера."}},"sv":{"stringUnit":{"state":"translated","value":"Ange den här engångskoden på leverantörens inloggningssida."}}}},
    "Error": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Error"}},"zh-CN":{"stringUnit":{"state":"translated","value":"错误"}},"zh-TW":{"stringUnit":{"state":"translated","value":"錯誤"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Erro"}},"de":{"stringUnit":{"state":"translated","value":"Fehler"}},"es":{"stringUnit":{"state":"new","value":"Error"}},"ja-JP":{"stringUnit":{"state":"translated","value":"エラー"}},"ko":{"stringUnit":{"state":"translated","value":"오류"}},"fr":{"stringUnit":{"state":"translated","value":"Erreur"}},"hi":{"stringUnit":{"state":"translated","value":"त्रुटि"}},"ar":{"stringUnit":{"state":"translated","value":"خطأ"}},"it":{"stringUnit":{"state":"translated","value":"Errore"}},"tr":{"stringUnit":{"state":"translated","value":"Hata"}},"uk":{"stringUnit":{"state":"translated","value":"Помилка"}},"id":{"stringUnit":{"state":"translated","value":"Kesalahan"}},"pl":{"stringUnit":{"state":"translated","value":"Błąd"}},"th":{"stringUnit":{"state":"translated","value":"ข้อผิดพลาด"}},"vi":{"stringUnit":{"state":"translated","value":"Lỗi"}},"nl":{"stringUnit":{"state":"translated","value":"Fout"}},"fa":{"stringUnit":{"state":"translated","value":"خطا"}},"ru":{"stringUnit":{"state":"translated","value":"Ошибка"}},"sv":{"stringUnit":{"state":"translated","value":"Fel"}}}},
    "Error: %@": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Error: %@"}},"zh-CN":{"stringUnit":{"state":"translated","value":"错误：%@"}},"zh-TW":{"stringUnit":{"state":"translated","value":"錯誤：%@"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Erro: %@"}},"de":{"stringUnit":{"state":"translated","value":"Fehler: %@"}},"es":{"stringUnit":{"state":"new","value":"Error: %@"}},"ja-JP":{"stringUnit":{"state":"translated","value":"エラー: %@"}},"ko":{"stringUnit":{"state":"translated","value":"오류: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Erreur : %@"}},"hi":{"stringUnit":{"state":"translated","value":"त्रुटि: %@"}},"ar":{"stringUnit":{"state":"translated","value":"خطأ: %@"}},"it":{"stringUnit":{"state":"translated","value":"Errore: %@"}},"tr":{"stringUnit":{"state":"translated","value":"Hata: %@"}},"uk":{"stringUnit":{"state":"translated","value":"Помилка: %@"}},"id":{"stringUnit":{"state":"translated","value":"Kesalahan: %@"}},"pl":{"stringUnit":{"state":"translated","value":"Błąd: %@"}},"th":{"stringUnit":{"state":"translated","value":"ข้อผิดพลาด: %@"}},"vi":{"stringUnit":{"state":"translated","value":"Lỗi: %@"}},"nl":{"stringUnit":{"state":"translated","value":"Fout: %@"}},"fa":{"stringUnit":{"state":"translated","value":"خطا: %@"}},"ru":{"stringUnit":{"state":"translated","value":"Ошибка: %@"}},"sv":{"stringUnit":{"state":"translated","value":"Fel: %@"}}}},
    "Everything runs where you decide, with permissions you grant.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Everything runs where you decide, with permissions you grant."}},"zh-CN":{"stringUnit":{"state":"translated","value":"一切都在你决定的位置运行，并使用你授予的权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"一切都在你決定的地方執行，並使用你授予的權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Tudo roda onde você decidir, com as permissões que você conceder."}},"de":{"stringUnit":{"state":"translated","value":"Alles läuft dort, wo Sie es festlegen, mit den Berechtigungen, die Sie erteilen."}},"es":{"stringUnit":{"state":"translated","value":"Todo se ejecuta donde tú decidas, con los permisos que concedas."}},"ja-JP":{"stringUnit":{"state":"translated","value":"すべてはあなたが決めた場所で、あなたが許可した権限で実行されます。"}},"ko":{"stringUnit":{"state":"translated","value":"모든 것은 사용자가 결정한 위치에서, 사용자가 부여한 권한으로 실행됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Tout s’exécute là où vous le décidez, avec les autorisations que vous accordez."}},"hi":{"stringUnit":{"state":"translated","value":"सब कुछ वहीं चलता है जहाँ आप तय करते हैं, आपकी दी गई अनुमतियों के साथ।"}},"ar":{"stringUnit":{"state":"translated","value":"كل شيء يعمل حيثما تقرر، وبالأذونات التي تمنحها."}},"it":{"stringUnit":{"state":"translated","value":"Tutto viene eseguito dove decidi tu, con le autorizzazioni che concedi."}},"tr":{"stringUnit":{"state":"translated","value":"Her şey, sizin verdiğiniz izinlerle, karar verdiğiniz yerde çalışır."}},"uk":{"stringUnit":{"state":"translated","value":"Усе працює там, де ви вирішите, з дозволами, які ви надасте."}},"id":{"stringUnit":{"state":"translated","value":"Semuanya berjalan di tempat yang Anda tentukan, dengan izin yang Anda berikan."}},"pl":{"stringUnit":{"state":"translated","value":"Wszystko działa tam, gdzie zdecydujesz, z uprawnieniami, których udzielisz."}},"th":{"stringUnit":{"state":"translated","value":"ทุกอย่างทำงานในที่ที่คุณตัดสินใจ พร้อมสิทธิ์ที่คุณอนุญาต"}},"vi":{"stringUnit":{"state":"translated","value":"Mọi thứ chạy ở nơi bạn quyết định, với các quyền bạn cấp."}},"nl":{"stringUnit":{"state":"translated","value":"Alles draait waar jij beslist, met de machtigingen die jij verleent."}},"fa":{"stringUnit":{"state":"translated","value":"همه‌چیز هرجا که شما تصمیم بگیرید اجرا می‌شود، با مجوزهایی که شما اعطا می‌کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Всё работает там, где вы решите, с разрешениями, которые вы предоставите."}},"sv":{"stringUnit":{"state":"translated","value":"Allt körs där du bestämmer, med de behörigheter du ger."}}}},
    "Exact HTTPS hosts, separated by commas or spaces. Empty allows config SecretRefs only.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exact HTTPS hosts, separated by commas or spaces. Empty allows config SecretRefs only."}},"zh-CN":{"stringUnit":{"state":"translated","value":"精确的 HTTPS 主机，用逗号或空格分隔。留空则仅允许配置 SecretRefs。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"完整的 HTTPS 主機，以逗號或空格分隔。留空僅允許 config SecretRefs。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Hosts HTTPS exatos, separados por vírgulas ou espaços. Vazio permite apenas SecretRefs de configuração."}},"de":{"stringUnit":{"state":"translated","value":"Exakte HTTPS-Hosts, getrennt durch Kommas oder Leerzeichen. Leer erlaubt nur Konfigurations-SecretRefs."}},"es":{"stringUnit":{"state":"translated","value":"Hosts HTTPS exactos, separados por comas o espacios. Vacío permite solo SecretRefs de configuración."}},"ja-JP":{"stringUnit":{"state":"translated","value":"正確なHTTPSホスト、カンマまたはスペースで区切ります。空の場合は設定のSecretRefsのみ許可します。"}},"ko":{"stringUnit":{"state":"translated","value":"정확한 HTTPS 호스트, 쉼표 또는 공백으로 구분합니다. 비워 두면 config SecretRefs만 허용됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Hôtes HTTPS exacts, séparés par des virgules ou des espaces. Vide autorise uniquement les SecretRefs de config."}},"hi":{"stringUnit":{"state":"translated","value":"सटीक HTTPS होस्ट, कॉमा या स्पेस से अलग किए गए। खाली रहने पर केवल config SecretRefs की अनुमति है।"}},"ar":{"stringUnit":{"state":"translated","value":"مضيفات HTTPS دقيقة، مفصولة بفواصل أو مسافات. الحقل الفارغ يسمح بإعدادات SecretRefs فقط."}},"it":{"stringUnit":{"state":"translated","value":"Host HTTPS esatti, separati da virgole o spazi. Vuoto consente solo i SecretRef di configurazione."}},"tr":{"stringUnit":{"state":"translated","value":"Tam HTTPS ana bilgisayarları, virgül veya boşlukla ayrılmış. Boş bırakmak yalnızca config SecretRef'lerine izin verir."}},"uk":{"stringUnit":{"state":"translated","value":"Точні HTTPS-хости, розділені комами або пробілами. Порожнє поле дозволяє лише SecretRefs у конфігурації."}},"id":{"stringUnit":{"state":"translated","value":"Host HTTPS persis, dipisahkan dengan koma atau spasi. Kosong hanya mengizinkan SecretRefs config."}},"pl":{"stringUnit":{"state":"translated","value":"Dokładne hosty HTTPS, oddzielone przecinkami lub spacjami. Puste zezwala tylko na SecretRefs konfiguracji."}},"th":{"stringUnit":{"state":"translated","value":"โฮสต์ HTTPS แบบตรงตัว คั่นด้วยเครื่องหมายจุลภาคหรือช่องว่าง เว้นว่างไว้จะอนุญาตเฉพาะ SecretRefs ของ config เท่านั้น"}},"vi":{"stringUnit":{"state":"translated","value":"Các host HTTPS chính xác, phân tách bằng dấu phẩy hoặc dấu cách. Để trống chỉ cho phép config SecretRefs."}},"nl":{"stringUnit":{"state":"translated","value":"Exacte HTTPS-hosts, gescheiden door komma's of spaties. Leeg staat alleen config-SecretRefs toe."}},"fa":{"stringUnit":{"state":"translated","value":"میزبان‌های HTTPS دقیق، جداشده با کاما یا فاصله. خالی فقط SecretRefs پیکربندی را مجاز می‌کند."}},"ru":{"stringUnit":{"state":"translated","value":"Точные HTTPS-хосты, разделённые запятыми или пробелами. Пустое значение разрешает только config SecretRefs."}},"sv":{"stringUnit":{"state":"translated","value":"Exakta HTTPS-värdar, separerade med komma eller mellanslag. Tomt tillåter endast config SecretRefs."}}}},
    "Exec approvals unavailable. Retry to refresh.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Exec approvals unavailable. Retry to refresh."}},"zh-CN":{"stringUnit":{"state":"translated","value":"执行审批不可用。请重试以刷新。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"執行核准目前無法使用。請重試以重新整理。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As aprovações de execução estão indisponíveis. Tente novamente para atualizar."}},"de":{"stringUnit":{"state":"translated","value":"Exec-Genehmigungen sind nicht verfügbar. Versuchen Sie es erneut, um sie zu aktualisieren."}},"es":{"stringUnit":{"state":"translated","value":"Las aprobaciones de ejecución no están disponibles. Vuelve a intentarlo para actualizar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"実行の承認を利用できません。再試行して更新してください。"}},"ko":{"stringUnit":{"state":"translated","value":"실행 승인을 사용할 수 없습니다. 새로 고치려면 다시 시도하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Les approbations d’exécution sont indisponibles. Réessayez pour actualiser."}},"hi":{"stringUnit":{"state":"translated","value":"Exec अनुमोदन उपलब्ध नहीं हैं। रीफ़्रेश करने के लिए फिर से प्रयास करें।"}},"ar":{"stringUnit":{"state":"translated","value":"موافقات التنفيذ غير متاحة. أعد المحاولة للتحديث."}},"it":{"stringUnit":{"state":"translated","value":"Approvazioni di esecuzione non disponibili. Riprova per aggiornare."}},"tr":{"stringUnit":{"state":"translated","value":"Çalıştırma onayları kullanılamıyor. Yenilemek için tekrar deneyin."}},"uk":{"stringUnit":{"state":"translated","value":"Схвалення виконання недоступні. Повторіть спробу, щоб оновити."}},"id":{"stringUnit":{"state":"translated","value":"Persetujuan exec tidak tersedia. Coba lagi untuk memuat ulang."}},"pl":{"stringUnit":{"state":"translated","value":"Zatwierdzenia wykonywania są niedostępne. Ponów próbę, aby odświeżyć."}},"th":{"stringUnit":{"state":"translated","value":"การอนุมัติ Exec ไม่พร้อมใช้งาน โปรดลองอีกครั้งเพื่อรีเฟรช"}},"vi":{"stringUnit":{"st