    "Attaching focused-window text uses macOS Accessibility access.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Attaching focused-window text uses macOS Accessibility access."}},"zh-CN":{"stringUnit":{"state":"translated","value":"附加当前聚焦窗口中的文本需要 macOS 辅助功能访问权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"附加聚焦視窗中的文字需要 macOS 輔助使用權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Anexar o texto da janela em foco usa o acesso de Acessibilidade do macOS."}},"de":{"stringUnit":{"state":"translated","value":"Zum Anhängen von Text aus dem fokussierten Fenster ist macOS-Bedienungshilfenzugriff erforderlich."}},"es":{"stringUnit":{"state":"translated","value":"Para adjuntar el texto de la ventana enfocada se requiere acceso de Accesibilidad de macOS."}},"ja-JP":{"stringUnit":{"state":"translated","value":"フォーカス中のウインドウのテキストを添付するには、macOSのアクセシビリティへのアクセスが必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"포커스된 윈도우의 텍스트를 첨부하려면 macOS 손쉬운 사용 권한이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Joindre le texte de la fenêtre active nécessite l’accès aux fonctionnalités d’accessibilité de macOS."}},"hi":{"stringUnit":{"state":"translated","value":"फ़ोकस की गई विंडो का टेक्स्ट अटैच करने के लिए macOS Accessibility एक्सेस का उपयोग होता है।"}},"ar":{"stringUnit":{"state":"translated","value":"يتطلب إرفاق نص النافذة النشطة إذن تسهيلات الاستخدام في macOS."}},"it":{"stringUnit":{"state":"translated","value":"Per allegare il testo della finestra in primo piano è necessario l'accesso ad Accessibilità di macOS."}},"tr":{"stringUnit":{"state":"translated","value":"Odaktaki pencerenin metnini eklemek için macOS Erişilebilirlik erişimi kullanılır."}},"uk":{"stringUnit":{"state":"translated","value":"Для прикріплення тексту з активного вікна потрібен доступ до універсального доступу macOS."}},"id":{"stringUnit":{"state":"translated","value":"Melampirkan teks dari jendela yang difokuskan menggunakan akses Aksesibilitas macOS."}},"pl":{