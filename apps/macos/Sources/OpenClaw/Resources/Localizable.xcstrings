    "Press start, say a trigger word, and wait for detection.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Press start, say a trigger word, and wait for detection."}},"zh-CN":{"stringUnit":{"state":"translated","value":"按下开始，说出一个触发词，然后等待检测。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"按下開始，說出觸發詞，然後等待偵測。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pressione iniciar, diga uma palavra de ativação e aguarde a detecção."}},"de":{"stringUnit":{"state":"translated","value":"Drücken Sie auf Start, sagen Sie ein Auslösewort und warten Sie auf die Erkennung."}},"es":{"stringUnit":{"state":"translated","value":"Pulsa iniciar, di una palabra de activación y espera a que se detecte."}},"ja-JP":{"stringUnit":{"state":"translated","value":"開始を押し、トリガーワードを言って、検出を待ちます。"}},"ko":{"stringUnit":{"state":"translated","value":"시작을 누르고 트리거 단어를 말한 다음 감지를 기다리세요."}},"fr":{"stringUnit":{"state":"translated","value":"Appuyez sur Démarrer, prononcez un mot déclencheur, puis attendez la détection."}},"hi":{"stringUnit":{"state":"translated","value":"स्टार्ट दबाएँ, कोई ट्रिगर शब्द बोलें, और पहचान का इंतज़ार करें।"}},"ar":{"stringUnit":{"state":"translated","value":"اضغط على بدء، وقل كلمة تشغيل، ثم انتظر الاكتشاف."}},"it":{"stringUnit":{"state":"translated","value":"Premi Avvia, pronuncia una parola di attivazione e attendi il rilevamento."}},"tr":{"stringUnit":{"state":"translated","value":"Başlat'a basın, bir tetikleyici kelime söyleyin ve algılanmasını bekleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Натисніть «Почати», скажіть слово-тригер і зачекайте на виявлення."}},"id":{"stringUnit":{"state":"translated","value":"Tekan mulai, ucapkan kata pemicu, lalu tunggu deteksi."}},"pl":{"stringUnit":{"state":"translated","value":"Naciśnij start, wypowiedz słowo wyzwalające i poczekaj na wykrycie."}},"th":{"stringUnit":{"state":"translated","value":"กดเริ่ม พูดคำทริกเกอร์ แล้วรอการตรวจจับ"}},"vi":{"stringUnit":{"state":"translated","value":"N