    "Click a discovered gateway to fill the SSH target.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Click a discovered gateway to fill the SSH target."}},"zh-CN":{"stringUnit":{"state":"translated","value":"点击发现的 Gateway 以填充 SSH 目标。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"點選已探索到的 Gateway 以填入 SSH 目標。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Clique em um gateway descoberto para preencher o destino SSH."}},"de":{"stringUnit":{"state":"translated","value":"Klicken Sie auf ein gefundenes Gateway, um das SSH-Ziel auszufüllen."}},"es":{"stringUnit":{"state":"translated","value":"Haz clic en un gateway descubierto para completar el destino SSH."}},"ja-JP":{"stringUnit":{"state":"translated","value":"検出された Gateway をクリックして SSH ターゲットを入力します。"}},"ko":{"stringUnit":{"state":"translated","value":"검색된 Gateway를 클릭하여 SSH 대상을 채우세요."}},"fr":{"stringUnit":{"state":"translated","value":"Cliquez sur un Gateway détecté pour renseigner la cible SSH."}},"hi":{"stringUnit":{"state":"translated","value":"SSH target भरने के लिए किसी खोजे गए gateway पर क्लिक करें।"}},"ar":{"stringUnit":{"state":"translated","value":"انقر على gateway مكتشف لملء هدف SSH."}},"it":{"stringUnit":{"state":"translated","value":"Fai clic su un gateway rilevato per compilare la destinazione SSH."}},"tr":{"stringUnit":{"state":"translated","value":"SSH hedefini doldurmak için bulunan bir gateway'e tıklayın."}},"uk":{"stringUnit":{"state":"translated","value":"Натисніть знайдений шлюз, щоб заповнити SSH target."}},"id":{"stringUnit":{"state":"translated","value":"Klik gateway yang ditemukan untuk mengisi target SSH."}},"pl":{"stringUnit":{"state":"translated","value":"Kliknij wykryty Gateway, aby wypełnić cel SSH."}},"th":{"stringUnit":{"state":"translated","value":"คลิก Gateway ที่ค้นพบเพื่อกรอกเป้าหมาย SSH"}},"vi":{"stringUnit":{"state":"translated","value":"Nhấp vào một gateway đã phát hiện để điền đích SSH."}},"nl":{"stringUnit":{"state":"translated","value":"Klik op een gevonden gateway om het SSH-doel in te vullen."}},"fa":{"stringUnit":{"state":"translated","value":"برای پر کردن هدف SSH، روی یک gateway کشف‌شده کلیک کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Нажмите на обнаруженный шлюз, чтобы заполнить цель SSH."}},"sv":{"stringUnit":{"state":"translated","value":"Klicka på en upptäckt gateway för att fylla i SSH-målet."}}}},
    "Click a discovered gateway to fill the gateway URL.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Click a discovered gateway to fill the gateway URL."}},"zh-CN":{"stringUnit":{"state":"translated","value":"点击发现的 Gateway 以填充 Gateway URL。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"點選已探索到的 Gateway 以填入 Gateway URL。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Clique em um gateway descoberto para preencher a URL do gateway."}},"de":{"stringUnit":{"state":"translated","value":"Klicken Sie auf ein gefundenes Gateway, um die Gateway-URL auszufüllen."}},"es":{"stringUnit":{"state":"translated","value":"Haz clic en un gateway descubierto para completar la URL del gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"検出された Gateway をクリックして Gateway URL を入力します。"}},"ko":{"stringUnit":{"state":"translated","value":"검색된 Gateway를 클릭하여 Gateway URL을 채우세요."}},"fr":{"stringUnit":{"state":"translated","value":"Cliquez sur un Gateway détecté pour renseigner l’URL du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"gateway URL भरने के लिए किसी खोजे गए gateway पर क्लिक करें।"}},"ar":{"stringUnit":{"state":"translated","value":"انقر على gateway مكتشف لملء عنوان URL الخاص بالـ gateway."}},"it":{"stringUnit":{"state":"translated","value":"Fai clic su un gateway rilevato per compilare l'URL del gateway."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway URL'sini doldurmak için bulunan bir gateway'e tıklayın."}},"uk":{"stringUnit":{"state":"translated","value":"Натисніть знайдений шлюз, щоб заповнити URL-адресу шлюзу."}},"id":{"stringUnit":{"state":"translated","value":"Klik gateway yang ditemukan untuk mengisi URL gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Kliknij wykryty Gateway, aby wypełnić adres URL Gateway."}},"th":{"stringUnit":{"state":"translated","value":"คลิก Gateway ที่ค้นพบเพื่อกรอก URL ของ Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Nhấp vào một gateway đã phát 