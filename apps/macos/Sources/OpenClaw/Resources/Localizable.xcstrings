    "SSH keeps the Gateway private; direct is best for HTTPS or Tailscale Serve.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"SSH keeps the Gateway private; direct is best for HTTPS or Tailscale Serve."}},"zh-CN":{"stringUnit":{"state":"translated","value":"SSH 可使 Gateway 保持私有；直连最适合 HTTPS 或 Tailscale Serve。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"SSH 可讓 Gateway 保持私有；direct 最適合 HTTPS 或 Tailscale Serve。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"SSH mantém o Gateway privado; direto é melhor para HTTPS ou Tailscale Serve."}},"de":{"stringUnit":{"state":"translated","value":"SSH hält das Gateway privat; direkt ist am besten für HTTPS oder Tailscale Serve."}},"es":{"stringUnit":{"state":"translated","value":"SSH mantiene el Gateway privado; directo es mejor para HTTPS o Tailscale Serve."}},"ja-JP":{"stringUnit":{"state":"translated","value":"SSH は Gateway を非公開に保ちます。HTTPS または Tailscale Serve には直接接続が最適です。"}},"ko":{"stringUnit":{"state":"translated","value":"SSH는 Gateway를 비공개로 유지하며, direct는 HTTPS 또는 Tailscale Serve에 가장 적합합니다."}},"fr":{"stringUnit":{"state":"translated","value":"SSH garde le Gateway privé ; direct est préférable pour HTTPS ou Tailscale Serve."}},"hi":{"stringUnit":{"state":"translated","value":"SSH Gateway को निजी रखता है; HTTPS या Tailscale Serve के लिए direct सबसे अच्छा है।"}},"ar":{"stringUnit":{"state":"translated","value":"يحافظ SSH على خصوصية Gateway؛ ويُعد الاتصال المباشر الأفضل لـ HTTPS أو Tailscale Serve."}},"it":{"stringUnit":{"state":"translated","value":"SSH mantiene il Gateway privato; diretto è ideale per HTTPS o Tailscale Serve."}},"tr":{"stringUnit":{"state":"translated","value":"SSH, Gateway'i özel tutar; doğrudan bağlantı HTTPS veya Tailscale Serve için en iyisidir."}},"uk":{"stringUnit":{"state":"translated","value":"SSH зберігає Gateway приватним; пряме підключення найкраще для HTTPS або Tailscale Serve."}},"id":{"stringUnit":{"state":"translated","value":"SSH menjaga Gateway tetap privat; direct paling cocok untuk HTTPS atau Tailscale Serve."}},"pl":{"stringUnit":{"state":"translated","value":"SSH utrzymuje Gateway jako prywatny; połączenie bezpośrednie jest najlepsze dla HTTPS lub Tailscale Serve."}},"th":{"stringUnit":{"state":"translated","value":"SSH ช่วยให้ Gateway เป็นส่วนตัว; แบบ direct เหมาะที่สุดสำหรับ HTTPS หรือ Tailscale Serve"}},"vi":{"stringUnit":{"state":"translated","value":"SSH giữ Gateway ở chế độ riêng tư; kết nối trực tiếp phù hợp nhất cho HTTPS hoặc Tailscale Serve."}},"nl":{"stringUnit":{"state":"translated","value":"SSH houdt de Gateway privé; direct is het beste voor HTTPS of Tailscale Serve."}},"fa":{"stringUnit":{"state":"translated","value":"SSH، Gateway را خصوصی نگه می‌دارد؛ اتصال مستقیم برای HTTPS یا Tailscale Serve بهترین گزینه است."}},"ru":{"stringUnit":{"state":"translated","value":"SSH сохраняет Gateway приватным; прямое подключение лучше всего подходит для HTTPS или Tailscale Serve."}},"sv":{"stringUnit":{"state":"translated","value":"SSH håller Gateway privat; direktanslutning är bäst för HTTPS eller Tailscale Serve."}}}},
