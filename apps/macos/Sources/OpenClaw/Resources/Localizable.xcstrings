    "The Gateway did not start.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway did not start."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 未启动。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 未啟動。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway não foi iniciado."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway wurde nicht gestartet."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway no se inició."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway は起動しませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 시작되지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway n’a pas démarré."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway शुरू नहीं हुआ।"}},"ar":{"stringUnit":{"state":"translated","value":"لم يبدأ Gateway."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway non si è avviato."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway başlatılamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway не запустився."}},"id":{"stringUnit":{"state":"translated","value":"Gateway tidak dimulai."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway nie uruchomił się."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ไม่เริ่มทำงาน"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway không khởi động."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway is niet gestart."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway راه‌اندازی نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Gateway не запустился."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway startade inte."}}}},
    "The Gateway didn’t start": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway didn’t start"}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 未启动"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 未啟動"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway não iniciou"}},"de":{"stringUnit":{"state":"translated","value":"Die Gateway wurde nicht gestartet"}},"es":{"stringUnit":{"state":"translated","value":"El Gateway no se inició"}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway が起動しませんでした"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 시작되지 않았습니다"}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway n’a pas démarré"}},"hi":{"stringUnit":{"state":"translated","value":"Gateway शुरू नहीं हुआ"}},"ar":{"stringUnit":{"state":"translated","value":"لم يبدأ Gateway"}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway non si è avviato"}},"tr":{"stringUnit":{"state":"translated","value":"Gateway başlamadı"}},"uk":{"stringUnit":{"state":"translated","value":"Gateway не запустився"}},"id":{"stringUnit":{"state":"translated","value":"Gateway tidak dimulai"}},"pl":{"stringUnit":{"state":"translated","value":"Gateway nie uruchomił się"}},"th":{"stringUnit":{"state":"translated","value":"Gateway ไม่เริ่มทำงาน"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway không khởi động"}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway is niet gestart"}},"fa":{"stringUnit":{"state":"translated","value":"Gateway شروع نشد"}},"ru":{"stringUnit":{"state":"translated","value":"Gateway не запустился"}},"sv":{"stringUnit":{"state":"translated","value":"Gateway startade inte"}}}},
    "The Gateway remains paused, so OpenClaw did not wake your agent.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway remains paused, so OpenClaw did not wake your agent."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 仍处于暂停状态，因此 OpenClaw 未唤醒您的智能体。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 仍處於暫停狀態，因此 OpenClaw 未喚醒您的代理程式。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway continua pausado, então o OpenClaw não ativou seu agente."}},"de":{"stringUnit":{"state":"translated","value":"Das Gateway ist weiterhin pausiert, daher hat OpenClaw Ihren Agenten nicht aktiviert."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway sigue en pausa, por lo que OpenClaw no activó a tu agente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gateway は一時停止したままのため、OpenClaw はエージェントを起動しませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway가 계속 일시 중지된 상태이므로 OpenClaw에서 에이전트를 깨우지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway est toujours en pause. OpenClaw n’a donc pas réveillé votre agent."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway अभी भी रुका हुआ है, इसलिए OpenClaw ने आपके एजेंट को सक्रिय नहीं किया।"}},"ar":{"stringUnit":{"state":"translated","value":"لا يزال Gateway متوقفًا مؤقتًا، لذا لم يوقظ OpenClaw وكيلك."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway è ancora in pausa, quindi OpenClaw non ha riattivato il tuo agente."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway duraklatılmış durumda kaldığı için OpenClaw aracınızı uyandırmadı."}},"uk":{"stringUnit":{"state":"translated","value":"Gateway залишається призупиненим, тому OpenClaw не активував вашого агента."}},"id":{"stringUnit":{"state":"translated","value":"Gateway tetap dijeda, sehingga OpenClaw tidak membangunkan agen Anda."}},"pl":{"stringUnit":{"state":"translated","value":"Gateway pozostaje wstrzymany, dlatego OpenClaw nie wybudził Twojego agenta."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ยังคงหยุดชั่วคราว ดังนั้น OpenClaw จึงไม่ได้ปลุกเอเจนต์ของคุณ"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway vẫn đang tạm dừng, nên OpenClaw không đánh thức tác tử của bạn."}},"nl":{"stringUnit":{"state":"translated","value":"De Gateway blijft gepauzeerd, dus OpenClaw heeft uw agent niet geactiveerd."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway همچنان متوقف است، بنابراین OpenClaw عامل شما را فعال نکرد."}},"ru":{"stringUnit":{"state":"translated","value":"Gateway по-прежнему приостановлен, поэтому OpenClaw не активировал вашего агента."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway är fortfarande pausad, så OpenClaw väckte inte din agent."}}}},
    "The Gateway setup request failed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway setup request failed."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 设置请求失败。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 設定請求失敗。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A solicitação de configuração do Gateway falhou."}},"de":{"stringUnit":{"state":"translated","value":"Die Gateway-Einrichtungsanfrage ist fehlgeschlagen."}},"es":{"stringUnit":{"state":"translated","value":"La solicitud de configuración del Gateway falló."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayのセットアップリクエストが失敗しました。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 설정 요청이 실패했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La requête de configuration du Gateway a échoué."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway सेटअप अनुरोध विफल रहा।"}},"ar":{"stringUnit":{"state":"translated","value":"فشل طلب إعداد Gateway."}},"it":{"stringUnit":{"state":"translated","value":"La richiesta di configurazione del Gateway non è riuscita."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway kurulum isteği başarısız oldu."}},"uk":{"stringUnit":{"state":"translated","value":"Запит на налаштування Gateway не вдався."}},"id":{"stringUnit":{"state":"translated","value":"Permintaan penyiapan Gateway gagal."}},"pl":{"stringUnit":{"state":"translated","value":"Żądanie konfiguracji Gateway nie powiodło się."}},"th":{"stringUnit":{"state":"translated","value":"คำขอตั้งค่า Gateway ล้มเหลว"}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu thiết lập Gateway đã thất bại."}},"nl":{"stringUnit":{"state":"translated","value":"Het verzoek voor Gateway-installatie is mislukt."}},"fa":{"stringUnit":{"state":"translated","value":"درخواست راه‌اندازی Gateway ناموفق بود."}},"ru":{"stringUnit":{"state":"translated","value":"Запрос настройки Gateway не выполнен."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway-konfigurationsbegäran misslyckades."}}}},
    "The Gateway setup request failed. Show details to inspect or copy the error.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway setup request failed. Show details to inspect or copy the error."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Gateway 设置请求失败。显示详情以查看或复制错误。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Gateway 設定請求失敗。顯示詳細資料以檢查或複製錯誤。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A solicitação de configuração do Gateway falhou. Mostre os detalhes para inspecionar ou copiar o erro."}},"de":{"stringUnit":{"state":"translated","value":"Die Gateway-Einrichtungsanfrage ist fehlgeschlagen. Zeigen Sie die Details an, um den Fehler zu prüfen oder zu kopieren."}},"es":{"stringUnit":{"state":"translated","value":"La solicitud de configuración del Gateway falló. Muestra los detalles para inspeccionar o copiar el error."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Gatewayのセットアップリクエストが失敗しました。詳細を表示してエラーを確認またはコピーしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"Gateway 설정 요청이 실패했습니다. 세부 정보를 표시하여 오류를 확인하거나 복사하세요."}},"fr":{"stringUnit":{"state":"translated","value":"La requête de configuration du Gateway a échoué. Affichez les détails pour inspecter ou copier l'erreur."}},"hi":{"stringUnit":{"state":"translated","value":"Gateway सेटअप अनुरोध विफल रहा। त्रुटि का निरीक्षण या कॉपी करने के लिए विवरण दिखाएँ।"}},"ar":{"stringUnit":{"state":"translated","value":"فشل طلب إعداد Gateway. اعرض التفاصيل لفحص الخطأ أو نسخه."}},"it":{"stringUnit":{"state":"translated","value":"La richiesta di configurazione del Gateway non è riuscita. Mostra i dettagli per ispezionare o copiare l'errore."}},"tr":{"stringUnit":{"state":"translated","value":"Gateway kurulum isteği başarısız oldu. Hatayı incelemek veya kopyalamak için ayrıntıları gösterin."}},"uk":{"stringUnit":{"state":"translated","value":"Запит на налаштування Gateway не вдався. Покажіть подробиці, щоб переглянути або скопіювати помилку."}},"id":{"stringUnit":{"state":"translated","value":"Permintaan penyiapan Gateway gagal. Tampilkan detail untuk memeriksa atau menyalin kesalahannya."}},"pl":{"stringUnit":{"state":"translated","value":"Żądanie konfiguracji Gateway nie powiodło się. Pokaż szczegóły, aby sprawdzić lub skopiować błąd."}},"th":{"stringUnit":{"state":"translated","value":"คำขอตั้งค่า Gateway ล้มเหลว แสดงรายละเอียดเพื่อตรวจสอบหรือคัดลอกข้อผิดพลาด"}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu thiết lập Gateway đã thất bại. Hiển thị chi tiết để kiểm tra hoặc sao chép lỗi."}},"nl":{"stringUnit":{"state":"translated","value":"Het verzoek voor Gateway-installatie is mislukt. Toon details om de fout te bekijken of te kopiëren."}},"fa":{"stringUnit":{"state":"translated","value":"درخواست راه‌اندازی Gateway ناموفق بود. برای بررسی یا کپی خطا جزئیات را نمایش دهید."}},"ru":{"stringUnit":{"state":"translated","value":"Запрос настройки Gateway не выполнен. Покажите подробности, чтобы просмотреть или скопировать ошибку."}},"sv":{"stringUnit":{"state":"translated","value":"Gateway-konfigurationsbegäran misslyckades. Visa detaljer för att granska eller kopiera felet."}}}},
    "The Gateway's session routing changed. Start a new message from its current Watch context.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"zh-CN":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"zh-TW":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"pt-BR":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"de":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"es":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"ja-JP":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"ko":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"fr":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"hi":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"ar":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"it":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"tr":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"uk":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"id":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"pl":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"th":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"vi":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"nl":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"fa":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"ru":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}},"sv":{"stringUnit":{"state":"new","value":"The Gateway's session routing changed. Start a new message from its current Watch context."}}}},
    "The Mac node could not be checked.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Mac node could not be checked."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法检查 Mac 节点。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法檢查 Mac 節點。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível verificar o nó do Mac."}},"de":{"stringUnit":{"state":"translated","value":"Der Mac-Knoten konnte nicht überprüft werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo comprobar el nodo Mac."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Macノードを確認できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Mac 노드를 확인할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le nœud Mac n’a pas pu être vérifié."}},"hi":{"stringUnit":{"state":"translated","value":"Mac नोड की जाँच नहीं की जा सकी।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذر التحقق من عقدة Mac."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile verificare il nodo Mac."}},"tr":{"stringUnit":{"state":"translated","value":"Mac düğümü kontrol edilemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося перевірити вузол Mac."}},"id":{"stringUnit":{"state":"translated","value":"Node Mac tidak dapat diperiksa."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się sprawdzić węzła Maca."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถตรวจสอบโหนด Mac ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể kiểm tra nút Mac."}},"nl":{"stringUnit":{"state":"translated","value":"De Mac-node kon niet worden gecontroleerd."}},"fa":{"stringUnit":{"state":"translated","value":"بررسی گره Mac ممکن نبود."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось проверить узел Mac."}},"sv":{"stringUnit":{"state":"translated","value":"Mac-noden kunde inte kontrolleras."}}}},
    "The Mac node did not become ready.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Mac node did not become ready."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Mac 节点未就绪。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Mac 節點未進入就緒狀態。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O nó do Mac não ficou pronto."}},"de":{"stringUnit":{"state":"translated","value":"Der Mac-Knoten wurde nicht betriebsbereit."}},"es":{"stringUnit":{"state":"translated","value":"El nodo de Mac no llegó a estar listo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Mac ノードは準備完了になりませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Mac 노드가 준비 상태가 되지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le nœud Mac n’est pas devenu opérationnel."}},"hi":{"stringUnit":{"state":"translated","value":"Mac नोड तैयार नहीं हुआ।"}},"ar":{"stringUnit":{"state":"translated","value":"لم تصبح عقدة Mac جاهزة."}},"it":{"stringUnit":{"state":"translated","value":"Il nodo Mac non è diventato disponibile."}},"tr":{"stringUnit":{"state":"translated","value":"Mac düğümü hazır duruma gelmedi."}},"uk":{"stringUnit":{"state":"translated","value":"Вузол Mac не перейшов у стан готовності."}},"id":{"stringUnit":{"state":"translated","value":"Node Mac tidak siap."}},"pl":{"stringUnit":{"state":"translated","value":"Węzeł Maca nie osiągnął stanu gotowości."}},"th":{"stringUnit":{"state":"translated","value":"โหนด Mac ไม่พร้อมใช้งาน"}},"vi":{"stringUnit":{"state":"translated","value":"Nút Mac không chuyển sang trạng thái sẵn sàng."}},"nl":{"stringUnit":{"state":"translated","value":"Het Mac-knooppunt is niet gereed geworden."}},"fa":{"stringUnit":{"state":"translated","value":"گره Mac آماده نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Узел Mac не перешёл в состояние готовности."}},"sv":{"stringUnit":{"state":"translated","value":"Mac-noden blev inte klar."}}}},
    "The Mac node did not restart.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The Mac node did not restart."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Mac 节点未重启。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Mac 節點未重新啟動。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O nó do Mac não foi reiniciado."}},"de":{"stringUnit":{"state":"translated","value":"Der Mac-Knoten wurde nicht neu gestartet."}},"es":{"stringUnit":{"state":"translated","value":"El nodo de Mac no se reinició."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Mac ノードは再起動しませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"Mac 노드가 다시 시작되지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le nœud Mac n’a pas redémarré."}},"hi":{"stringUnit":{"state":"translated","value":"Mac नोड पुनः आरंभ नहीं हुआ।"}},"ar":{"stringUnit":{"state":"translated","value":"لم تُعَد تشغيل عقدة Mac."}},"it":{"stringUnit":{"state":"translated","value":"Il nodo Mac non si è riavviato."}},"tr":{"stringUnit":{"state":"translated","value":"Mac düğümü yeniden başlatılmadı."}},"uk":{"stringUnit":{"state":"translated","value":"Вузол Mac не перезапустився."}},"id":{"stringUnit":{"state":"translated","value":"Node Mac tidak dimulai ulang."}},"pl":{"stringUnit":{"state":"translated","value":"Węzeł Maca nie uruchomił się ponownie."}},"th":{"stringUnit":{"state":"translated","value":"โหนด Mac ไม่ได้รีสตาร์ท"}},"vi":{"stringUnit":{"state":"translated","value":"Nút Mac không khởi động lại."}},"nl":{"stringUnit":{"state":"translated","value":"Het Mac-knooppunt is niet opnieuw gestart."}},"fa":{"stringUnit":{"state":"translated","value":"گره Mac راه‌اندازی مجدد نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Узел Mac не перезапустился."}},"sv":{"stringUnit":{"state":"translated","value":"Mac-noden startades inte om."}}}},
    "The OpenClaw Gateway could not be verified. Setup will repair it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The OpenClaw Gateway could not be verified. Setup will repair it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法验证 OpenClaw Gateway。设置将对其进行修复。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法驗證 OpenClaw Gateway。設定將會修復它。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível verificar o OpenClaw Gateway. A configuração irá repará-lo."}},"de":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway konnte nicht verifiziert werden. Die Einrichtung wird ihn reparieren."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo verificar OpenClaw Gateway. La configuración lo reparará."}},"ja-JP":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway を検証できませんでした。セットアップで修復します。"}},"ko":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway를 확인할 수 없습니다. 설정에서 복구합니다."}},"fr":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway n’a pas pu être vérifié. La configuration va le réparer."}},"hi":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway सत्यापित नहीं किया जा सका। सेटअप इसे सुधार देगा।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر التحقق من OpenClaw Gateway. سيقوم الإعداد بإصلاحه."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile verificare OpenClaw Gateway. La configurazione lo riparerà."}},"tr":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway doğrulanamadı. Kurulum bunu onaracak."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося перевірити OpenClaw Gateway. Налаштування відновить його."}},"id":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway tidak dapat diverifikasi. Penyiapan akan memperbaikinya."}},"pl":{"stringUnit":{"state":"translated","value":"Nie można było zweryfikować OpenClaw Gateway. Konfiguracja go naprawi."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถตรวจสอบ OpenClaw Gateway ได้ การตั้งค่าจะซ่อมแซมให้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể xác minh OpenClaw Gateway. Quá trình thiết lập sẽ sửa lỗi này."}},"nl":{"stringUnit":{"state":"translated","value":"De OpenClaw Gateway kon niet worden geverifieerd. De configuratie zal dit herstellen."}},"fa":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway تأیید نشد. راه‌اندازی آن را تعمیر خواهد کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось проверить OpenClaw Gateway. Установка исправит это."}},"sv":{"stringUnit":{"state":"translated","value":"OpenClaw Gateway kunde inte verifieras. Installationen reparerar den."}}}},
    "The WebSocket URL exposed by the remote Gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The WebSocket URL exposed by the remote Gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"远程 Gateway 暴露的 WebSocket URL。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"遠端 Gateway 公開的 WebSocket URL。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A URL do WebSocket exposta pelo Gateway remoto."}},"de":{"stringUnit":{"state":"translated","value":"Die WebSocket-URL, die von der Remote-Gateway bereitgestellt wird."}},"es":{"stringUnit":{"state":"translated","value":"La URL de WebSocket expuesta por el Gateway remoto."}},"ja-JP":{"stringUnit":{"state":"translated","value":"リモート Gateway によって公開される WebSocket URL。"}},"ko":{"stringUnit":{"state":"translated","value":"원격 Gateway에서 노출한 WebSocket URL입니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’URL WebSocket exposée par le Gateway distant."}},"hi":{"stringUnit":{"state":"translated","value":"रिमोट Gateway द्वारा एक्सपोज़ किया गया WebSocket URL."}},"ar":{"stringUnit":{"state":"translated","value":"عنوان URL لـ WebSocket الذي يعرّضه Gateway البعيد."}},"it":{"stringUnit":{"state":"translated","value":"L'URL WebSocket esposto dal Gateway remoto."}},"tr":{"stringUnit":{"state":"translated","value":"Uzak Gateway tarafından sunulan WebSocket URL’si."}},"uk":{"stringUnit":{"state":"translated","value":"URL WebSocket, наданий віддаленим Gateway."}},"id":{"stringUnit":{"state":"translated","value":"URL WebSocket yang diekspos oleh Gateway jarak jauh."}},"pl":{"stringUnit":{"state":"translated","value":"Adres URL WebSocket udostępniany przez zdalny Gateway."}},"th":{"stringUnit":{"state":"translated","value":"URL WebSocket ที่เปิดให้ใช้งานโดย Gateway ระยะไกล"}},"vi":{"stringUnit":{"state":"translated","value":"URL WebSocket được Gateway từ xa hiển thị."}},"nl":{"stringUnit":{"state":"translated","value":"De WebSocket-URL die door de externe Gateway wordt aangeboden."}},"fa":{"stringUnit":{"state":"translated","value":"نشانی WebSocket که توسط Gateway راه‌دور در دسترس قرار گرفته است."}},"ru":{"stringUnit":{"state":"translated","value":"URL WebSocket, предоставляемый удаленным Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"WebSocket-URL:en som exponeras av den fjärranslutna Gateway."}}}},
    "The current gateway.remote.token value is not plain text. OpenClaw for macOS cannot use it directly; enter a plaintext token here to replace it.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The current gateway.remote.token value is not plain text. OpenClaw for macOS cannot use it directly; enter a plaintext token here to replace it."}},"zh-CN":{"stringUnit":{"state":"translated","value":"当前 gateway.remote.token 值不是纯文本。OpenClaw for macOS 无法直接使用它；请在此输入纯文本令牌以替换它。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"目前的 gateway.remote.token 值不是純文字。OpenClaw for macOS 無法直接使用；請在此輸入純文字 token 以取代它。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O valor atual de gateway.remote.token não está em texto simples. O OpenClaw para macOS não pode usá-lo diretamente; insira um token em texto simples aqui para substituí-lo."}},"de":{"stringUnit":{"state":"translated","value":"Der aktuelle Wert von gateway.remote.token ist kein Klartext. OpenClaw für macOS kann ihn nicht direkt verwenden; geben Sie hier ein Klartext-Token ein, um ihn zu ersetzen."}},"es":{"stringUnit":{"state":"translated","value":"El valor actual de gateway.remote.token no es texto sin formato. OpenClaw para macOS no puede usarlo directamente; introduce aquí un token en texto sin formato para reemplazarlo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"現在の gateway.remote.token の値はプレーンテキストではありません。OpenClaw for macOS では直接使用できません。置き換えるには、ここにプレーンテキストのトークンを入力してください。"}},"ko":{"stringUnit":{"state":"translated","value":"현재 gateway.remote.token 값은 일반 텍스트가 아닙니다. macOS용 OpenClaw에서 직접 사용할 수 없으므로, 이를 대체할 일반 텍스트 토큰을 여기에 입력하세요."}},"fr":{"stringUnit":{"state":"translated","value":"La valeur actuelle de gateway.remote.token n’est pas en texte brut. OpenClaw pour macOS ne peut pas l’utiliser directement ; saisissez ici un jeton en texte brut pour la remplacer."}},"hi":{"stringUnit":{"state":"translated","value":"मौजूदा gateway.remote.token मान सादा टेक्स्ट नहीं है. macOS के लिए OpenClaw इसे सीधे उपयोग नहीं कर सकता; इसे बदलने के लिए यहाँ एक plaintext टोकन दर्ज करें."}},"ar":{"stringUnit":{"state":"translated","value":"قيمة gateway.remote.token الحالية ليست نصًا عاديًا. لا يمكن لـ OpenClaw for macOS استخدامها مباشرةً؛ أدخل رمزًا بنص عادي هنا لاستبدالها."}},"it":{"stringUnit":{"state":"translated","value":"Il valore attuale di gateway.remote.token non è in testo normale. OpenClaw per macOS non può usarlo direttamente; inserisci qui un token in testo normale per sostituirlo."}},"tr":{"stringUnit":{"state":"translated","value":"Geçerli gateway.remote.token değeri düz metin değil. macOS için OpenClaw bunu doğrudan kullanamaz; değiştirmek için buraya düz metin bir token girin."}},"uk":{"stringUnit":{"state":"translated","value":"Поточне значення gateway.remote.token не є звичайним текстом. OpenClaw для macOS не може використовувати його напряму; введіть тут токен у вигляді звичайного тексту, щоб замінити його."}},"id":{"stringUnit":{"state":"translated","value":"Nilai gateway.remote.token saat ini bukan teks biasa. OpenClaw for macOS tidak dapat menggunakannya secara langsung; masukkan token teks biasa di sini untuk menggantinya."}},"pl":{"stringUnit":{"state":"translated","value":"Bieżąca wartość gateway.remote.token nie jest tekstem jawnym. OpenClaw dla macOS nie może użyć jej bezpośrednio; wprowadź tutaj token w postaci tekstu jawnego, aby ją zastąpić."}},"th":{"stringUnit":{"state":"translated","value":"ค่า gateway.remote.token ปัจจุบันไม่ใช่ข้อความธรรมดา OpenClaw for macOS ไม่สามารถใช้ค่านี้โดยตรงได้ โปรดป้อนโทเค็นแบบ plaintext ที่นี่เพื่อแทนที่"}},"vi":{"stringUnit":{"state":"translated","value":"Giá trị gateway.remote.token hiện tại không phải là văn bản thuần túy. OpenClaw for macOS không thể sử dụng trực tiếp; hãy nhập token dạng văn bản thuần túy tại đây để thay thế."}},"nl":{"stringUnit":{"state":"translated","value":"De huidige waarde van gateway.remote.token is geen platte tekst. OpenClaw voor macOS kan deze niet rechtstreeks gebruiken; voer hier een plaintext-token in om deze te vervangen."}},"fa":{"stringUnit":{"state":"translated","value":"مقدار فعلی gateway.remote.token متن ساده نیست. OpenClaw برای macOS نمی‌تواند مستقیماً از آن استفاده کند؛ برای جایگزینی، یک توکن متن ساده را اینجا وارد کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Текущее значение gateway.remote.token не является обычным текстом. OpenClaw для macOS не может использовать его напрямую; введите здесь токен в виде обычного текста, чтобы заменить его."}},"sv":{"stringUnit":{"state":"translated","value":"Det aktuella värdet för gateway.remote.token är inte klartext. OpenClaw för macOS kan inte använda det direkt; ange en klartexttoken här för att ersätta det."}}}},
    "The details are listed on each option above. You can fix the login and retry, or connect with an API key or token below.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The details are listed on each option above. You can fix the login and retry, or connect with an API key or token below."}},"zh-CN":{"stringUnit":{"state":"translated","value":"详细信息列在上方每个选项中。你可以修正登录信息后重试，或在下方使用 API 密钥或令牌连接。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"詳細資訊列在上方每個選項中。您可以修正登入資訊後重試，或使用下方的 API 金鑰或權杖連接。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os detalhes estão listados em cada opção acima. Você pode corrigir o login e tentar de novo, ou conectar com uma chave de API ou token abaixo."}},"de":{"stringUnit":{"state":"translated","value":"Die Details sind bei jeder Option oben aufgeführt. Du kannst die Anmeldung korrigieren und es erneut versuchen oder dich unten mit einem API-Schlüssel oder Token verbinden."}},"es":{"stringUnit":{"state":"translated","value":"Los detalles se muestran en cada opción de arriba. Puedes corregir el inicio de sesión y reintentar, o conectarte con una clave de API o token a continuación."}},"ja-JP":{"stringUnit":{"state":"translated","value":"詳細は上記の各オプションに記載されています。ログインを修正して再試行するか、下記の API キーまたはトークンで接続できます。"}},"ko":{"stringUnit":{"state":"translated","value":"자세한 내용은 위 각 옵션에 표시되어 있습니다. 로그인을 수정한 후 다시 시도하거나, 아래에서 API 키 또는 토큰으로 연결할 수 있습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les détails sont indiqués pour chaque option ci-dessus. Vous pouvez corriger la connexion et réessayer, ou vous connecter avec une clé API ou un jeton ci-dessous."}},"hi":{"stringUnit":{"state":"translated","value":"विवरण ऊपर प्रत्येक विकल्प पर सूचीबद्ध हैं। आप लॉगिन ठीक करके फिर से प्रयास कर सकते हैं, या नीचे API key या token से कनेक्ट कर सकते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"التفاصيل مدرجة على كل خيار أعلاه. يمكنك إصلاح تسجيل الدخول وإعادة المحاولة، أو الاتصال باستخدام مفتاح API أو رمز مميز أدناه."}},"it":{"stringUnit":{"state":"translated","value":"I dettagli sono elencati per ciascuna opzione qui sopra. Puoi correggere l'accesso e riprovare, oppure connetterti con una chiave API o un token qui sotto."}},"tr":{"stringUnit":{"state":"translated","value":"Ayrıntılar yukarıdaki her seçenekte listeleniyor. Girişi düzeltip yeniden deneyebilir veya aşağıda bir API anahtarı ya da token ile bağlanabilirsiniz."}},"uk":{"stringUnit":{"state":"translated","value":"Деталі наведено для кожного варіанта вище. Ви можете виправити вхід і повторити спробу або підключитися за допомогою ключа API чи токена нижче."}},"id":{"stringUnit":{"state":"translated","value":"Detailnya tercantum pada setiap opsi di atas. Anda dapat memperbaiki login dan mencoba lagi, atau terhubung dengan kunci API atau token di bawah."}},"pl":{"stringUnit":{"state":"translated","value":"Szczegóły są wymienione przy każdej opcji powyżej. Możesz poprawić logowanie i spróbować ponownie lub połączyć się za pomocą klucza API albo tokena poniżej."}},"th":{"stringUnit":{"state":"translated","value":"รายละเอียดแสดงอยู่ในแต่ละตัวเลือกด้านบน คุณสามารถแก้ไขการเข้าสู่ระบบและลองใหม่ หรือเชื่อมต่อด้วย API key หรือโทเค็นด้านล่าง"}},"vi":{"stringUnit":{"state":"translated","value":"Chi tiết được liệt kê ở mỗi tùy chọn phía trên. Bạn có thể sửa đăng nhập rồi thử lại, hoặc kết nối bằng khóa API hoặc token bên dưới."}},"nl":{"stringUnit":{"state":"translated","value":"De details staan bij elke optie hierboven. Je kunt de login herstellen en opnieuw proberen, of hieronder verbinden met een API-sleutel of token."}},"fa":{"stringUnit":{"state":"translated","value":"جزئیات هر گزینه در بالا فهرست شده است. می‌توانید ورود را اصلاح کرده و دوباره تلاش کنید، یا با کلید API یا توکن در پایین متصل شوید."}},"ru":{"stringUnit":{"state":"translated","value":"Подробности указаны для каждого варианта выше. Вы можете исправить вход и повторить попытку или подключиться с помощью API-ключа или токена ниже."}},"sv":{"stringUnit":{"state":"translated","value":"Detaljerna listas för varje alternativ ovan. Du kan åtgärda inloggningen och försöka igen, eller ansluta med en API-nyckel eller token nedan."}}}},
    "The earlier conversation was cleared.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The earlier conversation was cleared."}},"zh-CN":{"stringUnit":{"state":"translated","value":"先前的对话已被清除。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"先前的對話已清除。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conversa anterior foi apagada."}},"de":{"stringUnit":{"state":"translated","value":"Die vorherige Konversation wurde gelöscht."}},"es":{"stringUnit":{"state":"translated","value":"Se borró la conversación anterior."}},"ja-JP":{"stringUnit":{"state":"translated","value":"以前の会話はクリアされました。"}},"ko":{"stringUnit":{"state":"translated","value":"이전 대화가 지워졌습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La conversation précédente a été effacée."}},"hi":{"stringUnit":{"state":"translated","value":"पिछली बातचीत साफ़ कर दी गई थी।"}},"ar":{"stringUnit":{"state":"translated","value":"تم مسح المحادثة السابقة."}},"it":{"stringUnit":{"state":"translated","value":"La conversazione precedente è stata cancellata."}},"tr":{"stringUnit":{"state":"translated","value":"Önceki konuşma temizlendi."}},"uk":{"stringUnit":{"state":"translated","value":"Попередню розмову очищено."}},"id":{"stringUnit":{"state":"translated","value":"Percakapan sebelumnya telah dihapus."}},"pl":{"stringUnit":{"state":"translated","value":"Wcześniejsza rozmowa została wyczyszczona."}},"th":{"stringUnit":{"state":"translated","value":"บทสนทนาก่อนหน้าถูกล้างแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Cuộc trò chuyện trước đó đã được xóa."}},"nl":{"stringUnit":{"state":"translated","value":"Het eerdere gesprek is gewist."}},"fa":{"stringUnit":{"state":"translated","value":"گفتگوی قبلی پاک شد."}},"ru":{"stringUnit":{"state":"translated","value":"Предыдущий разговор был очищен."}},"sv":{"stringUnit":{"state":"translated","value":"Den tidigare konversationen rensades."}}}},
    "The full message could not be loaded.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The full message could not be loaded."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法加载完整消息。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法載入完整訊息。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível carregar a mensagem completa."}},"de":{"stringUnit":{"state":"translated","value":"Die vollständige Nachricht konnte nicht geladen werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo cargar el mensaje completo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メッセージ全文を読み込めませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"전체 메시지를 불러올 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le message complet n’a pas pu être chargé."}},"hi":{"stringUnit":{"state":"translated","value":"पूरा संदेश लोड नहीं किया जा सका।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر تحميل الرسالة الكاملة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile caricare il messaggio completo."}},"tr":{"stringUnit":{"state":"translated","value":"Tam ileti yüklenemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося завантажити повне повідомлення."}},"id":{"stringUnit":{"state":"translated","value":"Pesan lengkap tidak dapat dimuat."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się wczytać pełnej wiadomości."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถโหลดข้อความฉบับเต็มได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể tải toàn bộ tin nhắn."}},"nl":{"stringUnit":{"state":"translated","value":"Het volledige bericht kon niet worden geladen."}},"fa":{"stringUnit":{"state":"translated","value":"پیام کامل بارگذاری نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось загрузить полное сообщение."}},"sv":{"stringUnit":{"state":"translated","value":"Det gick inte att läsa in hela meddelandet."}}}},
    "The full message has no readable text.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The full message has no readable text."}},"zh-CN":{"stringUnit":{"state":"translated","value":"完整消息中没有可读文本。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"完整訊息中沒有可讀取的文字。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A mensagem completa não contém texto legível."}},"de":{"stringUnit":{"state":"translated","value":"Die vollständige Nachricht enthält keinen lesbaren Text."}},"es":{"stringUnit":{"state":"translated","value":"El mensaje completo no contiene texto legible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メッセージ全文に読み取れるテキストがありません。"}},"ko":{"stringUnit":{"state":"translated","value":"전체 메시지에 읽을 수 있는 텍스트가 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le message complet ne contient aucun texte lisible."}},"hi":{"stringUnit":{"state":"translated","value":"पूरे संदेश में पढ़ने योग्य कोई टेक्स्ट नहीं है।"}},"ar":{"stringUnit":{"state":"translated","value":"لا تحتوي الرسالة الكاملة على نص قابل للقراءة."}},"it":{"stringUnit":{"state":"translated","value":"Il messaggio completo non contiene testo leggibile."}},"tr":{"stringUnit":{"state":"translated","value":"Tam iletide okunabilir metin yok."}},"uk":{"stringUnit":{"state":"translated","value":"Повне повідомлення не містить тексту, який можна прочитати."}},"id":{"stringUnit":{"state":"translated","value":"Pesan lengkap tidak memiliki teks yang dapat dibaca."}},"pl":{"stringUnit":{"state":"translated","value":"Pełna wiadomość nie zawiera tekstu możliwego do odczytania."}},"th":{"stringUnit":{"state":"translated","value":"ข้อความฉบับเต็มไม่มีข้อความที่อ่านได้"}},"vi":{"stringUnit":{"state":"translated","value":"Toàn bộ tin nhắn không có văn bản có thể đọc được."}},"nl":{"stringUnit":{"state":"translated","value":"Het volledige bericht bevat geen leesbare tekst."}},"fa":{"stringUnit":{"state":"translated","value":"پیام کامل متن خوانایی ندارد."}},"ru":{"stringUnit":{"state":"translated","value":"В полном сообщении нет читаемого текста."}},"sv":{"stringUnit":{"state":"translated","value":"Hela meddelandet saknar läsbar text."}}}},
    "The full message is no longer available.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The full message is no longer available."}},"zh-CN":{"stringUnit":{"state":"translated","value":"完整消息已不再可用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"完整訊息已無法取得。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A mensagem completa não está mais disponível."}},"de":{"stringUnit":{"state":"translated","value":"Die vollständige Nachricht ist nicht mehr verfügbar."}},"es":{"stringUnit":{"state":"translated","value":"El mensaje completo ya no está disponible."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メッセージ全文は利用できなくなりました。"}},"ko":{"stringUnit":{"state":"translated","value":"전체 메시지를 더 이상 사용할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le message complet n’est plus disponible."}},"hi":{"stringUnit":{"state":"translated","value":"पूरा संदेश अब उपलब्ध नहीं है।"}},"ar":{"stringUnit":{"state":"translated","value":"لم تعد الرسالة الكاملة متاحة."}},"it":{"stringUnit":{"state":"translated","value":"Il messaggio completo non è più disponibile."}},"tr":{"stringUnit":{"state":"translated","value":"Tam ileti artık kullanılamıyor."}},"uk":{"stringUnit":{"state":"translated","value":"Повне повідомлення більше недоступне."}},"id":{"stringUnit":{"state":"translated","value":"Pesan lengkap sudah tidak tersedia."}},"pl":{"stringUnit":{"state":"translated","value":"Pełna wiadomość nie jest już dostępna."}},"th":{"stringUnit":{"state":"translated","value":"ข้อความฉบับเต็มไม่พร้อมใช้งานแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Toàn bộ tin nhắn không còn khả dụng."}},"nl":{"stringUnit":{"state":"translated","value":"Het volledige bericht is niet meer beschikbaar."}},"fa":{"stringUnit":{"state":"translated","value":"پیام کامل دیگر در دسترس نیست."}},"ru":{"stringUnit":{"state":"translated","value":"Полное сообщение больше недоступно."}},"sv":{"stringUnit":{"state":"translated","value":"Hela meddelandet är inte längre tillgängligt."}}}},
    "The main thread cannot be deleted.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The main thread cannot be deleted."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法删除主话题串。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法刪除主要討論串。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conversa principal não pode ser excluída."}},"de":{"stringUnit":{"state":"translated","value":"Der Haupt-Thread kann nicht gelöscht werden."}},"es":{"stringUnit":{"state":"translated","value":"El hilo principal no se puede eliminar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"メインスレッドは削除できません。"}},"ko":{"stringUnit":{"state":"translated","value":"메인 스레드는 삭제할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le fil de discussion principal ne peut pas être supprimé."}},"hi":{"stringUnit":{"state":"translated","value":"मुख्य थ्रेड को डिलीट नहीं किया जा सकता।"}},"ar":{"stringUnit":{"state":"translated","value":"لا يمكن حذف المحادثة الرئيسية."}},"it":{"stringUnit":{"state":"translated","value":"Il thread principale non può essere eliminato."}},"tr":{"stringUnit":{"state":"translated","value":"Ana dizi silinemez."}},"uk":{"stringUnit":{"state":"translated","value":"Основну гілку не можна видалити."}},"id":{"stringUnit":{"state":"translated","value":"Utas utama tidak dapat dihapus."}},"pl":{"stringUnit":{"state":"translated","value":"Nie można usunąć głównego wątku."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถลบเธรดหลักได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể xóa chuỗi chính."}},"nl":{"stringUnit":{"state":"translated","value":"Het hoofdgesprek kan niet worden verwijderd."}},"fa":{"stringUnit":{"state":"translated","value":"رشته اصلی را نمی‌توان حذف کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Основную ветку нельзя удалить."}},"sv":{"stringUnit":{"state":"translated","value":"Huvudtråden kan inte raderas."}}}},
    "The managed OpenClaw runtime could not be reinstalled.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The managed OpenClaw runtime could not be reinstalled."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法重新安装由 OpenClaw 管理的运行时。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法重新安裝由 OpenClaw 管理的執行環境。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível reinstalar o ambiente de execução gerenciado do OpenClaw."}},"de":{"stringUnit":{"state":"translated","value":"Die verwaltete OpenClaw-Laufzeitumgebung konnte nicht neu installiert werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo reinstalar el entorno de ejecución administrado de OpenClaw."}},"ja-JP":{"stringUnit":{"state":"translated","value":"管理対象のOpenClawランタイムを再インストールできませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"관리형 OpenClaw 런타임을 다시 설치할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’environnement d’exécution OpenClaw géré n’a pas pu être réinstallé."}},"hi":{"stringUnit":{"state":"translated","value":"प्रबंधित OpenClaw रनटाइम को फिर से इंस्टॉल नहीं किया जा सका।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذرت إعادة تثبيت بيئة تشغيل OpenClaw المُدارة."}},"it":{"stringUnit":{"state":"translated","value":"Non è stato possibile reinstallare il runtime OpenClaw gestito."}},"tr":{"stringUnit":{"state":"translated","value":"Yönetilen OpenClaw çalışma zamanı yeniden yüklenemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося повторно встановити кероване середовище виконання OpenClaw."}},"id":{"stringUnit":{"state":"translated","value":"Runtime OpenClaw terkelola tidak dapat diinstal ulang."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się ponownie zainstalować zarządzanego środowiska uruchomieniowego OpenClaw."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถติดตั้งรันไทม์ OpenClaw ที่มีการจัดการใหม่ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể cài đặt lại môi trường chạy OpenClaw được quản lý."}},"nl":{"stringUnit":{"state":"translated","value":"De beheerde OpenClaw-runtime kon niet opnieuw worden geïnstalleerd."}},"fa":{"stringUnit":{"state":"translated","value":"نصب مجدد محیط اجرای مدیریت‌شده OpenClaw ممکن نبود."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось переустановить управляемую среду выполнения OpenClaw."}},"sv":{"stringUnit":{"state":"translated","value":"Den hanterade OpenClaw-körmiljön kunde inte installeras om."}}}},
    "The managed runtime does not match the updated Mac app.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The managed runtime does not match the updated Mac app."}},"zh-CN":{"stringUnit":{"state":"translated","value":"托管运行时与更新后的 Mac 应用不匹配。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"受管理的執行階段與更新後的 Mac App 不相符。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O ambiente de execução gerenciado não corresponde ao aplicativo para Mac atualizado."}},"de":{"stringUnit":{"state":"translated","value":"Die verwaltete Laufzeitumgebung stimmt nicht mit der aktualisierten Mac-App überein."}},"es":{"stringUnit":{"state":"translated","value":"El entorno de ejecución administrado no coincide con la app para Mac actualizada."}},"ja-JP":{"stringUnit":{"state":"translated","value":"管理対象ランタイムが更新後の Mac アプリと一致しません。"}},"ko":{"stringUnit":{"state":"translated","value":"관리형 런타임이 업데이트된 Mac 앱과 일치하지 않습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’environnement d’exécution géré ne correspond pas à l’app Mac mise à jour."}},"hi":{"stringUnit":{"state":"translated","value":"प्रबंधित रनटाइम अपडेट किए गए Mac ऐप से मेल नहीं खाता।"}},"ar":{"stringUnit":{"state":"translated","value":"لا تتطابق بيئة التشغيل المُدارة مع تطبيق Mac المحدّث."}},"it":{"stringUnit":{"state":"translated","value":"Il runtime gestito non corrisponde all'app per Mac aggiornata."}},"tr":{"stringUnit":{"state":"translated","value":"Yönetilen çalışma zamanı, güncellenmiş Mac uygulamasıyla eşleşmiyor."}},"uk":{"stringUnit":{"state":"translated","value":"Кероване середовище виконання не відповідає оновленій програмі для Mac."}},"id":{"stringUnit":{"state":"translated","value":"Runtime terkelola tidak cocok dengan aplikasi Mac yang diperbarui."}},"pl":{"stringUnit":{"state":"translated","value":"Zarządzane środowisko uruchomieniowe nie jest zgodne ze zaktualizowaną aplikacją na Maca."}},"th":{"stringUnit":{"state":"translated","value":"รันไทม์ที่มีการจัดการไม่ตรงกับแอป Mac ที่อัปเดตแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Môi trường thực thi được quản lý không khớp với ứng dụng Mac đã cập nhật."}},"nl":{"stringUnit":{"state":"translated","value":"De beheerde runtime komt niet overeen met de bijgewerkte Mac-app."}},"fa":{"stringUnit":{"state":"translated","value":"محیط اجرای مدیریت‌شده با برنامه به‌روزشده Mac مطابقت ندارد."}},"ru":{"stringUnit":{"state":"translated","value":"Управляемая среда выполнения не соответствует обновлённому приложению для Mac."}},"sv":{"stringUnit":{"state":"translated","value":"Den hanterade körningsmiljön matchar inte den uppdaterade Mac-appen."}}}},
    "The node service restarted but did not remain running.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The node service restarted but did not remain running."}},"zh-CN":{"stringUnit":{"state":"translated","value":"节点服务已重启，但未能保持运行。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"節點服務已重新啟動，但未持續執行。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O serviço do nó foi reiniciado, mas não permaneceu em execução."}},"de":{"stringUnit":{"state":"translated","value":"Der Knotendienst wurde neu gestartet, lief aber nicht weiter."}},"es":{"stringUnit":{"state":"translated","value":"El servicio del nodo se reinició, pero no siguió ejecutándose."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ノードサービスは再起動しましたが、実行状態を維持できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"노드 서비스가 다시 시작되었지만 실행 상태를 유지하지 못했습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le service du nœud a redémarré, mais ne s’est pas maintenu en fonctionnement."}},"hi":{"stringUnit":{"state":"translated","value":"नोड सेवा पुनः आरंभ हुई, लेकिन चलती नहीं रही।"}},"ar":{"stringUnit":{"state":"translated","value":"أُعيد تشغيل خدمة العقدة، لكنها لم تستمر في العمل."}},"it":{"stringUnit":{"state":"translated","value":"Il servizio del nodo è stato riavviato, ma non è rimasto in esecuzione."}},"tr":{"stringUnit":{"state":"translated","value":"Düğüm hizmeti yeniden başlatıldı ancak çalışmaya devam etmedi."}},"uk":{"stringUnit":{"state":"translated","value":"Служба вузла перезапустилася, але не продовжила роботу."}},"id":{"stringUnit":{"state":"translated","value":"Layanan node dimulai ulang tetapi tidak tetap berjalan."}},"pl":{"stringUnit":{"state":"translated","value":"Usługa węzła uruchomiła się ponownie, ale nie pozostała aktywna."}},"th":{"stringUnit":{"state":"translated","value":"บริการโหนดรีสตาร์ทแล้ว แต่ไม่ได้ทำงานต่อเนื่อง"}},"vi":{"stringUnit":{"state":"translated","value":"Dịch vụ nút đã khởi động lại nhưng không tiếp tục chạy."}},"nl":{"stringUnit":{"state":"translated","value":"De knooppuntservice is opnieuw gestart, maar bleef niet actief."}},"fa":{"stringUnit":{"state":"translated","value":"سرویس گره راه‌اندازی مجدد شد، اما در حال اجرا باقی نماند."}},"ru":{"stringUnit":{"state":"translated","value":"Служба узла перезапустилась, но не продолжила работу."}},"sv":{"stringUnit":{"state":"translated","value":"Nodtjänsten startades om men fortsatte inte att köras."}}}},
    "The notification request was queued.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The notification request was queued."}},"zh-CN":{"stringUnit":{"state":"translated","value":"通知请求已加入队列。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"通知請求已排入佇列。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A solicitação de notificação foi enfileirada."}},"de":{"stringUnit":{"state":"translated","value":"Die Benachrichtigungsanfrage wurde in die Warteschlange gestellt."}},"es":{"stringUnit":{"state":"translated","value":"La solicitud de notificación se puso en cola."}},"ja-JP":{"stringUnit":{"state":"translated","value":"通知リクエストをキューに追加しました。"}},"ko":{"stringUnit":{"state":"translated","value":"알림 요청이 대기열에 추가되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La demande de notification a été mise en file d'attente."}},"hi":{"stringUnit":{"state":"translated","value":"सूचना अनुरोध कतार में लगा दिया गया।"}},"ar":{"stringUnit":{"state":"translated","value":"تمت إضافة طلب الإشعار إلى قائمة الانتظار."}},"it":{"stringUnit":{"state":"translated","value":"La richiesta di notifica è stata messa in coda."}},"tr":{"stringUnit":{"state":"translated","value":"Bildirim isteği sıraya alındı."}},"uk":{"stringUnit":{"state":"translated","value":"Запит на сповіщення додано в чергу."}},"id":{"stringUnit":{"state":"translated","value":"Permintaan notifikasi telah diantrekan."}},"pl":{"stringUnit":{"state":"translated","value":"Żądanie powiadomienia zostało dodane do kolejki."}},"th":{"stringUnit":{"state":"translated","value":"คำขอการแจ้งเตือนถูกจัดคิวแล้ว"}},"vi":{"stringUnit":{"state":"translated","value":"Yêu cầu thông báo đã được xếp hàng."}},"nl":{"stringUnit":{"state":"translated","value":"Het meldingsverzoek is in de wachtrij geplaatst."}},"fa":{"stringUnit":{"state":"translated","value":"درخواست اعلان در صف قرار گرفت."}},"ru":{"stringUnit":{"state":"translated","value":"Запрос уведомления поставлен в очередь."}},"sv":{"stringUnit":{"state":"translated","value":"Aviseringsbegäran köades."}}}},
    "The remote Gateway is older than this Mac app, so OpenClaw skipped the agent notification.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The remote Gateway is older than this Mac app, so OpenClaw skipped the agent notification."}},"zh-CN":{"stringUnit":{"state":"translated","value":"远程 Gateway 的版本低于此 Mac 应用，因此 OpenClaw 跳过了智能体通知。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"遠端 Gateway 的版本比此 Mac App 舊，因此 OpenClaw 已略過代理程式通知。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway remoto é mais antigo que este aplicativo para Mac, então o OpenClaw ignorou a notificação do agente."}},"de":{"stringUnit":{"state":"translated","value":"Das Remote-Gateway ist älter als diese Mac-App, daher hat OpenClaw die Agentenbenachrichtigung übersprungen."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway remoto es más antiguo que esta app para Mac, por lo que OpenClaw omitió la notificación del agente."}},"ja-JP":{"stringUnit":{"state":"translated","value":"リモートの Gateway がこの Mac アプリより古いため、OpenClaw はエージェントへの通知をスキップしました。"}},"ko":{"stringUnit":{"state":"translated","value":"원격 Gateway가 이 Mac 앱보다 오래된 버전이므로 OpenClaw에서 에이전트 알림을 건너뛰었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway distant est plus ancien que cette app Mac. OpenClaw a donc ignoré la notification de l’agent."}},"hi":{"stringUnit":{"state":"translated","value":"रिमोट Gateway इस Mac ऐप से पुराना है, इसलिए OpenClaw ने एजेंट की सूचना छोड़ दी।"}},"ar":{"stringUnit":{"state":"translated","value":"إصدار Gateway البعيد أقدم من تطبيق Mac هذا، لذا تخطّى OpenClaw إشعار الوكيل."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway remoto è meno recente di questa app per Mac, quindi OpenClaw ha ignorato la notifica dell'agente."}},"tr":{"stringUnit":{"state":"translated","value":"Uzak Gateway bu Mac uygulamasından daha eski olduğu için OpenClaw aracı bildirimini atladı."}},"uk":{"stringUnit":{"state":"translated","value":"Віддалений Gateway старіший за цю програму для Mac, тому OpenClaw пропустив сповіщення агента."}},"id":{"stringUnit":{"state":"translated","value":"Gateway jarak jauh lebih lama daripada aplikasi Mac ini, sehingga OpenClaw melewati notifikasi agen."}},"pl":{"stringUnit":{"state":"translated","value":"Zdalny Gateway jest starszy niż ta aplikacja na Maca, dlatego OpenClaw pominął powiadomienie agenta."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ระยะไกลเก่ากว่าแอป Mac นี้ ดังนั้น OpenClaw จึงข้ามการแจ้งเตือนเอเจนต์"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway từ xa cũ hơn ứng dụng Mac này, nên OpenClaw đã bỏ qua thông báo cho tác tử."}},"nl":{"stringUnit":{"state":"translated","value":"De externe Gateway is ouder dan deze Mac-app, dus OpenClaw heeft de agentmelding overgeslagen."}},"fa":{"stringUnit":{"state":"translated","value":"نسخه Gateway راه‌دور قدیمی‌تر از این برنامه Mac است، بنابراین OpenClaw از اعلان عامل صرف‌نظر کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Удалённый Gateway старше этого приложения для Mac, поэтому OpenClaw пропустил уведомление агента."}},"sv":{"stringUnit":{"state":"translated","value":"Fjärr-Gateway är äldre än den här Mac-appen, så OpenClaw hoppade över agentaviseringen."}}}},
    "The selected Gateway changed.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The selected Gateway changed."}},"zh-CN":{"stringUnit":{"state":"translated","value":"所选的 Gateway 已更改。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"所選的 Gateway 已變更。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O Gateway selecionado foi alterado."}},"de":{"stringUnit":{"state":"translated","value":"Das ausgewählte Gateway wurde geändert."}},"es":{"stringUnit":{"state":"translated","value":"El Gateway seleccionado ha cambiado."}},"ja-JP":{"stringUnit":{"state":"translated","value":"選択された Gateway が変更されました。"}},"ko":{"stringUnit":{"state":"translated","value":"선택한 Gateway가 변경되었습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le Gateway sélectionné a changé."}},"hi":{"stringUnit":{"state":"translated","value":"चयनित Gateway बदल गया।"}},"ar":{"stringUnit":{"state":"translated","value":"تغيّر Gateway المحدد."}},"it":{"stringUnit":{"state":"translated","value":"Il Gateway selezionato è cambiato."}},"tr":{"stringUnit":{"state":"translated","value":"Seçili Gateway değişti."}},"uk":{"stringUnit":{"state":"translated","value":"Вибраний Gateway змінився."}},"id":{"stringUnit":{"state":"translated","value":"Gateway yang dipilih berubah."}},"pl":{"stringUnit":{"state":"translated","value":"Wybrany Gateway uległ zmianie."}},"th":{"stringUnit":{"state":"translated","value":"Gateway ที่เลือกมีการเปลี่ยนแปลง"}},"vi":{"stringUnit":{"state":"translated","value":"Gateway đã chọn đã thay đổi."}},"nl":{"stringUnit":{"state":"translated","value":"De geselecteerde Gateway is gewijzigd."}},"fa":{"stringUnit":{"state":"translated","value":"Gateway انتخاب‌شده تغییر کرد."}},"ru":{"stringUnit":{"state":"translated","value":"Выбранный Gateway изменился."}},"sv":{"stringUnit":{"state":"translated","value":"Den valda Gateway ändrades."}}}},
    "The thread and its transcript are removed from the gateway.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The thread and its transcript are removed from the gateway."}},"zh-CN":{"stringUnit":{"state":"translated","value":"该话题及其对话记录将从 Gateway 中移除。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"對話串及其文字記錄將從 Gateway 中移除。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A conversa e sua transcrição são removidas do Gateway."}},"de":{"stringUnit":{"state":"translated","value":"Der Thread und sein Transkript werden aus dem Gateway entfernt."}},"es":{"stringUnit":{"state":"translated","value":"El hilo y su transcripción se eliminan del Gateway."}},"ja-JP":{"stringUnit":{"state":"translated","value":"スレッドとそのトランスクリプトがGatewayから削除されます。"}},"ko":{"stringUnit":{"state":"translated","value":"스레드와 대화 기록이 Gateway에서 삭제됩니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le fil et sa transcription sont supprimés du Gateway."}},"hi":{"stringUnit":{"state":"translated","value":"थ्रेड और उसकी ट्रांसक्रिप्ट Gateway से हटा दिए जाते हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"تُزال سلسلة المحادثة ونصها من Gateway."}},"it":{"stringUnit":{"state":"translated","value":"La conversazione e la relativa trascrizione vengono rimosse dal Gateway."}},"tr":{"stringUnit":{"state":"translated","value":"İleti dizisi ve dökümü gateway'den kaldırılır."}},"uk":{"stringUnit":{"state":"translated","value":"Гілку та її стенограму буде видалено з Gateway."}},"id":{"stringUnit":{"state":"translated","value":"Utas dan transkripnya dihapus dari gateway."}},"pl":{"stringUnit":{"state":"translated","value":"Wątek i jego transkrypcja zostaną usunięte z Gateway."}},"th":{"stringUnit":{"state":"translated","value":"เธรดและบทถอดเสียงจะถูกนำออกจาก Gateway"}},"vi":{"stringUnit":{"state":"translated","value":"Luồng và bản ghi của luồng sẽ bị xóa khỏi gateway."}},"nl":{"stringUnit":{"state":"translated","value":"De thread en het transcript ervan worden uit de Gateway verwijderd."}},"fa":{"stringUnit":{"state":"translated","value":"رشته و رونوشت آن از Gateway حذف می‌شوند."}},"ru":{"stringUnit":{"state":"translated","value":"Ветка и её расшифровка будут удалены из Gateway."}},"sv":{"stringUnit":{"state":"translated","value":"Tråden och dess transkript tas bort från gatewayen."}}}},
    "The thread could not be created.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The thread could not be created."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法创建话题。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法建立對話串。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível criar a conversa."}},"de":{"stringUnit":{"state":"translated","value":"Der Thread konnte nicht erstellt werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo crear el hilo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"スレッドを作成できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"스레드를 생성할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Le fil n’a pas pu être créé."}},"hi":{"stringUnit":{"state":"translated","value":"थ्रेड नहीं बनाया जा सका।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذّر إنشاء سلسلة المحادثة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile creare la conversazione."}},"tr":{"stringUnit":{"state":"translated","value":"İleti dizisi oluşturulamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося створити гілку."}},"id":{"stringUnit":{"state":"translated","value":"Utas tidak dapat dibuat."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się utworzyć wątku."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถสร้างเธรดได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể tạo luồng."}},"nl":{"stringUnit":{"state":"translated","value":"De thread kon niet worden aangemaakt."}},"fa":{"stringUnit":{"state":"translated","value":"رشته ایجاد نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось создать ветку."}},"sv":{"stringUnit":{"state":"translated","value":"Det gick inte att skapa tråden."}}}},
    "The update is installed, but Gateway health did not become ready.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The update is installed, but Gateway health did not become ready."}},"zh-CN":{"stringUnit":{"state":"translated","value":"更新已安装，但 Gateway 健康状态未就绪。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"更新已安裝，但 Gateway 健康狀態未進入就緒狀態。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"A atualização está instalada, mas o Gateway não ficou pronto."}},"de":{"stringUnit":{"state":"translated","value":"Das Update ist installiert, aber der Gateway-Status wurde nicht betriebsbereit."}},"es":{"stringUnit":{"state":"translated","value":"La actualización está instalada, pero el estado del Gateway no llegó a estar listo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"アップデートはインストールされましたが、Gateway のヘルスチェックは準備完了になりませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"업데이트가 설치되었지만 Gateway 상태가 준비 상태가 되지 않았습니다."}},"fr":{"stringUnit":{"state":"translated","value":"La mise à jour est installée, mais le Gateway n’est pas devenu opérationnel."}},"hi":{"stringUnit":{"state":"translated","value":"अपडेट इंस्टॉल हो गया है, लेकिन Gateway की स्थिति तैयार नहीं हुई।"}},"ar":{"stringUnit":{"state":"translated","value":"تم تثبيت التحديث، لكن حالة Gateway لم تصبح جاهزة."}},"it":{"stringUnit":{"state":"translated","value":"L'aggiornamento è installato, ma lo stato del Gateway non è diventato operativo."}},"tr":{"stringUnit":{"state":"translated","value":"Güncelleme yüklendi ancak Gateway sistem durumu hazır hâle gelmedi."}},"uk":{"stringUnit":{"state":"translated","value":"Оновлення встановлено, але перевірка стану Gateway не показала готовності."}},"id":{"stringUnit":{"state":"translated","value":"Pembaruan telah diinstal, tetapi status kesehatan Gateway tidak menjadi siap."}},"pl":{"stringUnit":{"state":"translated","value":"Aktualizacja została zainstalowana, ale stan kondycji Gateway nie osiągnął gotowości."}},"th":{"stringUnit":{"state":"translated","value":"ติดตั้งการอัปเดตแล้ว แต่สถานะความพร้อมของ Gateway ยังไม่พร้อม"}},"vi":{"stringUnit":{"state":"translated","value":"Bản cập nhật đã được cài đặt, nhưng trạng thái hoạt động của Gateway chưa chuyển sang sẵn sàng."}},"nl":{"stringUnit":{"state":"translated","value":"De update is geïnstalleerd, maar de status van de Gateway is niet gereed geworden."}},"fa":{"stringUnit":{"state":"translated","value":"به‌روزرسانی نصب شده است، اما وضعیت سلامت Gateway آماده نشد."}},"ru":{"stringUnit":{"state":"translated","value":"Обновление установлено, но Gateway не перешёл в состояние готовности."}},"sv":{"stringUnit":{"state":"translated","value":"Uppdateringen är installerad, men Gateway blev inte driftklar."}}}},
    "The widget image could not be captured.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The widget image could not be captured."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法截取小组件图像。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法擷取小工具影像。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível capturar a imagem do widget."}},"de":{"stringUnit":{"state":"translated","value":"Das Widget-Bild konnte nicht erfasst werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo capturar la imagen del widget."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウィジェットの画像をキャプチャできませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"위젯 이미지를 캡처할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’image du widget n’a pas pu être capturée."}},"hi":{"stringUnit":{"state":"translated","value":"विजेट की इमेज कैप्चर नहीं की जा सकी।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذر التقاط صورة الأداة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile acquisire l'immagine del widget."}},"tr":{"stringUnit":{"state":"translated","value":"Widget görüntüsü yakalanamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося захопити зображення віджета."}},"id":{"stringUnit":{"state":"translated","value":"Gambar widget tidak dapat diambil."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się przechwycić obrazu widżetu."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถจับภาพวิดเจ็ตได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể chụp hình ảnh tiện ích."}},"nl":{"stringUnit":{"state":"translated","value":"De widgetafbeelding kon niet worden vastgelegd."}},"fa":{"stringUnit":{"state":"translated","value":"ثبت تصویر ویجت ممکن نبود."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось сделать снимок виджета."}},"sv":{"stringUnit":{"state":"translated","value":"Det gick inte att ta en bild av widgeten."}}}},
    "The widget image could not be copied.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The widget image could not be copied."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法复制小组件图像。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法拷貝小工具影像。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível copiar a imagem do widget."}},"de":{"stringUnit":{"state":"translated","value":"Das Widget-Bild konnte nicht kopiert werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo copiar la imagen del widget."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウィジェットの画像をコピーできませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"위젯 이미지를 복사할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’image du widget n’a pas pu être copiée."}},"hi":{"stringUnit":{"state":"translated","value":"विजेट की इमेज कॉपी नहीं की जा सकी।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذر نسخ صورة الأداة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile copiare l'immagine del widget."}},"tr":{"stringUnit":{"state":"translated","value":"Widget görüntüsü kopyalanamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося скопіювати зображення віджета."}},"id":{"stringUnit":{"state":"translated","value":"Gambar widget tidak dapat disalin."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się skopiować obrazu widżetu."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถคัดลอกรูปภาพวิดเจ็ตได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể sao chép hình ảnh tiện ích."}},"nl":{"stringUnit":{"state":"translated","value":"De widgetafbeelding kon niet worden gekopieerd."}},"fa":{"stringUnit":{"state":"translated","value":"کپی تصویر ویجت ممکن نبود."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось скопировать изображение виджета."}},"sv":{"stringUnit":{"state":"translated","value":"Det gick inte att kopiera widgetbilden."}}}},
    "The widget image could not be encoded as PNG.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The widget image could not be encoded as PNG."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法将小组件图像编码为 PNG。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法將小工具影像編碼為 PNG。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível codificar a imagem do widget como PNG."}},"de":{"stringUnit":{"state":"translated","value":"Das Widget-Bild konnte nicht als PNG codiert werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo codificar la imagen del widget como PNG."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウィジェットの画像をPNGとしてエンコードできませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"위젯 이미지를 PNG로 인코딩할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’image du widget n’a pas pu être encodée au format PNG."}},"hi":{"stringUnit":{"state":"translated","value":"विजेट की इमेज को PNG के रूप में एन्कोड नहीं किया जा सका।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذر ترميز صورة الأداة بتنسيق PNG."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile codificare l'immagine del widget in formato PNG."}},"tr":{"stringUnit":{"state":"translated","value":"Widget görüntüsü PNG olarak kodlanamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося закодувати зображення віджета у форматі PNG."}},"id":{"stringUnit":{"state":"translated","value":"Gambar widget tidak dapat dikodekan sebagai PNG."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się zakodować obrazu widżetu w formacie PNG."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถเข้ารหัสรูปภาพวิดเจ็ตเป็น PNG ได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể mã hóa hình ảnh tiện ích thành PNG."}},"nl":{"stringUnit":{"state":"translated","value":"De widgetafbeelding kon niet als PNG worden gecodeerd."}},"fa":{"stringUnit":{"state":"translated","value":"رمزگذاری تصویر ویجت با قالب PNG ممکن نبود."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось закодировать изображение виджета в формате PNG."}},"sv":{"stringUnit":{"state":"translated","value":"Det gick inte att koda widgetbilden som PNG."}}}},
    "The widget image could not be saved.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"The widget image could not be saved."}},"zh-CN":{"stringUnit":{"state":"translated","value":"无法存储小组件图像。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"無法儲存小工具影像。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Não foi possível salvar a imagem do widget."}},"de":{"stringUnit":{"state":"translated","value":"Das Widget-Bild konnte nicht gespeichert werden."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo guardar la imagen del widget."}},"ja-JP":{"stringUnit":{"state":"translated","value":"ウィジェットの画像を保存できませんでした。"}},"ko":{"stringUnit":{"state":"translated","value":"위젯 이미지를 저장할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’image du widget n’a pas pu être enregistrée."}},"hi":{"stringUnit":{"state":"translated","value":"विजेट की इमेज सेव नहीं की जा सकी।"}},"ar":{"stringUnit":{"state":"translated","value":"تعذر حفظ صورة الأداة."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile salvare l'immagine del widget."}},"tr":{"stringUnit":{"state":"translated","value":"Widget görüntüsü kaydedilemedi."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося зберегти зображення віджета."}},"id":{"stringUnit":{"state":"translated","value":"Gambar widget tidak dapat disimpan."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się zapisać obrazu widżetu."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถบันทึกรูปภาพวิดเจ็ตได้"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể lưu hình ảnh tiện ích."}},"nl":{"stringUnit":{"state":"translated","value":"De widgetafbeelding kon niet worden bewaard."}},"fa":{"stringUnit":{"state":"translated","value":"ذخیره تصویر ویجت ممکن نبود."}},"ru":{"stringUnit":{"state":"translated","value":"Не удалось сохранить изображение виджета."}},"sv":{"stringUnit":{"state":"translated","value":"Det gick inte att spara widgetbilden."}}}},
    "These settings changed outside the app while you were editing: %@. Choose which version to keep.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"These settings changed outside the app while you were editing: %@. Choose which version to keep."}},"zh-CN":{"stringUnit":{"state":"translated","value":"在您编辑时，这些设置在应用外部发生了更改：%@。请选择要保留的版本。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"您編輯時，這些設定在應用程式外部發生了變更：%@。請選擇要保留的版本。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Estas configurações mudaram fora do app enquanto você editava: %@. Escolha qual versão manter."}},"de":{"stringUnit":{"state":"translated","value":"Diese Einstellungen wurden während der Bearbeitung außerhalb der App geändert: %@. Wählen Sie, welche Version beibehalten werden soll."}},"es":{"stringUnit":{"state":"translated","value":"Esta configuración cambió fuera de la app mientras editabas: %@. Elige qué versión conservar."}},"ja-JP":{"stringUnit":{"state":"translated","value":"編集中にこれらの設定がアプリ外で変更されました: %@。保持するバージョンを選択してください。"}},"ko":{"stringUnit":{"state":"translated","value":"편집하는 동안 이 설정이 앱 외부에서 변경되었습니다: %@. 유지할 버전을 선택하세요."}},"fr":{"stringUnit":{"state":"translated","value":"Ces paramètres ont changé en dehors de l'application pendant votre modification : %@. Choisissez la version à conserver."}},"hi":{"stringUnit":{"state":"translated","value":"आप संपादन कर रहे थे तभी ये सेटिंग्स ऐप के बाहर बदल गईं: %@. चुनें कि कौन-सा संस्करण रखना है।"}},"ar":{"stringUnit":{"state":"translated","value":"تغيّرت هذه الإعدادات خارج التطبيق أثناء التعديل: %@. اختر الإصدار الذي تريد الاحتفاظ به."}},"it":{"stringUnit":{"state":"translated","value":"Queste impostazioni sono cambiate al di fuori dell'app mentre stavi modificando: %@. Scegli quale versione conservare."}},"tr":{"stringUnit":{"state":"translated","value":"Bu ayarlar siz düzenlerken uygulama dışında değişti: %@. Hangi sürümün korunacağını seçin."}},"uk":{"stringUnit":{"state":"translated","value":"Ці налаштування змінилися поза застосунком, поки ви їх редагували: %@. Оберіть, яку версію зберегти."}},"id":{"stringUnit":{"state":"translated","value":"Pengaturan ini berubah di luar aplikasi saat Anda mengedit: %@. Pilih versi mana yang akan disimpan."}},"pl":{"stringUnit":{"state":"translated","value":"Te ustawienia zmieniły się poza aplikacją podczas edycji: %@. Wybierz, którą wersję zachować."}},"th":{"stringUnit":{"state":"translated","value":"การตั้งค่าเหล่านี้เปลี่ยนแปลงนอกแอปขณะที่คุณกำลังแก้ไข: %@ เลือกเวอร์ชันที่ต้องการเก็บไว้"}},"vi":{"stringUnit":{"state":"translated","value":"Các cài đặt này đã thay đổi bên ngoài ứng dụng khi bạn đang chỉnh sửa: %@. Chọn phiên bản để giữ lại."}},"nl":{"stringUnit":{"state":"translated","value":"Deze instellingen zijn buiten de app gewijzigd terwijl je aan het bewerken was: %@. Kies welke versie je wilt behouden."}},"fa":{"stringUnit":{"state":"translated","value":"این تنظیمات هنگام ویرایش شما خارج از برنامه تغییر کردند: %@. نسخه‌ای را که می‌خواهید نگه دارید انتخاب کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Эти настройки изменились вне приложения во время редактирования: %@. Выберите, какую версию сохранить."}},"sv":{"stringUnit":{"state":"translated","value":"De här inställningarna ändrades utanför appen medan du redigerade: %@. Välj vilken version du vill behålla."}}}},
    "Thinking": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Thinking"}},"zh-CN":{"stringUnit":{"state":"translated","value":"正在思考"}},"zh-TW":{"stringUnit":{"state":"translated","value":"思考中"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Pensando"}},"de":{"stringUnit":{"state":"translated","value":"Denkt nach"}},"es":{"stringUnit":{"state":"translated","value":"Pensando"}},"ja-JP":{"stringUnit":{"state":"translated","value":"思考中"}},"ko":{"stringUnit":{"state":"translated","value":"생각 중"}},"fr":{"stringUnit":{"state":"translated","value":"Réflexion"}},"hi":{"stringUnit":{"state":"translated","value":"सोच रहा है"}},"ar":{"stringUnit":{"state":"translated","value":"جارٍ التفكير"}},"it":{"stringUnit":{"state":"translated","value":"Elaborazione"}},"tr":{"stringUnit":{"state":"translated","value":"Düşünüyor"}},"uk":{"stringUnit":{"state":"translated","value":"Мислення"}},"id":{"stringUnit":{"state":"translated","value":"Berpikir"}},"pl":{"stringUnit":{"state":"translated","value":"Myślenie"}},"th":{"stringUnit":{"state":"translated","value":"กำลังคิด"}},"vi":{"stringUnit":{"state":"translated","value":"Đang suy nghĩ"}},"nl":{"stringUnit":{"state":"translated","value":"Denken"}},"fa":{"stringUnit":{"state":"translated","value":"در حال فکر کردن"}},"ru":{"stringUnit":{"state":"translated","value":"Размышление"}},"sv":{"stringUnit":{"state":"translated","value":"Tänker"}}}},
    "Thinking and Fast controls require operator.admin access.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Thinking and Fast controls require operator.admin access."}},"zh-CN":{"stringUnit":{"state":"translated","value":"Thinking 和 Fast 控件需要 operator.admin 访问权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"Thinking 和 Fast 控制項需要 operator.admin 存取權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Os controles Thinking e Fast exigem acesso operator.admin."}},"de":{"stringUnit":{"state":"translated","value":"Thinking- und Fast-Steuerungen erfordern operator.admin-Zugriff."}},"es":{"stringUnit":{"state":"translated","value":"Los controles de Pensamiento y Rápido requieren acceso operator.admin."}},"ja-JP":{"stringUnit":{"state":"translated","value":"Thinking と Fast のコントロールには operator.admin アクセスが必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"Thinking 및 Fast 컨트롤은 operator.admin 액세스가 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les contrôles Thinking et Fast nécessitent l'accès operator.admin."}},"hi":{"stringUnit":{"state":"translated","value":"Thinking और Fast नियंत्रणों के लिए operator.admin एक्सेस आवश्यक है।"}},"ar":{"stringUnit":{"state":"translated","value":"يتطلب التحكم في Thinking وFast صلاحية operator.admin."}},"it":{"stringUnit":{"state":"translated","value":"I controlli Thinking e Fast richiedono l'accesso operator.admin."}},"tr":{"stringUnit":{"state":"translated","value":"Thinking ve Fast denetimleri operator.admin erişimi gerektirir."}},"uk":{"stringUnit":{"state":"translated","value":"Елементи керування Thinking і Fast потребують доступу operator.admin."}},"id":{"stringUnit":{"state":"translated","value":"Kontrol Thinking dan Fast memerlukan akses operator.admin."}},"pl":{"stringUnit":{"state":"translated","value":"Elementy sterujące Thinking i Fast wymagają dostępu operator.admin."}},"th":{"stringUnit":{"state":"translated","value":"การควบคุม Thinking และ Fast ต้องใช้สิทธิ์การเข้าถึง operator.admin"}},"vi":{"stringUnit":{"state":"translated","value":"Điều khiển Thinking và Fast yêu cầu quyền truy cập operator.admin."}},"nl":{"stringUnit":{"state":"translated","value":"Voor besturingselementen voor Thinking en Fast is operator.admin-toegang vereist."}},"fa":{"stringUnit":{"state":"translated","value":"کنترل‌های Thinking و Fast به دسترسی operator.admin نیاز دارند."}},"ru":{"stringUnit":{"state":"translated","value":"Управление функциями Thinking и Fast требует доступа operator.admin."}},"sv":{"stringUnit":{"state":"translated","value":"Kontroller för Thinking och Fast kräver operator.admin-åtkomst."}}}},
