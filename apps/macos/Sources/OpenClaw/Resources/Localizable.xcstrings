    "Microphone access is required. Enable it in Settings.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Microphone access is required. Enable it in Settings."}},"zh-CN":{"stringUnit":{"state":"translated","value":"需要麦克风访问权限。请在“设置”中启用。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"需要麥克風存取權限。請在「設定」中啟用。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"O acesso ao microfone é necessário. Ative-o em Ajustes."}},"de":{"stringUnit":{"state":"translated","value":"Mikrofonzugriff ist erforderlich. Aktiviere ihn in den Einstellungen."}},"es":{"stringUnit":{"state":"translated","value":"Se requiere acceso al micrófono. Actívalo en Ajustes."}},"ja-JP":{"stringUnit":{"state":"translated","value":"マイクへのアクセスが必要です。設定で有効にしてください。"}},"ko":{"stringUnit":{"state":"translated","value":"마이크 접근 권한이 필요합니다. 설정에서 활성화하세요."}},"fr":{"stringUnit":{"state":"translated","value":"L'accès au microphone est requis. Activez-le dans Réglages."}},"hi":{"stringUnit":{"state":"translated","value":"माइक्रोफ़ोन एक्सेस आवश्यक है। इसे Settings में सक्षम करें।"}},"ar":{"stringUnit":{"state":"translated","value":"الوصول إلى الميكروفون مطلوب. فعّله في الإعدادات."}},"it":{"stringUnit":{"state":"translated","value":"È necessario l'accesso al microfono. Abilitalo nelle Impostazioni."}},"tr":{"stringUnit":{"state":"translated","value":"Mikrofon erişimi gereklidir. Ayarlar'dan etkinleştirin."}},"uk":{"stringUnit":{"state":"translated","value":"Потрібен доступ до мікрофона. Увімкніть його в Налаштуваннях."}},"id":{"stringUnit":{"state":"translated","value":"Akses mikrofon diperlukan. Aktifkan di Pengaturan."}},"pl":{"stringUnit":{"state":"translated","value":"Wymagany jest dostęp do mikrofonu. Włącz go w Ustawieniach."}},"th":{"stringUnit":{"state":"translated","value":"จำเป็นต้องเข้าถึงไมโครโฟน เปิดใช้งานได้ในการตั้งค่า"}},"vi":{"stringUnit":{"state":"translated","value":"Cần quyền truy cập micrô. Bật quyền đó trong Cài đặt."}},"nl":{"stringUnit":{"state":"translated","value":"Microfoontoegang is vereist. Schakel dit in via Instellingen."}},"fa":{"stringUnit":{"state":"translated","value":"دسترسی به میکروفون لازم است. آن را در تنظیمات فعال کنید."}},"ru":{"stringUnit":{"state":"translated","value":"Требуется доступ к микрофону. Включите его в настройках."}},"sv":{"stringUnit":{"state":"translated","value":"Mikrofonåtkomst krävs. Aktivera den i Inställningar."}}}},
    "Microphone and speech recognition permission required.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Microphone and speech recognition permission required."}},"zh-CN":{"stringUnit":{"state":"translated","value":"需要麦克风和语音识别权限。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"需要麥克風與語音辨識權限。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"É necessário permitir o acesso ao microfone e ao reconhecimento de fala."}},"de":{"stringUnit":{"state":"translated","value":"Berechtigung für Mikrofon und Spracherkennung erforderlich."}},"es":{"stringUnit":{"state":"translated","value":"Se requieren permisos para usar el micrófono y el reconocimiento de voz."}},"ja-JP":{"stringUnit":{"state":"translated","value":"マイクと音声認識の権限が必要です。"}},"ko":{"stringUnit":{"state":"translated","value":"마이크 및 음성 인식 권한이 필요합니다."}},"fr":{"stringUnit":{"state":"translated","value":"L’autorisation d’accéder au microphone et à la reconnaissance vocale est requise."}},"hi":{"stringUnit":{"state":"translated","value":"माइक्रोफ़ोन और वाक् पहचान की अनुमति आवश्यक है।"}},"ar":{"stringUnit":{"state":"translated","value":"يلزم منح إذن استخدام الميكروفون والتعرّف على الكلام."}},"it":{"stringUnit":{"state":"translated","value":"È richiesta l'autorizzazione per il microfono e il riconoscimento vocale."}},"tr":{"stringUnit":{"state":"translated","value":"Mikrofon ve konuşma tanıma izni gerekiyor."}},"uk":{"stringUnit":{"state":"translated","value":"Потрібен дозвіл на використання мікрофона та розпізнавання мовлення."}},"id":{"stringUnit":{"state":"translated","value":"Izin mikrofon dan pengenalan ucapan diperlukan."}},"pl":{"stringUnit":{"state":"translated","value":"Wymagane są uprawnienia do mikrofonu i rozpoznawania mowy."}},"th":{"stringUnit":{"state":"translated","value":"ต้องอนุญาตการเข้าถึงไมโครโฟนและการรู้จำเสียงพูด"}},"vi":{"stringUnit":{"state":"translated","value":"Cần có quyền truy cập micrô và nhận dạng giọng nói."}},"nl":{"stringUnit":{"state":"translated","value":