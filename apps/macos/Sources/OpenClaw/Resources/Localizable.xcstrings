    "Details": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Details"}},"zh-CN":{"stringUnit":{"state":"translated","value":"详情"}},"zh-TW":{"stringUnit":{"state":"translated","value":"詳細資料"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Detalhes"}},"de":{"stringUnit":{"state":"new","value":"Details"}},"es":{"stringUnit":{"state":"translated","value":"Detalles"}},"ja-JP":{"stringUnit":{"state":"translated","value":"詳細"}},"ko":{"stringUnit":{"state":"translated","value":"세부 정보"}},"fr":{"stringUnit":{"state":"translated","value":"Détails"}},"hi":{"stringUnit":{"state":"translated","value":"विवरण"}},"ar":{"stringUnit":{"state":"translated","value":"التفاصيل"}},"it":{"stringUnit":{"state":"translated","value":"Dettagli"}},"tr":{"stringUnit":{"state":"translated","value":"Ayrıntılar"}},"uk":{"stringUnit":{"state":"translated","value":"Докладно"}},"id":{"stringUnit":{"state":"translated","value":"Detail"}},"pl":{"stringUnit":{"state":"translated","value":"Szczegóły"}},"th":{"stringUnit":{"state":"translated","value":"รายละเอียด"}},"vi":{"stringUnit":{"state":"translated","value":"Chi tiết"}},"nl":{"stringUnit":{"state":"new","value":"Details"}},"fa":{"stringUnit":{"state":"translated","value":"جزئیات"}},"ru":{"stringUnit":{"state":"translated","value":"Сведения"}},"sv":{"stringUnit":{"state":"translated","value":"Detaljer"}}}},
    "Detected, but not auto-tested": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Detected, but not auto-tested"}},"zh-CN":{"stringUnit":{"state":"translated","value":"已检测到，但未自动测试"}},"zh-TW":{"stringUnit":{"state":"translated","value":"已偵測到，但未自動測試"}},"pt-BR":{"stringUnit":{"state":"translated","value":"Detectado, mas não testado automaticamente"}},"de":{"stringUnit":{"state":"translated","value":"Erkannt, aber nicht automatisch getestet"}},"es":{"stringUnit":{"state":"translated","value":"Detectado, pero no probado automáticamente"}},"ja-JP":{"stringUnit":{"state":"translated","value":"検出済み（自動テストなし）"}},"ko":{"stringUnit":{"state":"translated","value":"감지되었지만 자동 테스트되지 않음"}},"fr":{"stringUnit":{"state":"translated","value":"Détecté, mais non testé automatiquement"}},"hi":{"stringUnit":{"state":"translated","value":"पता चला, लेकिन स्वचालित रूप से जाँचा नहीं गया"}},"ar":{"stringUnit":{"state":"translated","value":"تم الاكتشاف، ولكن لم يُختبر تلقائيًا"}},"it":{"stringUnit":{"state":"translated","value":"Rilevato, ma non testato automaticamente"}},"tr":{"stringUnit":{"state":"translated","value":"Algılandı ancak otomatik olarak test edilmedi"}},"uk":{"stringUnit":{"state":"translated","value":"Виявлено, але не перевірено автоматично"}},"id":{"stringUnit":{"state":"translated","value":"Terdeteksi, tetapi tidak diuji secara otomatis"}},"pl":{"stringUnit":{"state":"translated","value":"Wykryto, ale nie przetestowano automatycznie"}},"th":{"stringUnit":{"state":"translated","value":"ตรวจพบแล้ว แต่ไม่ได้ทดสอบโดยอัตโนมัติ"}},"vi":{"stringUnit":{"state":"translated","value":"Đã phát hiện nhưng chưa được kiểm tra tự động"}},"nl":{"stringUnit":{"state":"translated","value":"Gedetecteerd, maar niet automatisch getest"}},"fa":{"stringUnit":{"state":"translated","value":"شناسایی شد، اما به‌طور خودکار آزمایش نشد"}},"ru":{"stringUnit":{"state":"translated","value":"Обнаружено, но не проверено автоматически"}},"sv":{"stringUnit":{"state":"translated","value":"Identifierad, men inte automatiskt testad"}}}},
    "Dev (Git main)": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"Dev (Git main)"}},"zh-CN":{"stringUnit":{"state":"translated","value":"Dev（Git main）"}},"zh-TW":{"stringUnit":{"state":"translated","value":"開發版（Git main）"}},"pt-BR":{"stringUnit":{"state":"new","value":"Dev (Git main)"}},"de":{"stringUnit":{"state":"new","value":"Dev (Git main)"}},"es":{"stringUnit":{"state":"new","value":"Dev (Git main)"}},"ja-JP":{"stringUnit":{"state":"translated","value":"開発版 (Git main)"}},"ko":{"stringUnit":{"state":"translated","value":"개발 (Git main)"}},"fr":{"stringUnit":{"state":"new","value":"Dev (Git main)"}},"hi":{"stringUnit":{"state":"new","value":"Dev (Git main)"}},"ar":{"stringUnit":{"state":"new","value":"Dev (Git main)"}},"it":{"stringUnit":{"state":"new","value":"Dev (Git main)"}},"tr":{"stringUnit":{"state":"new","value":"Dev (Git main)"}},"uk":{"stringUnit":{"state":"new","value":"Dev (Git main)"}},"id":{"stringUnit":{"state":"new","value":"Dev (Git main)"}},"pl":{"stringUnit":{"state":"new","value":"Dev (Git main)"}},"th":{"stringUnit":{"state":"new","value":"Dev (Git main)"}},"vi":{"stringUnit":{"state":"new","value":"Dev (Git main)"}},"nl":{"stringUnit":{"state":"new","value":"Dev (Git main)"}},"fa":{"stringUnit":{"state":"new","value":"Dev (Git main)"}},"ru":{"stringUnit":{"state":"new","value":"Dev (Git main)"}},"sv":{"stringUnit":{"state":"new","value":"Dev (Git main)"}}}},
