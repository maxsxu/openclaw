    "App updates are unavailable while a profile is active.": {"localizations":{"en":{"stringUnit":{"state":"translated","value":"App updates are unavailable while a profile is active."}},"zh-CN":{"stringUnit":{"state":"translated","value":"配置文件处于活动状态时，无法进行应用更新。"}},"zh-TW":{"stringUnit":{"state":"translated","value":"當設定檔啟用時，無法進行應用程式更新。"}},"pt-BR":{"stringUnit":{"state":"translated","value":"As atualizações do app não estão disponíveis enquanto um perfil está ativo."}},"de":{"stringUnit":{"state":"translated","value":"App-Updates sind nicht verfügbar, während ein Profil aktiv ist."}},"es":{"stringUnit":{"state":"translated","value":"Las actualizaciones de la aplicación no están disponibles mientras hay un perfil activo."}},"ja-JP":{"stringUnit":{"state":"translated","value":"プロファイルがアクティブな間はアプリの更新を利用できません。"}},"ko":{"stringUnit":{"state":"translated","value":"프로필이 활성화된 동안에는 앱 업데이트를 사용할 수 없습니다."}},"fr":{"stringUnit":{"state":"translated","value":"Les mises à jour de l’application ne sont pas disponibles lorsqu’un profil est actif."}},"hi":{"stringUnit":{"state":"translated","value":"प्रोफ़ाइल सक्रिय होने पर ऐप अपडेट उपलब्ध नहीं हैं।"}},"ar":{"stringUnit":{"state":"translated","value":"تحديثات التطبيق غير متوفرة أثناء نشاط ملف تعريف."}},"it":{"stringUnit":{"state":"translated","value":"Gli aggiornamenti dell'app non sono disponibili mentre è attivo un profilo."}},"tr":{"stringUnit":{"state":"translated","value":"Bir profil etkinken uygulama güncellemeleri kullanılamaz."}},"uk":{"stringUnit":{"state":"translated","value":"Оновлення застосунку недоступні, поки активний профіль."}},"id":{"stringUnit":{"state":"translated","value":"Pembaruan aplikasi tidak tersedia saat profil aktif."}},"pl":{"stringUnit":{"state":"translated","value":"Aktualizacje aplikacji są niedostępne, gdy profil jest aktywny."}},"th":{"stringUnit":{"state":"translated","value":"ไม่สามารถอัปเดตแอปได้ในขณะที่โปรไฟล์กำลังทำงานอยู่"}},"vi":{"stringUnit":{"state":"translated","value":"Không thể cập nhật ứn